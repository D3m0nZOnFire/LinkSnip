# Copy to .env and fill in. Only infrastructure goes here; everything else
# (registration, features, limits, retention…) is in DATA_DIR/settings.json
# and roles.json, editable from Admin → Settings or by hand.

# Required. Signs login sessions. Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me

# Required. Key for the stored hashes of visitor IPs (analytics, reports), so a copy
# of the database alone can't be turned back into IPs. At least 32 characters and
# different from SESSION_SECRET. Generate one with: openssl rand -hex 32
# Keep it: a new one restarts unique-visitor counts and the one-report-per-IP check.
IP_HASH_SECRET=change-me

# Where the database, uploads, backups, settings.json and roles.json live.
# Docker sets this to /data (mounted from ./data). Default: the project folder.
# DATA_DIR=./data

# Port the app listens on (default 8081).
# PORT=8081

# production or development (development logs every SQL query).
# NODE_ENV=production

# Reverse proxies in front of the app (default 1). Use 0 if nothing is in front.
# TRUST_PROXY=1

# Optional: mail, for confirming users' email addresses and "Forgot password?". Off while
# none of these is set; set SMTP_HOST, MAIL_FROM and PUBLIC_URL (and usually the login) to
# turn it on. A half-finished setup refuses to start and names what's missing.
# SMTP_HOST=mail.example.com
# SMTP_PORT=465                   # 465 = TLS (default), 587 = STARTTLS
# SMTP_USER=no-reply@example.com  # with SMTP_PASS; leave both out for a server without login
# SMTP_PASS=
# MAIL_FROM="LinkSnip <no-reply@example.com>"
# MAIL_REPLY_TO=contact@example.com   # optional: where replies go
# The site's public address. Links in mails start with it (never with the address a request
# came in on, which anyone can fake).
# PUBLIC_URL=https://links.example.com
# Development only: print mails in the terminal instead of sending them (needs no SMTP).
# MAIL_TRANSPORT=console

# Image version for docker compose pull (default 1: every 1.x release, never a 2.0).
# Pin one with an exact version (1.4.0) or a minor line (1.4). Ignored by --build.
# LINKSNIP_VERSION=1

# Only for the bundled Caddy: docker compose --profile caddy up -d
# DOMAIN=links.example.com
