<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: `${tag.name} · Tag analytics`, styles: ['overview', 'sections', 'tags'] }) %>
</head>
<%- include('partials/layout-start', { shell: 'app', currentPage: 'tags' }) %>
<%
  const totalVisits = items.reduce((sum, i) => sum + i.visits, 0);
  const breakdown = Object.keys(typeNouns).map(type => [type, items.filter(i => i.type === type).length])
    .filter(([, n]) => n > 0).map(([type, n]) => `${n} ${typeNouns[type]}${n === 1 ? '' : 's'}`).join(' · ');
  const day = (value) => new Date(String(value).includes('T') ? value : `${String(value).replace(' ', 'T')}Z`)
    .toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
-%>
  <main class="main-content-wide page-medium" id="tagAnalytics" data-tag-id="<%= tag.id %>" data-tag-color="<%= /^#[0-9a-f]{6}$/i.test(tag.color || '') ? tag.color : '' %>">
    <div class="header-section">
      <div>
        <h2 class="tag-title"><%- include('partials/tag-chips', { tags: [tag] }) %> Analytics</h2>
        <p>Everything with this tag, together</p>
      </div>
      <div class="header-actions">
        <a href="/tags" class="btn btn-secondary"><%- include('partials/icon', { icon: 'arrowLeft' }) %> All tags</a>
      </div>
    </div>

    <div class="stat-grid">
      <div class="stat-card">
        <span class="stat-label">Tagged items</span>
        <span class="stat-value" id="totalItems"><%= items.length %></span>
        <% if (breakdown) { %><span class="stat-label"><%= breakdown %></span><% } %>
      </div>
      <div class="stat-card">
        <span class="stat-label">Visits</span>
        <span class="stat-value" id="totalVisits"><%= totalVisits.toLocaleString('en-US') %></span>
        <span class="stat-label">Clicks, opens, views and downloads</span>
      </div>
      <div class="stat-card">
        <span class="stat-label">Visits per item</span>
        <span class="stat-value" id="avgVisits"><%= items.length > 0 ? Math.round(totalVisits / items.length) : 0 %></span>
      </div>
    </div>

    <div class="section-card chart-card">
      <h3>Visits, last 30 days</h3>
      <div class="chart-box"><canvas id="visitsChart" aria-label="Visits per day over the last 30 days" role="img"></canvas></div>
    </div>

    <% if (items.length > 0) { %>
      <div class="section-card">
        <h3>Items with this tag</h3>
        <div class="table-scroll">
          <table class="section-table">
            <thead>
              <tr><th>Type</th><th>Short link</th><th>Destination / title</th><th class="num">Visits</th><th>Created</th><th class="actions-cell"><span class="visually-hidden">Analytics</span></th></tr>
            </thead>
            <tbody>
              <% items.forEach(item => { %>
                <tr>
                  <td class="type-cell"><%= typeNouns[item.type] %></td>
                  <td class="path-cell"><a href="<%= baseUrl %><%= item.publicPath %>" target="_blank" rel="noopener"><%= item.publicPath %></a></td>
                  <td class="name-cell" title="<%= item.name || '' %>"><%= item.name || '(untitled)' %></td>
                  <td class="num"><%= item.visits.toLocaleString('en-US') %></td>
                  <td class="muted"><%= day(item.createdAt) %></td>
                  <td class="actions-cell"><a href="<%= item.analyticsPath %>" class="icon-btn" title="Analytics" aria-label="Analytics"><%- include('partials/icon', { icon: 'chart' }) %></a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } else { %>
      <div class="empty-state">
        <p>Nothing has this tag yet</p>
        <a href="/" class="btn btn-small">Create something with this tag</a>
      </div>
    <% } %>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script src="/js/tag-analytics.js"></script>
<%- include('partials/layout-end', { shell: 'app' }) %>
</html>
