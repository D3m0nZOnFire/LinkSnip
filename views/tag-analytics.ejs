<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= tag.name %> Analytics - LinkSnip</title>
  <link rel="icon" type="image/png" href="/logo.png">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/tables.css">
  <script src="/js/theme.js"></script>
</head>
<body>
  <%- include('partials/header', { currentPage: 'tags' }) %>

  <!-- Main Content -->
  <main class="main-content-wide">
    <!-- Header Section -->
    <div class="header-section">
      <div>
        <h2 style="display: flex; align-items: center; gap: 0.75rem;">
          <span style="display: inline-block; padding: 0.25rem 0.75rem; background-color: <%= tag.color %>20; color: <%= tag.color %>; border: 1px solid <%= tag.color %>40; border-radius: 4px; font-weight: 500;">
            <%= tag.name %>
          </span>
          Analytics
        </h2>
        <p>Performance overview for all URLs with this tag</p>
      </div>
      <a href="/tags" class="btn" style="color: var(--primary-foreground);">Back to Tags</a>
    </div>

    <!-- Summary Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-bottom: 2rem;">
      <div style="padding: 1.5rem; background-color: var(--card); border: 1px solid var(--border); border-radius: 0.5rem;">
        <p style="color: var(--muted-foreground); font-size: 0.875rem; margin-bottom: 0.5rem;">Total URLs</p>
        <p style="font-size: 2rem; font-weight: bold; color: var(--primary);" id="totalUrls"><%= urls.length %></p>
      </div>
      <div style="padding: 1.5rem; background-color: var(--card); border: 1px solid var(--border); border-radius: 0.5rem;">
        <p style="color: var(--muted-foreground); font-size: 0.875rem; margin-bottom: 0.5rem;">Total Clicks</p>
        <p style="font-size: 2rem; font-weight: bold; color: var(--primary);" id="totalClicks"><%= urls.reduce((sum, u) => sum + u.clicks, 0) %></p>
      </div>
      <div style="padding: 1.5rem; background-color: var(--card); border: 1px solid var(--border); border-radius: 0.5rem;">
        <p style="color: var(--muted-foreground); font-size: 0.875rem; margin-bottom: 0.5rem;">Average Clicks/URL</p>
        <p style="font-size: 2rem; font-weight: bold; color: var(--primary);" id="avgClicks">
          <%= urls.length > 0 ? Math.round(urls.reduce((sum, u) => sum + u.clicks, 0) / urls.length) : 0 %>
        </p>
      </div>
    </div>

    <!-- Chart -->
    <div style="margin-bottom: 2rem; padding: 1.5rem; background-color: var(--card); border: 1px solid var(--border); border-radius: 0.5rem;">
      <h3 style="font-size: 1.125rem; font-weight: 600; margin-bottom: 1.5rem;">Click Trends (Last 30 Days)</h3>
      <canvas id="clicksChart" style="max-height: 300px;"></canvas>
    </div>

    <!-- URLs Table -->
    <% if (urls.length > 0) { %>
      <div class="table-container">
        <h3 style="font-size: 1.125rem; font-weight: 600; margin-bottom: 1rem;">URLs with this Tag</h3>
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Short URL</th>
                <th>Long URL</th>
                <th class="text-right">Clicks</th>
                <th>Created</th>
                <th class="text-center">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% urls.forEach(url => { %>
                <tr>
                  <td>
                    <a href="<%= baseUrl %>/s/<%= url.slug %>" target="_blank" class="url-link">
                      /s/<%= url.slug %>
                    </a>
                  </td>
                  <td>
                    <a href="<%= url.longUrl %>" target="_blank" class="long-url" title="<%= url.longUrl %>">
                      <%= url.longUrl %>
                    </a>
                  </td>
                  <td class="text-right"><%= url.clicks %></td>
                  <td><%= new Date(url.createdAt).toLocaleDateString('en-GB') %></td>
                  <td class="text-center">
                    <div class="actions">
                      <a href="/analytics/url/<%= url.id %>" class="icon-btn" title="Analytics">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M3 3v18h18"></path>
                          <path d="M18 17V9"></path>
                          <path d="M13 17V5"></path>
                          <path d="M8 17v-3"></path>
                        </svg>
                      </a>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } else { %>
      <div class="empty-state">
        <p>No URLs with this tag yet</p>
        <a href="/" class="btn btn-small" style="margin-top: 1rem;">Create a URL with this tag</a>
      </div>
    <% } %>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <script>
    // Fetch analytics data and render chart
    async function loadAnalytics() {
      try {
        const response = await fetch('/api/tags/<%= tag.id %>/analytics');
        const data = await response.json();

        // Create chart
        const ctx = document.getElementById('clicksChart').getContext('2d');

        // Prepare data for last 30 days
        const labels = [];
        const clickData = [];
        const today = new Date();

        // Create map of existing data
        const clickMap = new Map(
          data.clicksByDate.map(item => [item.date, item.count])
        );

        // Generate labels for last 30 days
        for (let i = 29; i >= 0; i--) {
          const date = new Date(today);
          date.setDate(date.getDate() - i);
          const dateStr = date.toISOString().split('T')[0];
          const displayDate = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });

          labels.push(displayDate);
          clickData.push(clickMap.get(dateStr) || 0);
        }

        // Get CSS variables
        const rootStyles = getComputedStyle(document.documentElement);
        const mutedText = rootStyles.getPropertyValue('--chart-muted-text').trim();
        const borderColor = rootStyles.getPropertyValue('--border').trim();

        new Chart(ctx, {
          type: 'line',
          data: {
            labels: labels,
            datasets: [{
              label: 'Clicks',
              data: clickData,
              borderColor: '<%= tag.color %>',
              backgroundColor: '<%= tag.color %>20',
              tension: 0.3,
              fill: true
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
              legend: {
                display: false
              }
            },
            scales: {
              y: {
                beginAtZero: true,
                ticks: {
                  stepSize: 1,
                  precision: 0,
                  color: mutedText
                },
                grid: {
                  color: borderColor
                }
              },
              x: {
                ticks: {
                  color: mutedText,
                  maxRotation: 45,
                  minRotation: 45
                },
                grid: {
                  color: borderColor
                }
              }
            }
          }
        });
      } catch (error) {
        console.error('Failed to load analytics:', error);
      }
    }

    // Load on page ready
    document.addEventListener('DOMContentLoaded', loadAnalytics);
  </script>
  <%- include('partials/footer') %>
</body>
</html>
