<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Teams', styles: ['forms', 'sections', 'teams'] }) %>
</head>
<%- include('partials/layout-start', { shell: 'app', currentPage: 'teams' }) %>

  <main class="main-content-wide page-medium">
    <div class="header-section">
      <div>
        <h2>Teams</h2>
        <p>Links, bundles, pastes and files that several people manage together.</p>
      </div>
    </div>

    <%- include('partials/team-invites', { teamInvites: invites }) %>

    <% if (teams.length) { %>
      <div class="team-list">
        <% teams.forEach(team => { %>
          <a class="team-card" href="/teams/<%= team.id %>">
            <span class="team-card-icon"><%- include('partials/icon', { icon: 'teams' }) %></span>
            <span class="team-card-text">
              <strong><%= team.name %></strong>
              <span><%= team.role.charAt(0).toUpperCase() + team.role.slice(1) %> · <%= team.members %> member<%= team.members === 1 ? '' : 's' %></span>
            </span>
            <%- include('partials/icon', { icon: 'chevronRight' }) %>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">
        <p>You're not in a team yet</p>
        <p class="muted"><%= canCreate ? 'Create one below, or ask a team owner to invite you.' : 'Ask a team owner to invite you.' %></p>
      </div>
    <% } %>

    <% if (canCreate) { %>
      <section class="section-card">
        <h3>New team</h3>
        <p class="section-help">You become its owner and can invite people.</p>
        <form id="createTeamForm" class="inline-form">
          <div class="form-group">
            <label for="teamName" class="form-label">Name</label>
            <input type="text" id="teamName" class="form-input" maxlength="60" required>
          </div>
          <button type="submit" class="btn"><%- include('partials/icon', { icon: 'plus' }) %> Create team</button>
        </form>
        <p id="createTeamError" class="field-error" role="alert"></p>
      </section>
    <% } %>
  </main>

  <script src="/js/teams.js"></script>
<%- include('partials/layout-end', { shell: 'app' }) %>
</html>
