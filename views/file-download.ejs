<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= file.originalName %> - LinkSnip</title>
  <link rel="icon" type="image/png" href="/logo.png">
  <link rel="stylesheet" href="/css/main.css">
  <script src="/js/theme.js"></script>
  <style>
    .file-preview-container {
      max-width: 680px;
      margin: 2.5rem auto;
      padding: 0 1rem;
    }

    .file-card {
      background: var(--card-background);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 2rem;
    }

    .file-icon-row {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .file-type-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 48px;
      height: 48px;
      border-radius: 10px;
      background: var(--primary);
      color: var(--primary-foreground);
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      flex-shrink: 0;
    }

    .file-name {
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--foreground);
      word-break: break-all;
      margin: 0;
    }

    .file-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.25rem;
      margin-bottom: 1.5rem;
      font-size: 0.875rem;
      color: var(--muted-foreground);
    }

    .file-meta span {
      display: flex;
      align-items: center;
      gap: 0.3rem;
    }

    .file-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }

    .stat-box {
      background: var(--background);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.875rem;
      text-align: center;
    }

    .stat-box .stat-val {
      font-size: 1.25rem;
      font-weight: 700;
      color: var(--primary);
      display: block;
    }

    .stat-box .stat-label {
      font-size: 0.75rem;
      color: var(--muted-foreground);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-top: 0.2rem;
      display: block;
    }

    .shared-with {
      font-size: 0.85rem;
      color: var(--muted-foreground);
      margin-bottom: 1.5rem;
    }

    .shared-with strong {
      color: var(--foreground);
    }

    .download-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      width: 100%;
      padding: 0.875rem;
      background: var(--primary);
      color: var(--primary-foreground);
      border: none;
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: opacity 0.15s;
      font-family: inherit;
    }

    .download-btn:hover {
      opacity: 0.9;
    }

    .tags-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.375rem;
      margin-bottom: 1.25rem;
    }

    .tag-chip {
      display: inline-flex;
      align-items: center;
      padding: 0.2rem 0.6rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 500;
      background: rgba(52, 211, 153, 0.15);
      color: var(--primary);
      border: 1px solid rgba(52, 211, 153, 0.3);
    }
  </style>
</head>
<body>
  <%- include('partials/header', { currentPage: '' }) %>

  <div class="file-preview-container">
    <div class="file-card">
      <div class="file-icon-row">
        <div class="file-type-badge">
          <% const ext = file.originalName.split('.').pop().substring(0, 4); %>
          <%= ext %>
        </div>
        <h1 class="file-name"><%= file.originalName %></h1>
      </div>

      <div class="file-meta">
        <span>
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          <%= owner.username %>
        </span>
        <span>
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 15V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
          <%= sizeFormatted %>
        </span>
        <span>
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"></path></svg>
          <%= file.mimeType %>
        </span>
        <% if (file.expiresAt) { %>
        <span>
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Expires <%= new Date(file.expiresAt).toLocaleDateString('en-GB') %>
        </span>
        <% } %>
      </div>

      <div class="file-stats">
        <div class="stat-box">
          <span class="stat-val"><%= file.downloads %></span>
          <span class="stat-label">Downloads</span>
        </div>
        <% if (file.maxDownloads) { %>
        <div class="stat-box">
          <span class="stat-val"><%= file.maxDownloads - file.downloads %></span>
          <span class="stat-label">Remaining</span>
        </div>
        <% } %>
        <div class="stat-box">
          <span class="stat-val"><%= new Date(file.createdAt).toLocaleDateString('en-GB') %></span>
          <span class="stat-label">Uploaded</span>
        </div>
      </div>

      <% if (file.tags && file.tags.length > 0) { %>
      <div class="tags-row">
        <% file.tags.forEach(tag => { %>
          <span class="tag-chip" style="background:<%=tag.color%>22;color:<%=tag.color%>;border-color:<%=tag.color%>44;"><%= tag.name %></span>
        <% }); %>
      </div>
      <% } %>

      <% if (file.sharingMode === 'restricted' && allowedUsernames.length > 0) { %>
      <div class="shared-with">
        <strong>Shared with:</strong> <%= allowedUsernames.map(u => '@' + u).join(', ') %>
      </div>
      <% } %>

      <a href="<%= downloadUrl %>" class="download-btn">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Download File
      </a>
    </div>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
