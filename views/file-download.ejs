<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: file.originalName, styles: ['modals', 'forms', 'public-pages'] }) %>
</head>
<%- include('partials/layout-start', { shell: 'public' }) %>
<%
  const shortUrl = `${baseUrl}/f/${file.slug}`;
  const extension = (file.originalName.includes('.') ? file.originalName.split('.').pop() : 'file').slice(0, 4);
  const day = (value) => new Date(String(value).includes('T') ? value : `${String(value).replace(' ', 'T')}Z`)
    .toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
-%>
  <main class="public-page">
    <article class="item-card">
      <div class="file-head">
        <span class="file-badge"><%= extension %></span>
        <div class="file-head-text">
          <h1 class="item-title file-name"><%= file.originalName %></h1>
          <div class="paste-short">
            <span><%= shortUrl.replace(/^https?:\/\//, '') %></span>
            <button type="button" class="text-btn" data-copy="<%= shortUrl %>" aria-label="Copy the short link"><%- include('partials/icon', { icon: 'copy' }) %> Copy link</button>
          </div>
        </div>
      </div>

      <div class="item-facts">
        <span><%- include('partials/icon', { icon: 'bio' }) %> <%= owner.username %></span>
        <span><%= sizeFormatted %></span>
        <span><%= file.mimeType %></span>
        <span><%- include('partials/icon', { icon: 'calendar' }) %> <%= day(file.createdAt) %></span>
        <span><%- include('partials/icon', { icon: 'download' }) %> <%= file.downloads.toLocaleString('en-US') %><%= file.maxDownloads ? ` / ${file.maxDownloads.toLocaleString('en-US')}` : '' %> download<%= file.downloads === 1 && !file.maxDownloads ? '' : 's' %></span>
        <% if (file.expiresAt) { %><span>Expires <%= day(file.expiresAt) %></span><% } %>
      </div>
      <%- include('partials/tag-chips', { tags: file.tags || [] }) %>

      <% if (file.sharingMode === 'restricted' && allowedUsernames.length > 0) { %>
        <p class="file-shared"><%- include('partials/icon', { icon: 'teams' }) %> Shared with <%= allowedUsernames.map(u => '@' + u).join(', ') %></p>
      <% } %>

      <div class="item-actions">
        <a href="<%= downloadUrl %>" class="btn btn-large"><%- include('partials/icon', { icon: 'download' }) %> Download</a>
      </div>

      <% if (features.reports) { %>
      <div class="item-footer">
        <span></span>
        <button type="button" class="text-btn danger" data-report-button><%- include('partials/icon', { icon: 'flag' }) %> <span data-report-label>Report this file</span></button>
      </div>
      <% } %>
    </article>
  </main>

  <% if (features.reports) { %>
    <%- include('partials/report-modal', { type: 'file', id: file.id, noun: 'file' }) %>
  <% } %>
  <script src="/js/main.js"></script>
  <script src="/js/public-item.js"></script>
<%- include('partials/layout-end', { shell: 'public' }) %>
</html>
