<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Bio page', styles: ['forms', 'sections', 'bio-settings'] }) %>
  <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
  <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>
<%- include('partials/layout-start', { shell: 'app', currentPage: 'bio-settings' }) %>
<%
  const DASHBOARD_ICONS = 'https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg';
  const isIonicon = (name) => name.endsWith('-outline') || name.startsWith('logo-');
  const shown = userUrls.filter(url => bioPageUrlIds.has(url.id)).length;
-%>
  <main class="main-content-wide bio-settings">
    <div class="header-section">
      <div>
        <h2>Bio page</h2>
        <p>Your link-in-bio page at <a href="/bio/<%= user.username %>" target="_blank" rel="noopener">/bio/<%= user.username %></a></p>
      </div>
      <div class="header-actions">
        <a href="/bio/<%= user.username %>" class="btn btn-secondary" target="_blank" rel="noopener"><%- include('partials/icon', { icon: 'external' }) %> View page</a>
      </div>
    </div>

    <div class="bio-columns">
      <div class="bio-main">
        <section class="section-card">
          <h3>Profile</h3>
          <p class="section-help">Shown at the top of your page.</p>
          <div class="form-group">
            <label for="displayName" class="form-label">Display name</label>
            <input type="text" id="displayName" class="form-input" value="<%= bioPage.displayName %>" maxlength="100" required>
          </div>
          <div class="form-group">
            <label for="bio" class="form-label">Bio <span class="muted">up to 500 characters</span></label>
            <textarea id="bio" class="form-input" rows="3" maxlength="500" placeholder="Tell people about yourself…"><%= bioPage.bio || '' %></textarea>
          </div>
          <div class="form-group">
            <label for="theme" class="form-label">Theme</label>
            <select id="theme" class="form-input">
              <option value="dark" <%= bioPage.theme === 'dark' ? 'selected' : '' %>>Dark</option>
              <option value="light" <%= bioPage.theme === 'light' ? 'selected' : '' %>>Light</option>
              <option value="gradient" <%= bioPage.theme === 'gradient' ? 'selected' : '' %>>Gradient</option>
            </select>
          </div>
          <div class="gradient-pickers" id="gradientColorPickers"<%= bioPage.theme === 'gradient' ? '' : ' hidden' %>>
            <% [['gradientStart', 'From', bioPage.gradientStart || '#667eea'], ['gradientEnd', 'To', bioPage.gradientEnd || '#764ba2']].forEach(([id, label, value]) => { %>
            <div class="form-group">
              <label for="<%= id %>Hex" class="form-label"><%= label %></label>
              <div class="color-row">
                <div class="color-picker-wrapper"><input type="color" id="<%= id %>" class="color-picker-input" value="<%= value %>" aria-label="Pick the <%= label.toLowerCase() %> color"></div>
                <input type="text" id="<%= id %>Hex" class="form-input" value="<%= value %>" placeholder="#667eea" pattern="^#[0-9A-Fa-f]{6}$">
              </div>
            </div>
            <% }) %>
          </div>
        </section>

        <section class="section-card">
          <h3>Social links</h3>
          <p class="section-help">Icons under your name: GitHub, Mastodon, your email…</p>
          <div id="socialLinksContainer" class="social-links">
            <p class="muted social-empty"<%= socialLinks.length ? ' hidden' : '' %>>No social links yet.</p>
            <% socialLinks.forEach((link, index) => { const icon = link.icon || 'link-outline'; %>
            <div class="social-link-item" data-index="<%= index %>">
              <button type="button" class="icon-picker-trigger" data-icon-value="<%= icon %>" aria-label="Choose an icon">
                <span class="icon-preview-slot">
                  <% if (isIonicon(icon)) { %>
                    <ion-icon name="<%= icon %>" class="social-icon-preview"></ion-icon>
                  <% } else { %>
                    <img src="<%= DASHBOARD_ICONS %>/<%= icon %>-light.svg" data-icon="<%= icon %>" class="social-icon-preview" alt="">
                  <% } %>
                </span>
                <ion-icon name="chevron-down-outline" class="chevron-icon"></ion-icon>
              </button>
              <input type="hidden" class="social-icon" value="<%= icon %>">
              <input type="text" class="form-input social-platform" value="<%= link.platform || '' %>" placeholder="Name (optional)" aria-label="Name">
              <input type="url" class="form-input social-url" value="<%= link.url %>" placeholder="https://…" aria-label="Address">
              <button type="button" class="icon-btn danger remove-social-link" title="Remove" aria-label="Remove this link"><%- include('partials/icon', { icon: 'trash' }) %></button>
            </div>
            <% }) %>
          </div>
          <button type="button" class="btn btn-small btn-secondary" id="addSocialLinkBtn"><%- include('partials/icon', { icon: 'plus' }) %> Add a social link</button>
        </section>

        <div class="save-bar" id="saveBar" data-state="clean">
          <span class="save-bar-status" id="saveStatus">No unsaved changes</span>
          <button type="button" class="btn btn-small" id="saveBioBtn">Save</button>
        </div>
      </div>

      <section class="section-card bio-links">
        <div class="section-head">
          <h3>Links on your page</h3>
          <span class="muted" id="bioLinkCount"><%= shown %> of <%= userUrls.length %></span>
        </div>
        <p class="section-help">Tick the short links to show. Saved right away.</p>
        <% if (userUrls.length === 0) { %>
          <p class="muted">No links yet. <a href="/">Create your first link</a>.</p>
        <% } else { %>
          <div class="link-picker">
            <% userUrls.forEach(url => { %>
            <label class="link-picker-item">
              <input type="checkbox" data-url-id="<%= url.id %>"<%= bioPageUrlIds.has(url.id) ? ' checked' : '' %>>
              <span class="link-picker-text">
                <span class="link-picker-slug">/s/<%= url.slug %></span>
                <span class="link-picker-destination"><%= url.longUrl %></span>
                <%- include('partials/tag-chips', { tags: url.tags || [] }) %>
              </span>
              <span class="link-picker-clicks"><%= Number(url.clicks || 0).toLocaleString('en-US') %></span>
            </label>
            <% }) %>
          </div>
        <% } %>
      </section>
    </div>
  </main>

  <!-- Icon picker -->
  <div id="iconPickerModal" class="icon-picker-modal">
    <div class="icon-picker-content" role="dialog" aria-modal="true" aria-labelledby="iconPickerTitle">
      <div class="icon-picker-header">
        <h3 id="iconPickerTitle">Choose an icon</h3>
        <button type="button" class="icon-picker-close" id="iconPickerClose" aria-label="Close"><%- include('partials/icon', { icon: 'close' }) %></button>
      </div>
      <div class="icon-picker-search">
        <input type="text" id="iconSearchInput" class="form-input" placeholder="Search icons…" autocomplete="off" aria-label="Search icons">
      </div>
      <div id="iconPickerGrid" class="icon-picker-grid"></div>
    </div>
  </div>

  <script src="/js/main.js"></script>
  <script src="/js/bio-settings.js"></script>
<%- include('partials/layout-end', { shell: 'app' }) %>
</html>
