<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Import / export', styles: ['forms', 'sections', 'import'] }) %>
</head>
<%- include('partials/layout-start', { shell: 'app', currentPage: 'import' }) %>
<%
  const hourly = locals.limits || {};
  const number = (n) => Number(n).toLocaleString('en-US');
  const limitParts = [
    hourly.importsPerHour === null || hourly.importsPerHour === undefined ? null : `Up to ${number(hourly.importsPerHour)} import${hourly.importsPerHour === 1 ? '' : 's'} per hour`,
    hourly.importBatchSize === null || hourly.importBatchSize === undefined ? null : `${number(hourly.importBatchSize)} links per import`
  ].filter(Boolean);
-%>
  <main class="main-content-wide page-narrow">
    <div class="header-section">
      <div>
        <h2>Import / export</h2>
        <p>Many short links at once, from a CSV, JSON or text file, and all of yours back out.</p>
      </div>
    </div>

    <section class="section-card">
      <h3>Import links</h3>
      <p class="section-help"><%= limitParts.length ? limitParts.join(' · ') : 'No limits for your account' %>. Files up to 10 MB.</p>
      <form id="importForm" class="import-form">
        <div class="form-group">
          <label for="importFile" class="form-label">File (CSV, JSON or TXT)</label>
          <input type="file" id="importFile" name="file" class="form-input" accept=".csv,.json,.txt" required>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn" id="importBtn"><%- include('partials/icon', { icon: 'upload' }) %> Import</button>
          <a href="/api/import/template" class="btn btn-secondary"><%- include('partials/icon', { icon: 'download' }) %> CSV template</a>
        </div>
      </form>
      <div id="importResults" class="import-results" aria-live="polite" hidden></div>
    </section>

    <section class="section-card">
      <h3>Export links</h3>
      <p class="section-help">All your personal links with their clicks, tags and settings.</p>
      <div class="form-actions">
        <a href="/api/export?format=csv" class="btn"><%- include('partials/icon', { icon: 'download' }) %> CSV</a>
        <a href="/api/export?format=json" class="btn btn-secondary"><%- include('partials/icon', { icon: 'download' }) %> JSON</a>
      </div>
    </section>

    <details class="section-card import-guide">
      <summary><h3>File formats</h3><span class="muted">CSV, JSON and plain text, with examples</span></summary>

      <h4>CSV</h4>
      <p>Commas between columns; only <code>longUrl</code> is required. Separate several tags with semicolons.</p>
      <pre><code>longUrl,slug,tags,expirationDays,maxUses
https://example.com/page1,link1,marketing;email,30,100
https://example.com/page2,link2,social-media,60,50
https://example.com/page3,,,90,
https://example.com/page4</code></pre>

      <h4>JSON</h4>
      <p>A list of objects with the same fields. Tags are one string, separated by commas.</p>
      <pre><code>[
  {
    "longUrl": "https://example.com/page1",
    "slug": "my-link",
    "tags": "marketing, campaign, email",
    "expirationDays": 30,
    "maxUses": 100
  },
  { "longUrl": "https://example.com/page2", "tags": "social-media" }
]</code></pre>

      <h4>Plain text</h4>
      <p>One link per line.</p>
      <pre><code>https://example.com/page1
https://example.com/page2</code></pre>

      <h4>Columns</h4>
      <div class="table-scroll">
        <table class="section-table">
          <thead><tr><th>Column</th><th>Required</th><th>What it is</th></tr></thead>
          <tbody>
            <tr><td><code>longUrl</code></td><td>Yes</td><td>The destination, with http:// or https://</td></tr>
            <tr><td><code>slug</code></td><td>No</td><td>Your own short code; empty makes one up</td></tr>
            <tr><td><code>tags</code></td><td>No</td><td>CSV: <code>marketing;email</code> · JSON: <code>"marketing, email"</code></td></tr>
            <tr><td><code>expirationDays</code></td><td>No</td><td>Days until the link expires; empty never expires</td></tr>
            <tr><td><code>maxUses</code></td><td>No</td><td>Clicks until the link stops working; empty has no limit</td></tr>
          </tbody>
        </table>
      </div>
    </details>
  </main>

  <script src="/js/import.js"></script>
<%- include('partials/layout-end', { shell: 'app' }) %>
</html>
