<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: bioPage.displayName, styles: ['bio-page'] }) %>
  <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
  <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>
<%- include('partials/layout-start', {
  shell: 'standalone',
  bodyClass: `bio-theme-${bioPage.theme}`,
  bodyStyle: bioPage.theme === 'gradient'
    ? `--bio-from: ${bioPage.gradientStart || '#667eea'}; --bio-to: ${bioPage.gradientEnd || '#764ba2'};`
    : null
}) %>
<%
  const DASHBOARD_ICONS = 'https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg';
  // What a link reads as: its label, else the destination's domain (and the rest of the address below)
  const parts = (address) => {
    try {
      const u = new URL(address);
      const rest = `${u.pathname === '/' ? '' : u.pathname}${u.search}`;
      return { host: u.hostname.replace(/^www\./, ''), rest };
    } catch (_) { return { host: address, rest: '' }; }
  };
-%>
  <header class="bio-header">
    <%- include('partials/brand') %>
    <% if (user && user.username === username) { %>
      <a href="/bio/settings" class="bio-edit">Edit your page</a>
    <% } %>
  </header>

  <main class="bio-container">
    <div class="bio-profile">
      <h1 class="bio-display-name"><%= bioPage.displayName %></h1>
      <p class="bio-username">@<%= username %></p>
      <% if (bioPage.bio) { %><p class="bio-text"><%= bioPage.bio %></p><% } %>

      <% if (socialLinks && socialLinks.length > 0) { %>
        <div class="bio-social-links">
          <% socialLinks.forEach(link => { const iconName = link.icon || 'link-outline'; %>
            <a href="<%= link.url %>" target="_blank" rel="noopener noreferrer" class="bio-social-link" title="<%= link.platform || link.url %>">
              <% if (iconName.endsWith('-outline') || iconName.startsWith('logo-')) { %>
                <ion-icon name="<%= iconName %>" class="bio-social-icon"></ion-icon>
              <% } else { %>
                <img src="<%= DASHBOARD_ICONS %>/<%= iconName %>-light.svg" data-icon="<%= iconName %>" class="bio-social-icon" alt="">
              <% } %>
              <% if (link.platform) { %><span><%= link.platform %></span><% } %>
            </a>
          <% }); %>
        </div>
      <% } %>
    </div>

    <div class="bio-links">
      <% if (urls.length === 0) { %>
        <p class="bio-empty">No links yet</p>
      <% } else { %>
        <% urls.forEach(url => { const { host, rest } = parts(url.longUrl); %>
          <a href="<%= baseUrl %>/s/<%= url.slug %>" class="bio-link-card" target="_blank" rel="noopener">
            <span class="bio-link-content">
              <span class="bio-link-title"><%= url.label || host %></span>
              <% if (url.label) { %><span class="bio-link-sub"><%= host %></span>
              <% } else if (rest) { %><span class="bio-link-sub"><%= rest %></span><% } %>
              <%- include('partials/tag-chips', { tags: url.tags || [] }) %>
            </span>
            <span class="bio-link-arrow"><%- include('partials/icon', { icon: 'chevronRight' }) %></span>
          </a>
        <% }); %>
      <% } %>
    </div>
  </main>
<script src="/js/bio-icons.js"></script>
<%- include('partials/layout-end', { shell: 'standalone' }) %>
</html>
