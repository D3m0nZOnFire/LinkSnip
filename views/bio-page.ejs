<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: bioPage.displayName, styles: ['bio-page'] }) %>
  <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
  <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
</head>
<body class="bio-theme-<%= bioPage.theme %>" <% if (bioPage.theme === 'gradient') { %>style="background: linear-gradient(135deg, <%= bioPage.gradientStart || '#667eea' %> 0%, <%= bioPage.gradientEnd || '#764ba2' %> 100%);"<% } %>>
  <div class="page">
  <!-- Optional minimal header for navigation -->
  <div class="bio-header">
    <a href="/" class="bio-home-link">
      <img src="/logo.png" alt="LinkSnip" style="height: 24px;">
    </a>
    <% if (user && user.username === username) { %>
      <a href="/bio/settings" class="btn-small" style="color: var(--primary-foreground);">Edit Bio Page</a>
    <% } %>
  </div>

  <!-- Bio Page Content -->
  <main class="bio-container">
    <!-- Profile Section -->
    <div class="bio-profile">
      <h1 class="bio-display-name"><%= bioPage.displayName %></h1>
      <p class="bio-username">@<%= username %></p>

      <% if (bioPage.bio) { %>
        <p class="bio-text"><%= bioPage.bio %></p>
      <% } %>

      <!-- Social Links -->
      <% if (socialLinks && socialLinks.length > 0) { %>
        <div class="bio-social-links">
          <% socialLinks.forEach(link => { %>
            <a
              href="<%= link.url %>"
              target="_blank"
              rel="noopener noreferrer"
              class="bio-social-link"
              title="<%= link.platform || link.url %>"
            >
              <% const iconName = link.icon || 'link-outline'; %>
              <% if (iconName.endsWith('-outline') || iconName.startsWith('logo-')) { %>
                <ion-icon name="<%= iconName %>" style="font-size: 1.5rem;"></ion-icon>
              <% } else { %>
                <img src="https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/<%= iconName %>-light.svg"
                     data-icon="<%= iconName %>"
                     style="width:1.5rem;height:1.5rem;"
                     alt=""
                     onerror="this.onerror=null;this.src='https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/<%= iconName %>.svg'">
              <% } %>
              <% if (link.platform) { %>
                <span style="margin-left: 0.5rem;"><%= link.platform %></span>
              <% } %>
            </a>
          <% }); %>
        </div>
      <% } %>
    </div>

    <!-- URLs Section -->
    <div class="bio-links">
      <% if (urls.length === 0) { %>
        <p class="bio-empty">No links available yet</p>
      <% } else { %>
        <% urls.forEach(url => { %>
          <a
            href="<%= baseUrl %>/s/<%= url.slug %>"
            class="bio-link-card"
            target="_blank"
            rel="noopener"
          >
            <div class="bio-link-content">
              <div class="bio-link-title">
                <%= baseUrl %>/s/<%= url.slug %>
              </div>

              <% if (url.tags && url.tags.length > 0) { %>
                <div class="bio-link-tags">
                  <% url.tags.forEach(tag => { %>
                    <span class="bio-tag" style="background-color: <%= tag.color %>20; color: <%= tag.color %>;">
                      <%= tag.name %>
                    </span>
                  <% }); %>
                </div>
              <% } %>
            </div>

            <div class="bio-link-arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </div>
          </a>
        <% }); %>
      <% } %>
    </div>

    <!-- Footer -->
    <footer class="bio-footer">
      <p>Powered by <a href="/">LinkSnip</a></p>
    </footer>
  </main>
<script>
  (function() {
    var cdn = 'https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg';
    function updateDashboardIcons() {
      var theme = document.documentElement.getAttribute('data-theme') || 'dark';
      var suffix = theme === 'dark' ? '-light' : '-dark';
      document.querySelectorAll('img[data-icon]').forEach(function(img) {
        var name = img.dataset.icon;
        img.onerror = function() { this.onerror = null; this.src = cdn + '/' + name + '.svg'; };
        img.src = cdn + '/' + name + suffix + '.svg';
      });
    }
    updateDashboardIcons();
    new MutationObserver(updateDashboardIcons)
      .observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  })();
</script>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
