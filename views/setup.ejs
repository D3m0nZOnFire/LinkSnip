<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Setup', styles: ['forms', 'auth'], noindex: true }) %>
</head>
<%- include('partials/layout-start', { shell: 'standalone', pageClass: 'page-center' }) %>
  <main class="auth-card">
    <div class="auth-brand"><%- include('partials/brand', { large: true }) %></div>
    <div class="auth-heading">
      <h1>Set up <%= branding.name %></h1>
      <p>Create the first admin account</p>
    </div>
    <form class="auth-form" action="/setup" method="POST">
      <% if (error) { %><div class="auth-error" role="alert"><%= error %></div><% } %>
      <div class="form-group">
        <label for="code" class="form-label">Setup code</label>
        <input type="text" id="code" name="code" class="form-input" placeholder="XXXX-XXXX-XXXX"
          autocomplete="off" autocapitalize="characters" spellcheck="false" required<%= error ? '' : ' autofocus' %>>
        <p class="field-help">Printed in the server log when LinkSnip started (<code>docker compose logs linksnip</code>).</p>
      </div>
      <div class="form-group">
        <label for="username" class="form-label">Admin username</label>
        <input type="text" id="username" name="username" class="form-input" value="<%= username %>" autocomplete="username" required>
      </div>
      <div class="form-group">
        <label for="password" class="form-label">Password <span class="muted">at least <%= minPassword %> characters</span></label>
        <input type="password" id="password" name="password" class="form-input" minlength="<%= minPassword %>"
          autocomplete="new-password" required data-toggle-password>
      </div>
      <div class="form-group">
        <label for="confirmPassword" class="form-label">Repeat the password</label>
        <input type="password" id="confirmPassword" name="confirmPassword" class="form-input" minlength="<%= minPassword %>"
          autocomplete="new-password" required data-toggle-password>
      </div>
      <button type="submit" class="btn">Create admin</button>
    </form>
    <div class="auth-links">
      <p>Lost the code? Restart LinkSnip to print a new one, or run <code>npm run admin</code>.</p>
    </div>
  </main>
  <script src="/js/main.js"></script>
<%- include('partials/layout-end', { shell: 'standalone' }) %>
</html>
