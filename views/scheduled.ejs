<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: title, styles: ['public-pages'] }) %>
</head>
<%- include('partials/layout-start', { shell: 'standalone', pageClass: 'page-center' }) %>
<% const when = (value) => new Date(value).toLocaleString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'UTC' }) + ' UTC'; -%>
  <main class="status-card warning">
    <span class="status-icon"><%- include('partials/icon', { icon: 'calendar' }) %></span>
    <h1><%= title %></h1>
    <p><%= message %></p>
    <% if (activateAt) { %>
      <div class="status-detail">
        <span class="destination-label">Starts working</span>
        <%= when(activateAt) %>
      </div>
    <% } %>
    <% if (locals.path) { %>
      <div class="status-detail">
        <span class="destination-label">Short link</span>
        <%= path %>
      </div>
    <% } %>
    <%# No info link: info pages hide scheduled items %>
    <div class="status-actions">
      <a href="/" class="btn btn-secondary">Go to the home page</a>
    </div>
  </main>
<%- include('partials/layout-end', { shell: 'standalone' }) %>
</html>
