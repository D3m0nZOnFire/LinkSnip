<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reports - Admin Panel - LinkSnip</title>
  <link rel="icon" type="image/png" href="/logo.png">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/tables.css">
  <link rel="stylesheet" href="/css/modals.css">
  <script src="/js/theme.js"></script>
</head>
<body>
  <%- include('partials/header', { currentPage: 'admin-reports' }) %>

  <!-- Main Content -->
  <main class="main-content-wide">
    <!-- Header Section -->
    <div class="header-section">
      <div>
        <h2>Report Management</h2>
        <p>Total reports: <span class="count"><%= pagination.totalReports %></span></p>
      </div>
    </div>

    <!-- Quarantined: reported past the threshold, visitors see a warning until decided -->
    <% if (quarantined.length > 0) { %>
    <section style="margin-bottom: 2rem; border: 1px solid var(--status-error-border); background: var(--status-error-bg); border-radius: 8px; padding: 1rem;">
      <h3 style="margin: 0 0 0.25rem 0;">Quarantined (<%= quarantined.length %>)</h3>
      <p style="margin: 0 0 1rem 0; color: var(--muted-foreground); font-size: 0.875rem;">
        Visitors see a warning before these open. Block to shut them off, or clear to dismiss the reports and lift the warning.
      </p>
      <div class="table-container">
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Item</th>
                <th>Target</th>
                <th>Reports</th>
                <th>Reasons</th>
                <th style="text-align: right;">Decision</th>
              </tr>
            </thead>
            <tbody>
              <% quarantined.forEach(item => { %>
                <tr data-quarantine="<%= item.type %>-<%= item.id %>">
                  <td><a href="<%= item.type === 'url' ? '/info/' + item.slug : item.path %>" target="_blank" rel="noopener"><%= item.path %></a></td>
                  <td style="max-width: 320px; word-break: break-all;"><%= item.target %></td>
                  <td><%= item.pendingReports %></td>
                  <td><%= item.reasons.map(r => reasons[r] || r).join(', ') %></td>
                  <td style="text-align: right; white-space: nowrap;">
                    <button type="button" class="btn" style="background: var(--destructive); color: #fff;" onclick="moderate('<%= item.type %>', <%= item.id %>, 'block')">Block</button>
                    <button type="button" class="btn" style="background: var(--secondary); color: var(--foreground);" onclick="moderate('<%= item.type %>', <%= item.id %>, 'clear')">Clear</button>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
    <% } %>

    <!-- Stats Overview -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
      <div style="background: var(--info-bg); border: 1px solid var(--info-border); border-radius: 8px; padding: 1rem;">
        <h3 style="margin: 0; font-size: 0.875rem; color: var(--muted-foreground);">PENDING</h3>
        <p style="margin: 0.5rem 0 0 0; font-size: 1.5rem; font-weight: bold; color: var(--primary);"><%= stats.pending || 0 %></p>
      </div>
      <div style="background: var(--info-bg); border: 1px solid var(--info-border); border-radius: 8px; padding: 1rem;">
        <h3 style="margin: 0; font-size: 0.875rem; color: var(--muted-foreground);">REVIEWED</h3>
        <p style="margin: 0.5rem 0 0 0; font-size: 1.5rem; font-weight: bold; color: var(--primary);"><%= stats.reviewed || 0 %></p>
      </div>
      <div style="background: var(--info-bg); border: 1px solid var(--info-border); border-radius: 8px; padding: 1rem;">
        <h3 style="margin: 0; font-size: 0.875rem; color: var(--muted-foreground);">BLOCKED</h3>
        <p style="margin: 0.5rem 0 0 0; font-size: 1.5rem; font-weight: bold; color: var(--status-error-text);"><%= stats.blocked || 0 %></p>
      </div>
      <div style="background: var(--info-bg); border: 1px solid var(--info-border); border-radius: 8px; padding: 1rem;">
        <h3 style="margin: 0; font-size: 0.875rem; color: var(--muted-foreground);">DISMISSED</h3>
        <p style="margin: 0.5rem 0 0 0; font-size: 1.5rem; font-weight: bold; color: var(--primary);"><%= stats.dismissed || 0 %></p>
      </div>
    </div>

    <!-- Type Tabs (switched-off features have no tab) -->
    <%
      const TYPE_TABS = [
        { key: 'all', label: 'All', feature: null },
        { key: 'url', label: 'Links', feature: null },
        { key: 'bundle', label: 'Bundles', feature: 'bundles' },
        { key: 'paste', label: 'Pastes', feature: 'pastes' },
        { key: 'file', label: 'Files', feature: 'files' }
      ].filter(t => !t.feature || features[t.feature]);
      const TYPE_LABELS = { url: 'Link', bundle: 'Bundle', paste: 'Paste', file: 'File' };
      const statusQuery = currentStatus === null ? '&status=all' : (currentStatus === 'pending' ? '' : `&status=${currentStatus}`);
    %>
    <div style="margin-bottom: 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem;">
      <% TYPE_TABS.forEach(tab => { %>
        <a href="/admin/reports?type=<%= tab.key %><%= statusQuery %>" class="btn <%= type === tab.key ? 'active' : '' %>" style="padding: 0.5rem 1rem; display: inline-flex; align-items: center; gap: 0.4rem;">
          <%= tab.label %>
          <% if (typeStats[tab.key] && typeStats[tab.key].pending > 0) { %>
            <span style="background: var(--destructive); color: #fff; border-radius: 999px; font-size: 0.7rem; font-weight: 700; padding: 0.1rem 0.45rem; line-height: 1.4;"><%= typeStats[tab.key].pending %></span>
          <% } %>
        </a>
      <% }) %>
    </div>

    <!-- Status Filter Tabs -->
    <div style="margin-bottom: 1.5rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
      <a href="/admin/reports?type=<%= type %>" class="btn <%= currentStatus === 'pending' ? 'active' : '' %>" style="padding: 0.5rem 1rem;">Pending</a>
      <a href="/admin/reports?type=<%= type %>&status=reviewed" class="btn <%= currentStatus === 'reviewed' ? 'active' : '' %>" style="padding: 0.5rem 1rem;">Reviewed</a>
      <a href="/admin/reports?type=<%= type %>&status=blocked" class="btn <%= currentStatus === 'blocked' ? 'active' : '' %>" style="padding: 0.5rem 1rem;">Blocked</a>
      <a href="/admin/reports?type=<%= type %>&status=dismissed" class="btn <%= currentStatus === 'dismissed' ? 'active' : '' %>" style="padding: 0.5rem 1rem;">Dismissed</a>
      <a href="/admin/reports?type=<%= type %>&status=all" class="btn <%= currentStatus === null ? 'active' : '' %>" style="padding: 0.5rem 1rem;">All</a>
    </div>

    <!-- Reports Table (every type) -->
    <% if (reports.length === 0) { %>
      <div class="empty-state">
        <p>No reports found</p>
      </div>
    <% } else { %>
      <div class="table-container">
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Reported item</th>
                <th>Owner</th>
                <th>Reason</th>
                <th>Description</th>
                <th>Status</th>
                <th>Reported</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% reports.forEach(report => { %>
                <tr data-report-id="<%= report.id %>" data-path="<%= report.path %>">
                  <td>
                    <span class="badge" style="background: var(--secondary); color: var(--foreground);"><%= TYPE_LABELS[report.targetType] %></span>
                    <a href="<%= report.targetType === 'url' ? '/info/' + report.slug : report.path %>" target="_blank" rel="noopener" class="url-link"><%= report.path %></a>
                    <br>
                    <small class="long-url" style="color: var(--muted-foreground); display: block; max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="<%= report.target || '' %>">
                      <%= report.target || '' %>
                    </small>
                    <% if (report.isBlocked) { %>
                      <span class="badge" style="background-color: var(--destructive);">BLOCKED</span>
                    <% } else if (report.isQuarantined) { %>
                      <span class="badge" style="background-color: var(--status-warning-text);">UNDER REVIEW</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (report.creatorUsername) { %>
                      <%= report.creatorUsername %>
                      <% if (report.creatorIsBanned) { %>
                        <br><span class="badge" style="background-color: var(--status-warning-text);">BANNED</span>
                      <% } %>
                    <% } else { %>
                      <span style="color: var(--muted-foreground);">Anonymous</span>
                    <% } %>
                  </td>
                  <td><%= reasons[report.reason] || report.reason %></td>
                  <td><%= report.description || '-' %></td>
                  <td>
                    <span class="badge <%= report.status === 'pending' ? 'badge-active' : (report.status === 'blocked' ? 'badge-max' : 'badge-expired') %>">
                      <%= report.status.toUpperCase() %>
                    </span>
                  </td>
                  <td><%= new Date(report.createdAt).toLocaleString('en-GB') %></td>
                  <td>
                    <div class="actions">
                      <% if (report.status === 'pending') { %>
                        <% if (!report.isBlocked) { %>
                          <button class="icon-btn danger" onclick="setBlocked(<%= report.id %>, 'block')" title="Block">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <circle cx="12" cy="12" r="10"></circle>
                              <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                            </svg>
                          </button>
                        <% } else { %>
                          <button class="icon-btn" onclick="setBlocked(<%= report.id %>, 'unblock')" title="Unblock">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <polyline points="9 11 12 14 22 4"></polyline>
                              <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                            </svg>
                          </button>
                        <% } %>
                        <% if (report.ownerId && !report.creatorIsBanned && report.ownerId !== user.id) { %>
                          <button class="icon-btn danger" onclick="banOwner(this, <%= report.id %>, <%= report.ownerId %>)" data-username="<%= report.creatorUsername %>" title="Ban user (<%= report.creatorUsername %>)">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                              <circle cx="8.5" cy="7" r="4"></circle>
                              <line x1="23" y1="11" x2="17" y2="11"></line>
                            </svg>
                          </button>
                        <% } else if (report.ownerId && report.ownerId === user.id) { %>
                          <button class="icon-btn" disabled title="Cannot ban yourself" style="opacity: 0.3; cursor: not-allowed;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                              <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                              <circle cx="8.5" cy="7" r="4"></circle>
                              <line x1="23" y1="11" x2="17" y2="11"></line>
                            </svg>
                          </button>
                        <% } %>
                        <button class="icon-btn" onclick="dismissReport(<%= report.id %>)" title="Dismiss">
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                          </svg>
                        </button>
                      <% } %>
                      <button class="icon-btn danger" onclick="deleteReport(<%= report.id %>)" title="Delete report">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <polyline points="3 6 5 6 21 6"></polyline>
                          <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </main>

  <script src="/js/main.js"></script>
  <script>
    // One helper for every admin call on this page: confirm, send, reload or show the error
    async function send(url, options, question) {
      if (question && !confirm(question)) return;
      try {
        const res = await fetch(url, options);
        const data = await res.json();
        if (!data.success) return alert(data.error || 'Action failed');
        if (options.method === 'POST' && data.message && url.endsWith('/ban-user')) alert(data.message);
        location.reload();
      } catch (e) {
        alert('Request failed');
      }
    }

    const json = (method, body) => ({ method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const pathOf = (reportId) => document.querySelector(`tr[data-report-id="${reportId}"]`).dataset.path;

    function moderate(type, id, action) {
      send(`/api/admin/moderation/${type}/${id}/${action}`, { method: 'POST' }, action === 'block'
        ? 'Block this permanently? Visitors will no longer be able to open it.'
        : 'Clear it? Its pending reports are dismissed and the warning is lifted.');
    }

    function setBlocked(reportId, action) {
      send(`/api/admin/reports/${reportId}`, json('PUT', { action }), `${action === 'block' ? 'Block' : 'Unblock'} ${pathOf(reportId)}?`);
    }

    function dismissReport(reportId) {
      send(`/api/admin/reports/${reportId}`, json('PUT', { status: 'dismissed' }), 'Dismiss this report?');
    }

    function deleteReport(reportId) {
      send(`/api/admin/reports/${reportId}`, { method: 'DELETE' }, 'Delete this report permanently?');
    }

    function banOwner(button, reportId, userId) {
      const username = button.dataset.username;
      send(`/api/admin/reports/${reportId}/ban-user`, json('POST', { userId }),
        `Ban user "${username}"? This will:\n- Block everything they own (links, bundles, pastes, files)\n- Stop them from logging in\n- Mark the report as blocked\n\nThe ban can be lifted from the Users page; their items stay blocked until unblocked.`);
    }
  </script>
  <%- include('partials/footer') %>
</body>
</html>
