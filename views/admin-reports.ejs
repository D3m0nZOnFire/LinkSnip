<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Reports · Admin', styles: ['tables', 'modals', 'admin-pages'] }) %>
</head>
<%- include('partials/layout-start', { shell: 'admin', currentPage: 'admin-reports' }) %>
<%
  // Switched-off features have no tab
  const TYPE_TABS = [
    { key: 'all', label: 'All', feature: null },
    { key: 'url', label: 'Links', feature: null },
    { key: 'bundle', label: 'Bundles', feature: 'bundles' },
    { key: 'paste', label: 'Pastes', feature: 'pastes' },
    { key: 'file', label: 'Files', feature: 'files' }
  ].filter(t => !t.feature || features[t.feature]);
  const TYPE_LABELS = { url: 'Link', bundle: 'Bundle', paste: 'Paste', file: 'File' };
  const STATUSES = [['pending', 'Pending'], ['reviewed', 'Reviewed'], ['blocked', 'Blocked'], ['dismissed', 'Dismissed'], ['all', 'All']];
  const statusQuery = currentStatus === null ? '&status=all' : (currentStatus === 'pending' ? '' : `&status=${currentStatus}`);
  const STATUS_BADGES = { pending: 'badge-max', blocked: 'badge-expired', reviewed: 'badge-muted', dismissed: 'badge-muted' };
  const itemHref = (item) => item.type === 'url' || item.targetType === 'url' ? `/info/${item.slug}` : item.path;
-%>

  <main class="main-content-wide">
    <div class="header-section">
      <div>
        <h2>Reports</h2>
        <p><%= pagination.totalReports %> report<%= pagination.totalReports === 1 ? '' : 's' %></p>
      </div>
    </div>

    <% if (quarantined.length > 0) { %>
    <!-- Reported past the threshold: visitors see a warning until an admin decides -->
    <section class="attention-panel">
      <h3>Under review (<%= quarantined.length %>)</h3>
      <p>Visitors see a warning before these open. Block to shut them off, or clear to dismiss the reports and lift the warning.</p>
      <div class="table-container scroll">
        <div class="table-wrapper">
          <table>
            <thead>
              <tr><th>Item</th><th>Target</th><th class="text-right">Reports</th><th>Reasons</th><th class="text-right">Decision</th></tr>
            </thead>
            <tbody>
              <% quarantined.forEach(item => { %>
                <tr data-type="<%= item.type %>" data-id="<%= item.id %>">
                  <td class="nowrap"><a href="<%= itemHref(item) %>" target="_blank" rel="noopener"><%= item.path %></a></td>
                  <td class="wrap"><%= item.target %></td>
                  <td class="text-right"><%= item.pendingReports %></td>
                  <td><%= item.reasons.map(r => reasons[r] || r).join(', ') %></td>
                  <td>
                    <div class="row-actions">
                      <button type="button" class="btn btn-small btn-danger" data-moderate="block">Block</button>
                      <button type="button" class="btn btn-small btn-secondary" data-moderate="clear">Clear</button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
    <% } %>

    <div class="mini-stats">
      <div class="mini-stat"><div class="mini-stat-label">Pending</div><div class="mini-stat-value"><%= stats.pending || 0 %></div></div>
      <div class="mini-stat"><div class="mini-stat-label">Reviewed</div><div class="mini-stat-value"><%= stats.reviewed || 0 %></div></div>
      <div class="mini-stat danger"><div class="mini-stat-label">Blocked</div><div class="mini-stat-value"><%= stats.blocked || 0 %></div></div>
      <div class="mini-stat"><div class="mini-stat-label">Dismissed</div><div class="mini-stat-value"><%= stats.dismissed || 0 %></div></div>
    </div>

    <nav class="tabs" aria-label="Type">
      <% TYPE_TABS.forEach(tab => { %>
        <a href="/admin/reports?type=<%= tab.key %><%= statusQuery %>" class="tab"<%- type === tab.key ? ' aria-current="page"' : '' %>><%= tab.label %><% if (typeStats[tab.key] && typeStats[tab.key].pending > 0) { %><span class="tab-count" title="Pending"><%= typeStats[tab.key].pending %></span><% } %></a>
      <% }) %>
    </nav>

    <nav class="type-pills" aria-label="Status">
      <% STATUSES.forEach(([value, label]) => { const current = value === 'all' ? currentStatus === null : currentStatus === value; %>
        <a href="/admin/reports?type=<%= type %><%= value === 'pending' ? '' : `&status=${value}` %>" class="type-pill"<%- current ? ' aria-current="page"' : '' %>><%= label %></a>
      <% }) %>
    </nav>

    <% if (reports.length === 0) { %>
      <div class="empty-state"><p>No reports here.</p></div>
    <% } else { %>
      <div class="table-container scroll">
        <div class="table-wrapper">
          <table>
            <thead>
              <tr><th>Reported item</th><th>Owner</th><th>Reason</th><th>Description</th><th>Status</th><th class="text-right">Actions</th></tr>
            </thead>
            <tbody>
              <% reports.forEach(report => { %>
                <tr data-report-id="<%= report.id %>" data-path="<%= report.path %>" data-owner-id="<%= report.ownerId || '' %>" data-owner="<%= report.creatorUsername || '' %>">
                  <td>
                    <span class="badge badge-muted"><%= TYPE_LABELS[report.targetType] %></span>
                    <a href="<%= itemHref(report) %>" target="_blank" rel="noopener" class="url-link"><%= report.path %></a>
                    <% if (report.isBlocked) { %>
                      <span class="badge badge-expired">Blocked</span>
                    <% } else if (report.isQuarantined) { %>
                      <span class="badge badge-max">Under review</span>
                    <% } %>
                    <span class="cell-sub" title="<%= report.target || '' %>"><%= report.target || '' %></span>
                  </td>
                  <td class="nowrap">
                    <% if (report.creatorUsername) { %>
                      <%= report.creatorUsername %>
                      <% if (report.creatorIsBanned) { %><span class="badge badge-max">Banned</span><% } %>
                    <% } else { %>
                      <span class="muted">Anonymous</span>
                    <% } %>
                  </td>
                  <td class="nowrap">
                    <%= reasons[report.reason] || report.reason %>
                    <span class="cell-sub"><%= new Date(report.createdAt).toLocaleString('en-GB', { dateStyle: 'short', timeStyle: 'short' }) %></span>
                  </td>
                  <td class="clip" title="<%= report.description || '' %>"><%= report.description || '—' %></td>
                  <td><span class="badge <%= STATUS_BADGES[report.status] || 'badge-muted' %>"><%= report.status.charAt(0).toUpperCase() + report.status.slice(1) %></span></td>
                  <td>
                    <div class="row-actions">
                      <% if (report.status === 'pending') { %>
                        <% if (!report.isBlocked) { %>
                          <button type="button" class="icon-btn danger" data-action="block" title="Block the item" aria-label="Block the item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg></button>
                        <% } else { %>
                          <button type="button" class="icon-btn" data-action="unblock" title="Unblock the item" aria-label="Unblock the item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg></button>
                        <% } %>
                        <% if (report.ownerId && !report.creatorIsBanned && report.ownerId !== user.id) { %>
                          <button type="button" class="icon-btn danger" data-action="ban" title="Ban <%= report.creatorUsername %>" aria-label="Ban <%= report.creatorUsername %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="23" y1="11" x2="17" y2="11"/></svg></button>
                        <% } %>
                        <button type="button" class="icon-btn" data-action="dismiss" title="Dismiss the report" aria-label="Dismiss the report"><%- include('partials/icon', { icon: 'close' }) %></button>
                      <% } %>
                      <button type="button" class="icon-btn danger" data-action="delete" title="Delete the report" aria-label="Delete the report"><%- include('partials/icon', { icon: 'trash' }) %></button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </main>

  <%- include('partials/confirm-modal') %>

  <script src="/js/main.js"></script>
  <script src="/js/admin-reports.js"></script>
<%- include('partials/layout-end', { shell: 'admin' }) %>
</html>
