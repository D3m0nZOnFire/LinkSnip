<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin — Settings - LinkSnip</title>
  <link rel="icon" type="image/png" href="/logo.png">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/tables.css">
  <link rel="stylesheet" href="/css/forms.css">
  <link rel="stylesheet" href="/css/modals.css">
  <script src="/js/theme.js"></script>
  <style>
    .settings-section { margin-bottom: 2rem; }
    .settings-section h3 { margin-bottom: 0.75rem; }
    .setting-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 11rem;
      gap: 1rem;
      align-items: center;
      padding: 0.75rem 0;
      border-bottom: 1px solid var(--border);
    }
    .setting-row code { color: var(--primary); font-size: 0.875rem; }
    .setting-row p { margin: 0.25rem 0 0; color: var(--muted-foreground); font-size: 0.875rem; }
    .setting-control { justify-self: end; }
    .setting-control input[type="number"] { width: 11rem; }
    .setting-control input[type="checkbox"] { width: 1.25rem; height: 1.25rem; accent-color: var(--primary); cursor: pointer; }
    .settings-actions { display: flex; gap: 1rem; align-items: center; margin: 1.5rem 0 3rem; }
    .settings-errors { color: var(--destructive); margin: 0; padding-left: 1.25rem; }
    .settings-saved { color: var(--primary); }
    .file-note { color: var(--muted-foreground); font-size: 0.875rem; }
    .file-note code { color: var(--foreground); overflow-wrap: anywhere; }
    .roles-toolbar { display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end; justify-content: space-between; margin: 1rem 0; }
    .roles-toolbar label { display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.875rem; color: var(--muted-foreground); }
    .roles-toolbar select { min-width: 12rem; }
    .btn-secondary { background-color: var(--secondary); color: var(--foreground); border: 1px solid var(--border); }
    .desc { display: block; color: var(--muted-foreground); font-size: 0.8rem; }
    .role-meta { display: block; margin-top: 0.3rem; color: var(--muted-foreground); font-size: 0.75rem; font-weight: 400; }
    .role-meta code { color: var(--foreground); }
    .new-badge { color: var(--primary); }

    /* Wide screens: one column per role */
    .roles-table-wrap { overflow-x: auto; background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-md); }
    .role-editor { width: 100%; border-collapse: collapse; }
    .role-editor th, .role-editor td { padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--border); text-align: center; vertical-align: middle; }
    .role-editor thead th { vertical-align: top; min-width: 9.5rem; }
    .role-editor th:first-child, .role-editor td:first-child {
      position: sticky; left: 0; z-index: 1; min-width: 15rem; max-width: 20rem; text-align: left; background: var(--card);
    }
    .role-editor .section-row th { text-align: left; background: var(--secondary); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; }
    .role-editor .role-label { padding: 0.4rem 0.5rem; font-size: 0.9rem; font-weight: 600; }
    .role-editor .role-actions { margin-top: 0.4rem; }
    .role-editor input[type="checkbox"] { width: 1.2rem; height: 1.2rem; accent-color: var(--primary); cursor: pointer; }
    .limit-control { display: inline-flex; flex-direction: column; align-items: center; gap: 0.3rem; }
    .limit-control input[type="number"] { width: 7rem; padding: 0.4rem 0.5rem; font-size: 0.9rem; }
    .limit-control input[type="number"]:disabled { opacity: 0.4; }
    .limit-control label { display: inline-flex; gap: 0.35rem; align-items: center; color: var(--muted-foreground); font-size: 0.75rem; cursor: pointer; }
    .limit-control label input { width: 1rem !important; height: 1rem !important; }

    /* Phones: pick a role, edit it as a card */
    .role-picker { display: flex; gap: 0.75rem; align-items: center; margin-bottom: 1rem; color: var(--muted-foreground); font-size: 0.875rem; }
    .role-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1rem; }
    .role-card h4 { margin: 1.25rem 0 0.25rem; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted-foreground); }
    .role-card-head { display: flex; flex-direction: column; gap: 0.5rem; }
    .role-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.75rem; align-items: center; padding: 0.7rem 0; border-bottom: 1px solid var(--border); }
    .role-row:last-child { border-bottom: none; }
    .role-row .limit-control { align-items: flex-end; }
    .switch { appearance: none; -webkit-appearance: none; flex-shrink: 0; width: 2.6rem; height: 1.5rem; border-radius: var(--radius-full);
      background: var(--muted); position: relative; cursor: pointer; transition: background-color 0.15s; margin: 0; }
    .switch::after { content: ''; position: absolute; top: 0.2rem; left: 0.2rem; width: 1.1rem; height: 1.1rem; border-radius: 50%;
      background: var(--foreground); transition: transform 0.15s; }
    .switch:checked { background: var(--primary); }
    .switch:checked::after { transform: translateX(1.1rem); background: var(--primary-foreground); }
    .switch:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }

    .radio-option { display: flex; gap: 0.6rem; align-items: flex-start; margin: 0.75rem 0; cursor: pointer; }
    .radio-option input { margin-top: 0.3rem; accent-color: var(--primary); }
    .radio-option select { margin-top: 0.5rem; }
    .field-hint { color: var(--muted-foreground); font-size: 0.8rem; margin-top: 0.3rem; }

    @media (max-width: 640px) {
      .setting-row { grid-template-columns: 1fr; }
      .setting-control { justify-self: start; }
      .roles-toolbar { align-items: stretch; flex-direction: column; }
      .roles-toolbar .btn { width: 100%; }
    }
  </style>
</head>
<body>
  <%- include('partials/header', { currentPage: 'admin-settings' }) %>

  <%
    const SECTION_TITLES = {
      registration: 'Registration', geo: 'Geolocation', features: 'Features', moderation: 'Moderation',
      anonymous: 'Anonymous visitors', pastes: 'Pastes', files: 'Files', retention: 'Retention'
    };
    // Everything the roles editor (public/js/rolesEditor.js) starts from
    const rolesData = {
      version: roleGrid.version,
      defaultRole: roleGrid.defaultRole,
      permissions: roleGrid.permissions.map(({ name, description }) => ({ name, description })),
      limits: roleGrid.limits.map(({ name, description }) => ({ name, description })),
      roles: roleGrid.roles.map((role, i) => ({
        ...role,
        permissions: Object.fromEntries(roleGrid.permissions.map(p => [p.name, p.values[i]])),
        limits: Object.fromEntries(roleGrid.limits.map(l => [l.name, l.values[i]]))
      }))
    };
  %>

  <main class="main-content-wide">
    <div class="header-section">
      <div>
        <h2>Settings</h2>
        <p class="file-note">
          Saved to <code><%= files.settings %></code>. Editing that file by hand works too; changes apply within a few seconds.
        </p>
      </div>
    </div>

    <form id="settingsForm" onsubmit="saveSettings(event)">
      <% sections.forEach(section => { %>
        <section class="settings-section">
          <h3><%= SECTION_TITLES[section.name] || section.name %></h3>
          <% section.fields.forEach(field => { %>
            <div class="setting-row">
              <label for="<%= field.key %>">
                <code><%= field.key %></code>
                <p><%= field.description %></p>
              </label>
              <div class="setting-control">
                <% if (field.type === 'boolean') { %>
                  <input type="checkbox" id="<%= field.key %>" data-key="<%= field.key %>" data-type="boolean" <%= field.value ? 'checked' : '' %>>
                <% } else { %>
                  <input type="number" class="form-input" id="<%= field.key %>" data-key="<%= field.key %>" data-type="integer"
                    data-nullable="<%= field.nullable %>" min="<%= field.min %>" step="1"
                    value="<%= field.value === null ? '' : field.value %>"
                    <%= field.nullable ? 'placeholder=No cap' : 'required' %>>
                <% } %>
              </div>
            </div>
          <% }) %>
        </section>
      <% }) %>

      <div class="settings-actions">
        <button type="submit" class="btn" id="saveSettingsBtn" style="color: var(--primary-foreground);">Save settings</button>
        <span id="settingsStatus" class="settings-saved" role="status"></span>
      </div>
      <ul id="settingsErrors" class="settings-errors" role="alert"></ul>
    </form>

    <section class="settings-section" id="roles">
      <h3>Roles</h3>
      <p class="file-note">
        Saved to <code><%= files.roles %></code>. Editing that file by hand works too; changes apply within a few seconds.
        If the file changes while this page is open, reload this page before saving here.
        Admins always have every permission and no limits. A limit left empty with <em>Unlimited</em> ticked has no cap; 0 allows none.
      </p>

      <div class="roles-toolbar">
        <label for="defaultRole">
          Default role (accounts without a role)
          <select id="defaultRole" class="form-input"></select>
        </label>
        <button type="button" class="btn btn-small btn-secondary" id="addRoleBtn">Add role</button>
      </div>

      <div id="rolesEditor"></div>

      <div class="settings-actions">
        <button type="button" class="btn" id="saveRolesBtn" style="color: var(--primary-foreground);">Save roles</button>
        <span id="rolesStatus" class="settings-saved" role="status"></span>
      </div>
      <ul id="rolesErrors" class="settings-errors" role="alert"></ul>
    </section>
  </main>

  <div id="addRoleModal" class="modal-overlay">
    <div class="modal">
      <div class="modal-header">
        <h3>Add role</h3>
        <button type="button" class="modal-close" onclick="closeModal('addRoleModal')" aria-label="Close">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <form class="modal-body" id="addRoleForm">
        <div class="form-group">
          <label for="newRoleLabel" class="form-label">Name</label>
          <input type="text" id="newRoleLabel" class="form-input" maxlength="60" required>
        </div>
        <div class="form-group">
          <label for="newRoleKey" class="form-label">Key</label>
          <input type="text" id="newRoleKey" class="form-input" maxlength="32" required>
          <p class="field-hint">Stored on each account and in roles.json. Lowercase letters, digits and dashes; it can't be changed later.</p>
        </div>
        <p class="field-hint">The new role starts with the same permissions and limits as <span id="newRoleBase"></span>. It's created when you save the roles.</p>
        <ul id="addRoleErrors" class="settings-errors" role="alert"></ul>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" onclick="closeModal('addRoleModal')">Cancel</button>
          <button type="submit" class="btn" style="color: var(--primary-foreground);">Add</button>
        </div>
      </form>
    </div>
  </div>

  <div id="deleteRoleModal" class="modal-overlay">
    <div class="modal">
      <div class="modal-header">
        <h3>Delete <span id="deleteRoleName"></span></h3>
        <button type="button" class="modal-close" onclick="closeModal('deleteRoleModal')" aria-label="Close">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <form class="modal-body" id="deleteRoleForm">
        <p id="deleteRoleCount"></p>
        <label class="radio-option">
          <input type="radio" name="deleteRoleTarget" value="move" checked>
          <span>
            Move them to
            <select id="deleteRoleMoveTo" class="form-input" aria-label="Role to move the accounts to"></select>
          </span>
        </label>
        <label class="radio-option">
          <input type="radio" name="deleteRoleTarget" value="default">
          <span>
            Back to the default role
            <span class="desc">Their role is cleared, so they follow whichever role is the default, now and later.</span>
          </span>
        </label>
        <ul id="deleteRoleErrors" class="settings-errors" role="alert"></ul>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" onclick="closeModal('deleteRoleModal')">Cancel</button>
          <button type="submit" class="btn btn-danger">Delete role</button>
        </div>
      </form>
    </div>
  </div>

  <script type="application/json" id="rolesData"><%- JSON.stringify(rolesData).replace(/</g, '\\u003c') %></script>
  <script src="/js/main.js"></script>
  <script src="/js/rolesEditor.js"></script>
  <script>
    function readForm() {
      const values = {};
      document.querySelectorAll('#settingsForm [data-key]').forEach(input => {
        const key = input.dataset.key;
        if (input.dataset.type === 'boolean') {
          values[key] = input.checked;
        } else if (input.value.trim() === '' && input.dataset.nullable === 'true') {
          values[key] = null;
        } else {
          values[key] = Number(input.value);
        }
      });
      return values;
    }

    async function saveSettings(event) {
      event.preventDefault();
      const button = document.getElementById('saveSettingsBtn');
      const status = document.getElementById('settingsStatus');
      const errors = document.getElementById('settingsErrors');
      status.textContent = '';
      errors.innerHTML = '';
      button.disabled = true;

      try {
        const response = await fetch('/api/admin/settings', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(readForm())
        });
        const data = await response.json();

        if (data.success) {
          const count = Object.keys(data.changed).length;
          status.textContent = count ? `Saved ${count} change${count === 1 ? '' : 's'}.` : 'No changes.';
        } else {
          (data.errors || ['Could not save settings.']).forEach(message => {
            const li = document.createElement('li');
            li.textContent = message;
            errors.appendChild(li);
          });
        }
      } catch (e) {
        const li = document.createElement('li');
        li.textContent = 'Request failed. Please try again.';
        errors.appendChild(li);
      } finally {
        button.disabled = false;
      }
    }
  </script>
  <%- include('partials/footer') %>
</body>
</html>
