<%
  // Callers pass { title, message, code }; tolerate { statusCode } and { error: { status } } too.
  const code = locals.code || locals.statusCode || (locals.error && locals.error.status) || 500;
  const DEFAULT_TITLES = { 403: 'Access Denied', 404: 'Not Found', 410: 'Gone', 429: 'Too Many Requests' };
  const title = locals.title || DEFAULT_TITLES[code] || 'Something Went Wrong';
  const message = locals.message || '';
  const ICONS = { 403: 'lock', 404: 'search', 410: 'clock', 429: 'clock' };
-%>
<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: title, styles: ['public-pages'] }) %>
</head>
<%- include('partials/layout-start', { shell: 'standalone', pageClass: 'page-center' }) %>
  <main class="status-card<%= code >= 500 ? ' danger' : '' %>">
    <span class="status-icon"><%- include('partials/icon', { icon: ICONS[code] || 'info' }) %></span>
    <span class="status-code">Error <%= code %></span>
    <h1><%= title %></h1>
    <% if (message) { %><p><%= message %></p><% } %>
    <div class="status-actions">
      <a href="/" class="btn">Go to the home page</a>
    </div>
  </main>
<%- include('partials/layout-end', { shell: 'standalone' }) %>
</html>
