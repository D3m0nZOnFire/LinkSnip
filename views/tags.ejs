<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Tags', styles: ['forms', 'modals', 'sections', 'tags'] }) %>
</head>
<%- include('partials/layout-start', { shell: 'app', currentPage: 'tags' }) %>
<%
  const uses = tags.reduce((sum, t) => sum + t.itemCount, 0);
  const visits = tags.reduce((sum, t) => sum + t.visits, 0);
  const plural = (n, word) => `${n.toLocaleString('en-US')} ${word}${n === 1 ? '' : 's'}`;
  const day = (value) => new Date(String(value).includes('T') ? value : `${String(value).replace(' ', 'T')}Z`)
    .toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
-%>
  <main class="main-content-wide page-medium">
    <div class="header-section">
      <div>
        <h2>Tags</h2>
        <p class="header-stats"><%= tags.length ? `${plural(tags.length, 'tag')} · ${plural(uses, 'use')} · ${plural(visits, 'visit')}` : 'Group links, bundles, pastes and files by campaign, platform or project' %></p>
      </div>
    </div>

    <% if (tags.length === 0) { %>
      <div class="section-card tags-empty">
        <h3>No tags yet</h3>
        <p class="section-help">A tag is made the first time you add it to something.</p>
        <ul class="tags-howto">
          <li>Add tags when you create or edit an item, e.g. <code>newsletter</code> or <code>launch</code>.</li>
          <li>Filter your dashboard by a tag.</li>
          <li>See the visits of everything with a tag together.</li>
        </ul>
        <a href="/" class="btn btn-small"><%- include('partials/icon', { icon: 'plus' }) %> Create something</a>
      </div>
    <% } else { %>
      <div class="section-card tags-card">
        <div class="table-scroll">
          <table class="section-table">
            <thead>
              <tr><th>Tag</th><th class="num">Items</th><th class="num">Visits</th><th>Created</th><th class="actions-cell"><span class="visually-hidden">Actions</span></th></tr>
            </thead>
            <tbody>
              <% tags.forEach(tag => {
                   const breakdown = Object.entries(tag.counts).filter(([, n]) => n > 0)
                     .map(([type, n]) => `${n} ${typeNouns[type]}${n === 1 ? '' : 's'}`).join(', ');
              %>
              <tr data-tag-id="<%= tag.id %>" data-tag-name="<%= tag.name %>" data-tag-color="<%= tag.color %>">
                <td><%- include('partials/tag-chips', { tags: [tag] }) %></td>
                <td class="num" title="<%= breakdown %>"><%= tag.itemCount %></td>
                <td class="num"><%= tag.visits.toLocaleString('en-US') %></td>
                <td class="muted"><%= day(tag.createdAt) %></td>
                <td class="actions-cell">
                  <a href="/tags/<%= tag.id %>/analytics" class="icon-btn" title="Analytics" aria-label="Analytics for <%= tag.name %>"><%- include('partials/icon', { icon: 'chart' }) %></a>
                  <button type="button" class="icon-btn" data-action="edit" title="Edit" aria-label="Edit <%= tag.name %>"><%- include('partials/icon', { icon: 'edit' }) %></button>
                  <button type="button" class="icon-btn danger" data-action="delete" title="Delete" aria-label="Delete <%= tag.name %>"><%- include('partials/icon', { icon: 'trash' }) %></button>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </main>

  <!-- Edit a tag -->
  <div id="editTagModal" class="modal-overlay">
    <div class="modal modal-narrow" role="dialog" aria-modal="true" aria-labelledby="editTagTitle">
      <div class="modal-header">
        <h3 id="editTagTitle">Edit tag</h3>
        <button type="button" class="modal-close" data-close-modal="editTagModal" aria-label="Close"><%- include('partials/icon', { icon: 'close' }) %></button>
      </div>
      <form class="modal-body" id="editTagForm" novalidate>
        <div class="form-group">
          <label for="editTagName" class="form-label">Name</label>
          <input type="text" id="editTagName" class="form-input" maxlength="50" required>
        </div>
        <div class="form-group">
          <label for="editTagColorHex" class="form-label">Color</label>
          <div class="color-row">
            <div class="color-picker-wrapper"><input type="color" id="editTagColor" class="color-picker-input" aria-label="Pick a color"></div>
            <input type="text" id="editTagColorHex" class="form-input" placeholder="#34d399" pattern="^#[0-9A-Fa-f]{6}$">
          </div>
        </div>
      </form>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-close-modal="editTagModal">Cancel</button>
        <button type="submit" class="btn" form="editTagForm" id="saveTagBtn">Save</button>
      </div>
    </div>
  </div>

  <!-- Confirm (confirmAction in main.js) -->
  <div id="confirmModal" class="modal-overlay">
    <div class="modal modal-narrow" role="alertdialog" aria-modal="true" aria-labelledby="confirmModalTitle">
      <div class="modal-header"><h3 id="confirmModalTitle">Confirm</h3></div>
      <div class="modal-body"><p id="confirmModalMessage"></p></div>
      <div class="modal-footer">
        <button type="button" id="confirmModalCancelBtn" class="btn btn-secondary">Cancel</button>
        <button type="button" id="confirmModalConfirmBtn" class="btn btn-danger">Delete</button>
      </div>
    </div>
  </div>

  <script src="/js/main.js"></script>
  <script src="/js/tags.js"></script>
<%- include('partials/layout-end', { shell: 'app' }) %>
</html>
