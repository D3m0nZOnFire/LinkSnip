<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Log in', styles: ['forms', 'auth'] }) %>
</head>
<%- include('partials/layout-start', { shell: 'standalone', pageClass: 'page-center' }) %>
  <main class="auth-card">
    <div class="auth-brand"><%- include('partials/brand', { large: true }) %></div>
    <div class="auth-heading">
      <h1>Log in</h1>
      <p>to <%= branding.name %></p>
    </div>
    <form class="auth-form" action="/login" method="POST">
      <% if (error) { %><div class="auth-error" role="alert"><%= error %></div><% } %>
      <% if (locals.next) { %><input type="hidden" name="next" value="<%= next %>"><% } %>
      <div class="form-group">
        <label for="username" class="form-label">Username</label>
        <input type="text" id="username" name="username" class="form-input" value="<%= username %>" autocomplete="username" required<%= error ? '' : ' autofocus' %>>
      </div>
      <div class="form-group">
        <label for="password" class="form-label">Password</label>
        <input type="password" id="password" name="password" class="form-input" autocomplete="current-password" required data-toggle-password<%= error ? ' autofocus' : '' %>>
      </div>
      <button type="submit" class="btn">Log in</button>
    </form>
    <div class="auth-links">
      <% if (locals.registrationOpen !== false) { %><p>No account yet? <a href="/register">Register</a></p><% } %>
      <a href="/">Back to the home page</a>
    </div>
  </main>
  <script src="/js/main.js"></script>
<%- include('partials/layout-end', { shell: 'standalone' }) %>
</html>
