<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: `Reported ${kind}`, styles: ['public-pages'], noindex: true }) %>
</head>
<%- include('partials/layout-start', { shell: 'standalone', pageClass: 'page-center' }) %>
<% const LABELS = { link: 'Goes to', bundle: 'Bundle', paste: 'Paste', file: 'File' }; -%>
  <main class="status-card warning">
    <span class="status-icon"><%- include('partials/icon', { icon: 'flag' }) %></span>
    <h1>This <%= kind %> was reported</h1>
    <p>Several visitors reported it as unsafe or abusive, and an administrator hasn't looked at it yet. Only continue if you trust where it leads.</p>
    <div class="status-detail">
      <span class="destination-label"><%= LABELS[kind] || 'Goes to' %></span>
      <%= destination || '(untitled)' %>
    </div>
    <div class="status-actions">
      <a href="/" class="btn">Take me back</a>
      <a href="<%= continueUrl %>" class="btn btn-secondary" rel="nofollow">Continue anyway</a>
    </div>
    <% if (infoUrl) { %><a class="status-link" href="<%= infoUrl %>">More about this <%= kind %></a><% } %>
  </main>
<%- include('partials/layout-end', { shell: 'standalone' }) %>
</html>
