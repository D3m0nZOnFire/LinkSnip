<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: `Reported ${kind}`, noindex: true }) %>
  <style>
    .quarantine-destination {
      margin: 1rem 0 1.5rem;
      padding: 0.75rem 1rem;
      background: var(--secondary);
      border: 1px solid var(--border);
      border-radius: 6px;
      word-break: break-all;
      font-family: var(--font-mono);
      font-size: 0.875rem;
      text-align: left;
    }
    .quarantine-actions { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
  </style>
</head>
<body>
  <div class="page page-center">
  <div class="error-container">
    <div class="error-box">
      <div class="error-code">
        <h1 style="color: var(--destructive)" aria-hidden="true">⚠</h1>
      </div>

      <h2>This <%= kind %> has been reported</h2>
      <p>
        Several visitors reported this <%= kind %> as unsafe or abusive, and an administrator hasn't reviewed it yet.
        Only continue if you trust where it leads.
      </p>

      <div class="quarantine-destination">
        <%= { link: 'Destination', bundle: 'Bundle', paste: 'Paste', file: 'File' }[kind] || 'Destination' %>: <%= destination || '(untitled)' %>
      </div>

      <div class="quarantine-actions">
        <a href="/" class="btn" style="color: var(--primary-foreground);">Take me back</a>
        <a href="<%= continueUrl %>" class="btn" style="background: var(--secondary); color: var(--foreground);" rel="nofollow">Continue anyway</a>
      </div>
      <% if (infoUrl) { %>
        <p style="margin-top: 1.5rem; font-size: 0.875rem;"><a href="<%= infoUrl %>">More about this <%= kind %></a></p>
      <% } %>
    </div>
  </div>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
