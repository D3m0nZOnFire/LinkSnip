<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: `${team.name} · Teams`, styles: ['forms', 'modals', 'sections', 'teams'] }) %>
</head>
<%- include('partials/layout-start', { shell: 'app', currentPage: 'teams' }) %>

  <%
    const isManager = myRole === 'owner' || myRole === 'admin';
    const manages = (role) => myRole === 'owner' || (myRole === 'admin' && (role === 'member' || role === 'viewer'));
    const giveable = myRole === 'owner' ? roles : roles.filter(r => r !== 'owner');
    const inviteRoles = giveable.filter(r => r !== 'owner');
    const isMember = members.some(m => m.userId === user.id);
    const label = (role) => role.charAt(0).toUpperCase() + role.slice(1);
    const NOUNS = { url: 'link', bundle: 'bundle', paste: 'paste', file: 'file' };
    const countText = Object.entries(counts).filter(([, n]) => n > 0)
      .map(([type, n]) => `${n} ${NOUNS[type]}${n === 1 ? '' : 's'}`).join(' · ') || 'No items yet';
  %>

  <main class="main-content-wide page-medium" id="teamPage" data-team-id="<%= team.id %>" data-team-name="<%= team.name %>">
    <div class="header-section">
      <div>
        <h2 class="page-title"><%= team.name %></h2>
        <p><%= isMember ? `You are ${/^[aeiou]/.test(myRole) ? 'an' : 'a'} ${myRole}` : 'You see this team as a site admin' %> · <%= countText %></p>
      </div>
      <div class="header-actions">
        <a href="/teams" class="btn btn-secondary"><%- include('partials/icon', { icon: 'arrowLeft' }) %> All teams</a>
        <a href="/dashboard?team=<%= team.id %>" class="btn"><%- include('partials/icon', { icon: 'dashboard' }) %> Open items</a>
      </div>
    </div>

    <section class="section-card">
      <h3>Members</h3>
      <p class="section-help"><%= members.length %> member<%= members.length === 1 ? '' : 's' %>. Owners manage everyone; admins manage members and viewers.</p>
      <div class="table-scroll">
        <table class="section-table">
          <thead><tr><th>Name</th><th>Role</th><th>Joined</th><% if (isManager) { %><th></th><% } %></tr></thead>
          <tbody>
            <% members.forEach(member => { %>
              <tr>
                <td class="name-cell"><%= member.username %><% if (member.userId === user.id) { %> <span class="you">(you)</span><% } %></td>
                <td>
                  <% if (isManager && manages(member.role)) { %>
                    <select class="form-input member-role-select" data-member-id="<%= member.userId %>" aria-label="Role of <%= member.username %>">
                      <% giveable.forEach(role => { %>
                        <option value="<%= role %>" <%= role === member.role ? 'selected' : '' %>><%= label(role) %></option>
                      <% }) %>
                    </select>
                  <% } else { %>
                    <%= label(member.role) %>
                  <% } %>
                </td>
                <td class="muted"><%= member.joinedAt ? String(member.joinedAt).slice(0, 10) : '' %></td>
                <% if (isManager) { %>
                  <td class="actions-cell">
                    <% if (manages(member.role) && member.userId !== user.id) { %>
                      <button type="button" class="btn btn-small btn-secondary remove-member" data-member-id="<%= member.userId %>" data-username="<%= member.username %>">Remove</button>
                    <% } %>
                  </td>
                <% } %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p id="membersError" class="field-error" role="alert"></p>
    </section>

    <% if (isManager) { %>
      <section class="section-card">
        <h3>Invite someone</h3>
        <p class="section-help">They see the invite on their dashboard and choose to join.</p>
        <form id="inviteForm" class="inline-form">
          <div class="form-group">
            <label for="inviteUsername" class="form-label">Username</label>
            <input type="text" id="inviteUsername" class="form-input" autocomplete="off" required>
          </div>
          <div class="form-group narrow">
            <label for="inviteRole" class="form-label">Role</label>
            <select id="inviteRole" class="form-input">
              <% inviteRoles.forEach(role => { %>
                <option value="<%= role %>" <%= role === 'member' ? 'selected' : '' %>><%= label(role) %></option>
              <% }) %>
            </select>
          </div>
          <button type="submit" class="btn">Invite</button>
        </form>
        <p id="inviteError" class="field-error" role="alert"></p>

        <% if (invites.length) { %>
          <h4>Pending invites</h4>
          <div class="table-scroll">
            <table class="section-table">
              <thead><tr><th>Name</th><th>Role</th><th>Invited by</th><th></th></tr></thead>
              <tbody>
                <% invites.forEach(invite => { %>
                  <tr>
                    <td><%= invite.username %></td>
                    <td><%= label(invite.role) %></td>
                    <td><%= invite.invitedBy || '' %></td>
                    <td class="actions-cell"><button type="button" class="btn btn-small btn-secondary revoke-invite" data-invite-id="<%= invite.id %>">Revoke</button></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>

      <section class="section-card">
        <h3>Name</h3>
        <form id="renameForm" class="inline-form">
          <div class="form-group">
            <label for="renameInput" class="form-label">Team name</label>
            <input type="text" id="renameInput" class="form-input" maxlength="60" value="<%= team.name %>" required>
          </div>
          <button type="submit" class="btn btn-secondary">Rename</button>
        </form>
        <p id="renameError" class="field-error" role="alert"></p>
      </section>
    <% } %>

    <% if (isMember) { %>
      <section class="section-card">
        <h3>Leave</h3>
        <p class="section-help">The items you created stay in the team.</p>
        <button type="button" class="btn btn-secondary" id="leaveTeamBtn">Leave team</button>
        <p id="leaveError" class="field-error" role="alert"></p>
      </section>
    <% } %>

    <% if (myRole === 'owner') { %>
      <section class="section-card danger">
        <h3>Delete team</h3>
        <p class="section-help">Deletes the team and everything in it: its links, bundles, pastes and files, with their analytics. This can't be undone.</p>
        <button type="button" class="btn btn-danger" id="deleteTeamBtn">Delete team</button>
      </section>
    <% } %>
  </main>

  <% if (myRole === 'owner') { %>
  <div id="deleteTeamModal" class="modal-overlay">
    <div class="modal modal-narrow" role="dialog" aria-modal="true" aria-labelledby="deleteTeamTitle">
      <div class="modal-header">
        <h3 id="deleteTeamTitle">Delete <%= team.name %></h3>
        <button type="button" class="modal-close" data-close-modal="deleteTeamModal" aria-label="Close"><%- include('partials/icon', { icon: 'close' }) %></button>
      </div>
      <form class="modal-body" id="deleteTeamForm">
        <p>This deletes <strong><%= countText.toLowerCase() %></strong> and the team itself. Type the team name to confirm.</p>
        <div class="form-group">
          <label for="confirmTeamName" class="form-label">Team name</label>
          <input type="text" id="confirmTeamName" class="form-input" autocomplete="off" required>
        </div>
        <p id="deleteError" class="field-error" role="alert"></p>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-close-modal="deleteTeamModal">Cancel</button>
          <button type="submit" class="btn btn-danger" id="confirmDeleteBtn" disabled>Delete team</button>
        </div>
      </form>
    </div>
  </div>
  <% } %>

  <script src="/js/main.js"></script>
  <script src="/js/team.js"></script>
<%- include('partials/layout-end', { shell: 'app' }) %>
</html>
