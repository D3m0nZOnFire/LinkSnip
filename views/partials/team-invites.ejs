<% const pendingInvites = locals.teamInvites || []; %>
<% if (pendingInvites.length) { %>
<section class="team-invites" aria-label="Team invites">
  <% pendingInvites.forEach(invite => { %>
    <div class="team-invite">
      <span>
        <strong><%= invite.invitedBy || 'Someone' %></strong> invited you to the team <strong><%= invite.teamName %></strong> as <%= invite.role %>.
      </span>
      <span class="team-invite-actions">
        <button type="button" class="btn btn-small" data-invite-id="<%= invite.id %>" data-action="accept">Accept</button>
        <button type="button" class="btn btn-small btn-secondary" data-invite-id="<%= invite.id %>" data-action="decline">Decline</button>
      </span>
    </div>
  <% }) %>
</section>
<script src="/js/team-invites.js"></script>
<% } %>
