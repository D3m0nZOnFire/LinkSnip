<%#
  Charts and tables of one item's analytics, the same for every type.
  Takes { summary, eventLabel, itemClicks }: summary from AnalyticsEvent.getSummary,
  eventLabel ('Clicks', 'Opens', 'Views', 'Downloads'), itemClicks for bundles (else null).
  The page loads /vendor/chart.umd.js and /js/analytics.js, which draws the charts from #analyticsData.
%>
<%
  // JSON for a <script> block: "<" escaped so no value can close the tag
  const json = (value) => JSON.stringify(value).replace(/</g, '\\u003c');
  const number = (n) => Number(n || 0).toLocaleString('en-US');
  const label = eventLabel.toLowerCase();
-%>
<script type="application/json" id="analyticsData"><%- json({ eventLabel, byDate: summary.byDate, devices: summary.devices, browsers: summary.browsers }) %></script>

<div class="stat-grid">
  <div class="stat-card"><span class="stat-label"><%= eventLabel %></span><span class="stat-value"><%= number(summary.total) %></span></div>
  <div class="stat-card"><span class="stat-label">Unique visitors</span><span class="stat-value"><%= number(summary.uniqueVisitors) %></span></div>
  <div class="stat-card"><span class="stat-label">Referrers</span><span class="stat-value"><%= number(summary.referrers.length) %></span></div>
  <div class="stat-card"><span class="stat-label">Countries</span><span class="stat-value"><%= number(summary.countries.length) %></span></div>
</div>

<section class="section-card">
  <div class="section-head"><h3><%= eventLabel %> over time</h3><span class="muted"><%= summary.byDatePeriod %></span></div>
  <div class="chart-box chart-box-tall"><canvas id="eventsChart" role="img" aria-label="<%= eventLabel %> per day"></canvas></div>
</section>

<% if (itemClicks) { %>
<section class="section-card">
  <h3>Clicks per link</h3>
  <% if (itemClicks.length === 0) { %>
    <p class="section-help">This bundle has no links.</p>
  <% } else { %>
    <div class="table-scroll">
      <table class="section-table">
        <thead><tr><th>Link</th><th class="num">Clicks</th></tr></thead>
        <tbody>
          <% itemClicks.forEach(item => { %>
            <tr>
              <td class="wrap-cell"><% if (item.label) { %><strong><%= item.label %></strong><br><% } %><span class="muted"><%= item.url %></span></td>
              <td class="num"><%= number(item.clickCount) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
<% } %>

<div class="analytics-two">
  <% [['Devices', 'devicesChart', summary.devices], ['Browsers', 'browsersChart', summary.browsers]].forEach(([title, id, rows]) => { %>
  <section class="section-card">
    <h3><%= title %></h3>
    <% if (rows.length > 0) { %>
      <div class="chart-box"><canvas id="<%= id %>" role="img" aria-label="<%= title %>"></canvas></div>
    <% } else { %>
      <p class="section-help">No data yet</p>
    <% } %>
  </section>
  <% }); %>
</div>

<div class="analytics-two">
  <% [['Referrers', 'Referrer', summary.referrers, 'referrer'], ['Countries', 'Country', summary.countries, 'country']].forEach(([title, column, rows, key]) => { %>
  <section class="section-card">
    <h3><%= title %></h3>
    <% if (rows.length === 0) { %>
      <p class="section-help">No data yet</p>
    <% } else { %>
      <div class="table-scroll">
        <table class="section-table">
          <thead><tr><th><%= column %></th><th class="num"><%= eventLabel %></th></tr></thead>
          <tbody>
            <% rows.forEach(row => { %>
              <tr><td class="wrap-cell"><%= row[key] || 'Unknown' %></td><td class="num"><%= number(row.count) %></td></tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
    <% if (key === 'country') { %>
      <p class="credit"><a href="https://db-ip.com" target="_blank" rel="noopener">IP Geolocation by DB-IP</a></p>
    <% } %>
  </section>
  <% }); %>
</div>

<% if (summary.os.length > 0) { %>
<section class="section-card">
  <h3>Operating systems</h3>
  <div class="table-scroll">
    <table class="section-table">
      <thead><tr><th>System</th><th class="num"><%= eventLabel %></th></tr></thead>
      <tbody>
        <% summary.os.forEach(row => { %>
          <tr><td><%= row.os || 'Unknown' %></td><td class="num"><%= number(row.count) %></td></tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</section>
<% } %>
