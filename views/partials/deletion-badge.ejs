<%# "Deletes in Nd" for an expired item. Takes { days, noun }: a row's deletesInDays (services/retentionService.js). %>
<% if (days !== null && days !== undefined) { %>
  <span class="badge badge-muted" title="This expired <%= noun %> will be deleted automatically in <%= days %> day<%= days === 1 ? '' : 's' %>">Deletes in <%= days %>d</span>
<% } %>
