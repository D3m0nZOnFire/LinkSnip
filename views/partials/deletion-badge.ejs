<%# "Deletes in Nd" for an expired item. Takes { days, noun }: a row's deletesInDays (services/retentionService.js). %>
<% if (days !== null && days !== undefined) { %>
  <div style="flex-shrink: 0;" title="This expired <%= noun %> will be automatically deleted in <%= days %> day<%= days === 1 ? '' : 's' %>">
    <span class="badge" style="background-color: rgba(251, 191, 36, 0.1); color: #fbbf24; border: 1px solid rgba(251, 191, 36, 0.3);">⚠️ Deletes in <%= days %>d</span>
  </div>
<% } %>
