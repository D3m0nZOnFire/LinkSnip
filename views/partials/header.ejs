<%# Header of the public pages (layout-start, shell 'public'): the brand, theme, and log in / the user's menu %>
<% const user = locals.user || null; %>
<header class="site-header">
  <div class="site-header-inner">
    <%- include('brand', { large: false }) %>
    <div class="site-header-actions">
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Switch theme"><span data-theme-icon></span></button>
      <% if (user) { %>
        <a href="/dashboard" class="btn btn-small btn-secondary">Dashboard</a>
        <%- include('user-menu', { place: 'header' }) %>
      <% } else { %>
        <a href="/login" class="btn btn-small btn-ghost">Log in</a>
        <% if (locals.registrationOpen !== false) { %>
        <a href="/register" class="btn btn-small">Register</a>
        <% } %>
      <% } %>
    </div>
  </div>
</header>
<script src="/js/shell.js" defer></script>
