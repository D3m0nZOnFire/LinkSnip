<!-- Header Navigation -->
<header class="header">
  <div class="header-content">
    <div class="logo-container">
      <a href="/" style="display: flex; align-items: center; gap: 0.5rem; text-decoration: none;">
        <div class="logo">
          <img src="/logo.png" alt="LinkSnip Logo" style="width: 100%; height: 100%; object-fit: contain;">
        </div>
        <h1 class="logo-text">LinkSnip</h1>
      </a>
      <% if (user && user.isAdmin) { %>
        <div class="badge admin-badge" style="margin-left: 0.5rem;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
          <span>Admin</span>
        </div>
      <% } %>
    </div>

    <!-- Theme toggle button -->
    <button id="theme-toggle" class="icon-btn" aria-label="Toggle theme" title="Toggle theme" style="margin-left: auto; margin-right: 1rem;">
      <!-- Icon will be injected by theme.js -->
    </button>

    <nav class="nav">
      <% const can = locals.can || {}; const features = locals.features || {}; %>
      <% if (user) { %>
        <!-- Logged-in user navigation -->
        <a href="/" class="<%= currentPage === 'home' ? 'active' : '' %>">Home</a>
        <a href="/dashboard" class="<%= currentPage === 'dashboard' ? 'active' : '' %>">Dashboard</a>
        <% if (can.tags) { %>
        <a href="/tags" class="<%= currentPage === 'tags' ? 'active' : '' %>">Tags</a>
        <% } %>

        <% if (user.isAdmin) { %>
          <!-- Admin dropdown menu -->
          <div class="nav-dropdown">
            <button class="nav-dropdown-toggle <%= currentPage && currentPage.startsWith('admin') ? 'active' : '' %>">
              Admin
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px; margin-left: 4px;">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>
            <div class="nav-dropdown-menu">
              <a href="/admin" class="<%= currentPage === 'admin' ? 'active' : '' %>">URLs</a>
              <a href="/admin/users" class="<%= currentPage === 'admin-users' ? 'active' : '' %>">Users</a>
              <a href="/admin/analytics" class="<%= currentPage === 'admin-analytics' ? 'active' : '' %>">Analytics</a>
              <% if (features.analyticsShareLinks) { %><a href="/admin/analytics-shares" class="<%= currentPage === 'admin-analytics-shares' ? 'active' : '' %>">Analytics Shares</a><% } %>
              <% if (features.files) { %><a href="/admin/files" class="<%= currentPage === 'admin-files' ? 'active' : '' %>">Files</a><% } %>
              <% if (features.pastes) { %><a href="/admin/pastes" class="<%= currentPage === 'admin-pastes' ? 'active' : '' %>">Pastes</a><% } %>
              <% if (features.reports) { %><a href="/admin/reports" class="<%= currentPage === 'admin-reports' ? 'active' : '' %>">Reports</a><% } %>
              <a href="/admin/audit-logs" class="<%= currentPage === 'admin-audit-logs' ? 'active' : '' %>">Audit Logs</a>
              <a href="/admin/settings" class="<%= currentPage === 'admin-settings' ? 'active' : '' %>">Settings</a>
            </div>
          </div>
        <% } %>

        <% if (can.bioPage) { %>
        <a href="/bio/settings" class="<%= currentPage === 'bio-settings' ? 'active' : '' %>">Bio Page</a>
        <% } %>
        <% if (can.importExport) { %>
        <a href="/import" class="<%= currentPage === 'import' ? 'active' : '' %>">Import/Export</a>
        <% } %>
        <a href="/settings" class="<%= currentPage === 'settings' ? 'active' : '' %>">Settings</a>
        <a href="/logout">Logout</a>
      <% } else { %>
        <!-- Guest navigation -->
        <a href="/login" class="<%= currentPage === 'login' ? 'active' : '' %>">Login</a>
        <% if (locals.registrationOpen !== false) { %>
        <a href="/register" class="<%= currentPage === 'register' ? 'primary' : '' %>">Register</a>
        <% } %>
      <% } %>
    </nav>
  </div>
</header>


