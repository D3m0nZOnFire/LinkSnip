<%# Navigation of admin mode (layout-start, shell 'admin'). A drawer below 1024px (public/js/shell.js). %>
<%
  const features = locals.features || {};
  const page = locals.currentPage || '';
  const current = (key) => (page === key ? ' aria-current="page"' : '');
  const groups = [
    { heading: null, links: [{ href: '/admin', icon: 'dashboard', label: 'Overview', key: 'admin', show: true }] },
    { heading: 'Content', links: [
      { href: '/admin/items', icon: 'link', label: 'Items', key: 'admin-items', show: true },
      { href: '/admin/reports', icon: 'flag', label: 'Reports', key: 'admin-reports', show: features.reports }
    ] },
    { heading: 'People', links: [
      { href: '/admin/users', icon: 'bio', label: 'Users', key: 'admin-users', show: true },
      { href: '/admin/teams', icon: 'teams', label: 'Teams', key: 'admin-teams', show: features.teams }
    ] },
    { heading: 'Insights', links: [
      { href: '/admin/analytics', icon: 'chart', label: 'Analytics', key: 'admin-analytics', show: true },
      { href: '/admin/analytics-shares', icon: 'share', label: 'Share links', key: 'admin-analytics-shares', show: features.analyticsShareLinks }
    ] },
    { heading: 'System', links: [
      { href: '/admin/settings', icon: 'settings', label: 'Settings', key: 'admin-settings', show: true },
      { href: '/admin/appearance', icon: 'palette', label: 'Appearance', key: 'admin-appearance', show: true },
      { href: '/admin/audit-logs', icon: 'scroll', label: 'Audit log', key: 'admin-audit-logs', show: true }
    ] }
  ];
-%>
<aside class="sidebar sidebar-admin" id="sidebar" aria-label="Admin menu">
  <div class="sidebar-head">
    <%- include('brand', { large: false }) %>
    <button type="button" class="icon-btn sidebar-close" data-sidebar-close aria-label="Close menu"><%- include('icon', { icon: 'close' }) %></button>
  </div>

  <a href="/dashboard" class="sidebar-back"><%- include('icon', { icon: 'arrowLeft' }) %> Back to app</a>

  <nav class="sidebar-nav" aria-label="Admin">
    <% groups.forEach(group => { const links = group.links.filter(l => l.show); if (!links.length) return; %>
      <% if (group.heading) { %><p class="sidebar-heading"><%= group.heading %></p><% } %>
      <% links.forEach(l => { %>
      <a href="<%= l.href %>" class="sidebar-link"<%- current(l.key) %>><%- include('icon', { icon: l.icon }) %> <%= l.label %></a>
      <% }) %>
    <% }) %>
  </nav>

  <div class="sidebar-foot">
    <%- include('user-menu', { place: 'sidebar' }) %>
  </div>
</aside>
<div class="sidebar-backdrop" data-sidebar-close hidden></div>
<script src="/js/shell.js" defer></script>
