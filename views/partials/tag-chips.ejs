<%# An item's tags as colored chips: include('partials/tag-chips', { tags }). The color is the tag's own (a hex). %>
<% if (tags && tags.length > 0) { %>
  <div class="tag-chips">
    <% tags.forEach(tag => { %><span class="tag-chip" style="--tag-color: <%= /^#[0-9a-f]{3,8}$/i.test(tag.color || '') ? tag.color : '#888888' %>"><%= tag.name %></span><% }); %>
  </div>
<% } %>
