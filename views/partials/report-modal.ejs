<%#
  Report box for any content type. Takes { type, id, noun } ('paste', 42, 'paste').
  The page adds its own button with data-report-button (and data-report-label on its text); public/js/report.js
  opens this box from it, and both switch to "Reported" once this visitor reported. Needs /css/modals.css.
%>
<div id="reportModal" class="modal-overlay" data-report-type="<%= type %>" data-report-id="<%= id %>">
  <div class="modal modal-narrow" role="dialog" aria-modal="true" aria-labelledby="reportTitle">
    <div class="modal-header">
      <h3 id="reportTitle">Report this <%= noun %></h3>
      <button type="button" class="modal-close" data-report-close aria-label="Close"><%- include('icon', { icon: 'close' }) %></button>
    </div>
    <form class="modal-body" id="reportForm" novalidate>
      <p class="field-help">Tell the administrators what is wrong with it.</p>
      <p class="field-error" id="reportError" role="alert" hidden></p>
      <p class="report-done" id="reportSuccess" role="status" hidden></p>
      <div class="report-fields">
        <div class="form-group">
          <label for="reportReason" class="form-label">Reason</label>
          <select data-select id="reportReason" name="reason" class="form-input" required>
            <option value="">Choose a reason…</option>
            <% Object.entries(reportReasons).forEach(([value, label]) => { %>
              <option value="<%= value %>"><%= label %></option>
            <% }); %>
          </select>
        </div>
        <div class="form-group">
          <label for="reportDescription" class="form-label">Details <span class="muted">optional</span></label>
          <textarea id="reportDescription" name="description" class="form-input" rows="3" maxlength="1000"></textarea>
        </div>
      </div>
    </form>
    <div class="modal-footer" id="reportFooter">
      <button type="button" class="btn btn-secondary" data-report-close>Cancel</button>
      <button type="submit" form="reportForm" id="reportSubmit" class="btn btn-danger">Send report</button>
    </div>
  </div>
</div>
<script src="/js/report.js"></script>
