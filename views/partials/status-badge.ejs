<%# Status badge for list rows. Takes { status }: a row's accessStatus (services/accessService.js). %>
<% if (status === 'blocked') { %>
  <span class="badge badge-expired">Blocked</span>
<% } else if (status === 'quarantined') { %>
  <span class="badge badge-max" title="Reported by several visitors. Visitors see a warning until an admin reviews it.">Under review</span>
<% } else if (status === 'scheduled') { %>
  <span class="badge badge-max">Scheduled</span>
<% } else if (status === 'expired') { %>
  <span class="badge badge-expired">Expired</span>
<% } else if (status === 'limit_reached') { %>
  <span class="badge badge-max">Limit reached</span>
<% } else { %>
  <span class="badge badge-active">Active</span>
<% } %>
