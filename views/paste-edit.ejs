<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Edit paste', styles: ['forms', 'sections', 'tagSelector', 'lineNumbers', 'paste-edit'] }) %>
</head>
<%- include('partials/layout-start', { shell: 'app', currentPage: 'dashboard' }) %>
<% const backUrl = paste.teamId ? `/dashboard?team=${paste.teamId}` : '/dashboard'; -%>

  <main class="main-content-wide page-medium" id="pasteEditor" data-paste-id="<%= paste.id %>">
    <div class="header-section">
      <div>
        <h2 class="page-title"><%= paste.title || 'Untitled paste' %></h2>
        <p><a href="/p/<%= paste.slug %>" target="_blank" rel="noopener" id="peLink">/p/<%= paste.slug %></a></p>
      </div>
      <div class="header-actions">
        <a href="<%= backUrl %>" class="btn btn-secondary" data-back>Back</a>
      </div>
    </div>

    <section class="section-card">
      <div class="section-head">
        <h3>Text</h3>
        <span class="paste-edit-size" id="peSize"></span>
      </div>
      <p class="section-help">Shown as plain text; the language is only a label.</p>
      <div class="form-grid">
        <div class="form-group">
          <label for="peTitle" class="form-label">Title <span class="muted">optional</span></label>
          <input type="text" id="peTitle" class="form-input" maxlength="200" value="<%= paste.title || '' %>">
        </div>
        <div class="form-group">
          <label for="peLanguage" class="form-label">Language <span class="muted">optional</span></label>
          <input type="text" id="peLanguage" class="form-input" maxlength="30" value="<%= paste.language || '' %>">
        </div>
      </div>
      <%- include('partials/slug-edit-field', { id: 'peSlug', prefix: '/p/', value: paste.slug }) %>
      <div class="form-group">
        <label for="peContent" class="form-label">Content</label>
        <textarea id="peContent" class="paste-edit-textarea" spellcheck="false" data-line-numbers><%= paste.content %></textarea>
      </div>
    </section>

    <section class="section-card">
      <h3>Settings</h3>
      <p class="section-help">Leave a field empty for no limit.</p>
      <div class="form-grid">
        <div class="form-group">
          <label for="peExpiresAt" class="form-label">Expires on</label>
          <input type="date" id="peExpiresAt" class="form-input" value="<%= paste.expiresAt ? String(paste.expiresAt).substring(0, 10) : '' %>">
        </div>
        <div class="form-group">
          <label for="peMaxViews" class="form-label">View limit</label>
          <input type="number" id="peMaxViews" class="form-input" min="1" placeholder="Unlimited" value="<%= paste.maxViews || '' %>">
        </div>
      </div>
      <div class="form-group">
        <span class="form-label">Tags</span>
        <div id="peTagSelectorMount"></div>
        <input type="hidden" id="peTags" value="<%= (paste.tags || []).map(t => t.name).join(',') %>">
      </div>
      <div class="form-group">
        <% if (paste.password) { %>
          <p class="status-note warning">This paste is password protected.</p>
        <% } %>
        <label for="pePassword" class="form-label"><%= paste.password ? 'New password' : 'Password' %> <span class="muted"><%= paste.password ? 'leave empty to keep the current one' : 'optional' %></span></label>
        <input type="password" id="pePassword" class="form-input" autocomplete="new-password" data-toggle-password>
        <% if (paste.password) { %>
          <label class="check-line"><input type="checkbox" id="peRemovePassword"> Remove the password</label>
        <% } %>
      </div>
    </section>

    <div class="save-bar" id="saveBar" data-state="clean">
      <span class="save-bar-status" id="saveStatus">No unsaved changes</span>
      <button type="button" class="btn btn-small" id="peSaveBtn">Save</button>
    </div>
  </main>

  <script src="/js/main.js"></script>
  <script src="/js/tagSelector.js"></script>
  <script src="/js/lineNumbers.js"></script>
  <script src="/js/paste-edit.js"></script>
<%- include('partials/layout-end', { shell: 'app' }) %>
</html>
