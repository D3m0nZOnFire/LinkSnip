<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Audit logs · Admin', styles: ['tables', 'modals', 'forms', 'admin-pages'] }) %>
</head>
<%- include('partials/layout-start', { shell: 'admin', currentPage: 'admin-audit-logs' }) %>
<%
  // The filters as a query string (export links and the pager keep them)
  const query = (extra = {}) => {
    const params = new URLSearchParams();
    for (const [key, value] of Object.entries({ ...extra, category: filters.category, action: filters.action, userId: filters.userId, search: filters.search })) {
      if (value) params.set(key, value);
    }
    return params.toString();
  };
  // Stored as UTC without a zone ("2026-01-15 10:30:00"); public/js/admin-audit-logs.js shows it in the reader's zone
  const utc = (value) => {
    const iso = String(value || '').replace(' ', 'T').replace(/(\.\d+)?Z?$/, 'Z');
    return { iso, text: `${iso.slice(0, 10)} ${iso.slice(11, 16)} UTC` };
  };
  const counts = Object.fromEntries((stats || []).map(row => [row.category, row.count]));
  const CATEGORY_STATS = [['AUTH', 'Sign-ins'], ['ADMIN_ACTION', 'Admin actions'], ['ACCOUNT_CHANGE', 'Account changes'], ['SECURITY', 'Security']];
  const isAlarming = (action) => /FAILED|DELETE|BAN|BLOCK|LOCKOUT/.test(action);
  const hasFilters = filters.category || filters.action || filters.userId || filters.search;
-%>

  <main class="main-content-wide">
    <div class="header-section">
      <div>
        <h2>Audit logs</h2>
        <p><%= pagination.totalLogs %> entr<%= pagination.totalLogs === 1 ? 'y' : 'ies' %><%= hasFilters ? ' match' : '' %></p>
      </div>
      <div class="header-actions">
        <a href="/api/admin/audit-logs/export?<%= query({ format: 'csv' }) %>" class="btn btn-secondary"><%- include('partials/icon', { icon: 'download' }) %> CSV</a>
        <a href="/api/admin/audit-logs/export?<%= query({ format: 'json' }) %>" class="btn btn-secondary"><%- include('partials/icon', { icon: 'download' }) %> JSON</a>
      </div>
    </div>

    <div class="mini-stats">
      <% CATEGORY_STATS.forEach(([key, label]) => { %>
        <div class="mini-stat"><div class="mini-stat-label"><%= label %></div><div class="mini-stat-value"><%= (counts[key] || 0).toLocaleString('en-US') %></div></div>
      <% }) %>
    </div>

    <section class="filter-bar card">
      <div class="filter-field grow">
        <strong>Maintenance</strong>
        <span>Run the nightly jobs now: a database backup, or deleting entries older than the retention period.</span>
      </div>
      <div class="filter-actions">
        <button type="button" class="btn btn-small btn-secondary" data-maintenance="backup">Back up database</button>
        <button type="button" class="btn btn-small btn-secondary" data-maintenance="cleanup">Clean up old entries</button>
      </div>
    </section>

    <form class="filter-bar card" method="GET" action="/admin/audit-logs">
      <label class="filter-field grow">Search
        <input type="search" class="form-input" name="search" value="<%= filters.search || '' %>" placeholder="Description, username…">
      </label>
      <label class="filter-field">Category
        <select class="form-input" name="category">
          <option value="">All categories</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat %>"<%= filters.category === cat ? ' selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </label>
      <label class="filter-field">Action
        <select class="form-input" name="action">
          <option value="">All actions</option>
          <% actions.forEach(act => { %>
            <option value="<%= act %>"<%= filters.action === act ? ' selected' : '' %>><%= act %></option>
          <% }) %>
        </select>
      </label>
      <label class="filter-field">User ID
        <input type="number" class="form-input" name="userId" value="<%= filters.userId || '' %>" min="1">
      </label>
      <div class="filter-actions">
        <button type="submit" class="btn btn-small">Apply</button>
        <% if (hasFilters) { %><a href="/admin/audit-logs" class="btn btn-small btn-ghost">Reset</a><% } %>
      </div>
    </form>

    <% if (logs.length === 0) { %>
      <div class="empty-state"><p>No log entries found.</p></div>
    <% } else { %>
      <div class="table-container scroll">
        <div class="table-wrapper">
          <table>
            <thead>
              <tr><th>Time</th><th>User</th><th>Action</th><th>Target</th><th>Details</th><th>IP address</th></tr>
            </thead>
            <tbody>
              <% logs.forEach(log => { const time = utc(log.createdAt); %>
                <tr>
                  <td class="nowrap"><time datetime="<%= time.iso %>" data-local><%= time.text %></time></td>
                  <td class="nowrap">
                    <% if (log.userId) { %>
                      <strong><%= log.username %></strong>
                      <span class="cell-sub">ID <%= log.userId %></span>
                    <% } else if (log.username) { %>
                      <%= log.username %>
                    <% } else { %>
                      <span class="muted">System</span>
                    <% } %>
                  </td>
                  <td>
                    <span class="badge <%= isAlarming(log.action) ? 'badge-max' : 'badge-muted' %>"><%= log.action %></span>
                    <span class="cell-sub"><%= log.category %></span>
                  </td>
                  <td>
                    <% if (log.targetType && log.targetId) { %>
                      <strong><%= log.targetType %></strong> #<%= log.targetId %>
                      <span class="cell-sub" title="<%= log.targetDescription || '' %>"><%= log.targetDescription || '' %></span>
                    <% } else { %>
                      <span class="muted">—</span>
                    <% } %>
                  </td>
                  <td>
                    <% if (log.details) { %>
                      <button type="button" class="log-details" data-details="<%= log.details %>" title="Show all details"><%= log.details.length > 50 ? log.details.substring(0, 50) + '…' : log.details %></button>
                    <% } else { %>
                      <span class="muted">—</span>
                    <% } %>
                  </td>
                  <td class="nowrap mono"><%= log.ipAddress || '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>

      <% if (pagination.totalPages > 1) { %>
        <div class="table-footer">
          <span><%= (pagination.currentPage - 1) * pagination.limit + 1 %>–<%= Math.min(pagination.currentPage * pagination.limit, pagination.totalLogs) %> of <%= pagination.totalLogs %></span>
          <nav class="pager" aria-label="Pages">
            <% if (pagination.hasPrev) { %><a href="?<%= query({ page: pagination.currentPage - 1, limit: pagination.limit }) %>" class="btn btn-small btn-secondary">Previous</a><% } %>
            <span>Page <%= pagination.currentPage %> of <%= pagination.totalPages %></span>
            <% if (pagination.hasNext) { %><a href="?<%= query({ page: pagination.currentPage + 1, limit: pagination.limit }) %>" class="btn btn-small btn-secondary">Next</a><% } %>
          </nav>
        </div>
      <% } %>
    <% } %>
  </main>

  <div id="detailsModal" class="modal-overlay">
    <div class="modal">
      <div class="modal-header">
        <h3>Log details</h3>
        <button type="button" class="modal-close" data-close-modal="detailsModal" aria-label="Close"><%- include('partials/icon', { icon: 'close' }) %></button>
      </div>
      <div class="modal-body">
        <pre class="log-details-content" id="detailsContent"></pre>
      </div>
    </div>
  </div>

  <%- include('partials/confirm-modal') %>

  <script src="/js/main.js"></script>
  <script src="/js/admin-audit-logs.js"></script>
<%- include('partials/layout-end', { shell: 'admin' }) %>
</html>
