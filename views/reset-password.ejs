<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: title, styles: ['forms', 'auth'], noindex: true }) %>
</head>
<%- include('partials/layout-start', { shell: 'standalone', pageClass: 'page-center' }) %>
  <main class="auth-card">
    <div class="auth-brand"><%- include('partials/brand', { large: true }) %></div>
    <% if (state === 'invalid') { %>
      <div class="auth-heading">
        <h1>This link no longer works</h1>
        <p>It expired (links work for 30 minutes), was already used, or a newer one was sent.</p>
      </div>
      <div class="auth-form">
        <a href="/forgot-password" class="btn">Get a new link</a>
      </div>
    <% } else { %>
      <div class="auth-heading">
        <h1>Choose a new password</h1>
        <p>for <strong><%= username %></strong></p>
      </div>
      <form class="auth-form" action="/reset-password/<%= encodeURIComponent(token) %>" method="POST">
        <% if (error) { %><div class="auth-error" role="alert"><%= error %></div><% } %>
        <div class="form-group">
          <label for="password" class="form-label">New password <span class="muted">at least <%= minPasswordLength %> characters</span></label>
          <input type="password" id="password" name="password" class="form-input" minlength="<%= minPasswordLength %>" autocomplete="new-password" required autofocus data-toggle-password>
        </div>
        <div class="form-group">
          <label for="confirmPassword" class="form-label">Repeat the new password</label>
          <input type="password" id="confirmPassword" name="confirmPassword" class="form-input" autocomplete="new-password" required data-toggle-password>
        </div>
        <button type="submit" class="btn">Save the new password</button>
      </form>
      <div class="auth-links">
        <p>This logs you out on every other device.</p>
      </div>
    <% } %>
  </main>
  <script src="/js/main.js"></script>
<%- include('partials/layout-end', { shell: 'standalone' }) %>
</html>
