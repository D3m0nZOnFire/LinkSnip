<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: currentTeam ? currentTeam.name : 'Dashboard', styles: ['forms', 'modals', 'items', 'tagSelector', 'dashboard'] }) %>
</head>
<%- include('partials/layout-start', { shell: 'app', currentPage: 'dashboard' }) %>
<%
  const canCreate = !currentTeam || currentTeam.role !== 'viewer';
  const showFiles = types.includes('file');
-%>
  <main class="main-content-wide items-page dash-page">
    <div class="header-section">
      <div>
        <h2 class="dash-title"><%= currentTeam ? currentTeam.name : 'Dashboard' %></h2>
        <p><%= currentTeam ? `Team items · you are ${currentTeam.role === 'owner' ? 'an' : 'a'} ${currentTeam.role}` : 'Your links, bundles, pastes and files' %></p>
      </div>
      <div class="dash-header-actions">
        <% if (dashboardTeams.length) { %>
          <label class="visually-hidden" for="dashboardScope">Show items of</label>
          <select data-select id="dashboardScope" class="form-input">
            <option value=""<%= currentTeam ? '' : ' selected' %>>Personal</option>
            <% dashboardTeams.forEach(team => { %>
              <option value="<%= team.id %>"<%= currentTeam && currentTeam.id === team.id ? ' selected' : '' %>><%= team.name %></option>
            <% }) %>
          </select>
        <% } %>
        <% if (result.rows.some(item => item.canEdit)) { %>
          <button type="button" class="btn btn-secondary" id="selectModeBtn" aria-pressed="false">Select</button>
        <% } %>
        <% if (canCreate) { %>
          <a href="/<%= currentTeam ? `?team=${currentTeam.id}` : '' %>" class="btn"><%- include('partials/icon', { icon: 'plus' }) %> Create</a>
        <% } %>
      </div>
    </div>

    <%- include('partials/team-invites', { teamInvites: locals.teamInvites || [] }) %>

    <form class="dash-toolbar" id="dashFilters" method="GET" action="/dashboard" role="search">
      <% if (currentTeam) { %><input type="hidden" name="team" value="<%= currentTeam.id %>"><% } %>
      <input type="hidden" name="type" value="<%= filters.type === 'all' ? '' : filters.type %>">
      <div class="dash-search">
        <%- include('partials/icon', { icon: 'search' }) %>
        <label class="visually-hidden" for="dashSearch">Search</label>
        <input type="search" class="form-input" id="dashSearch" name="search" value="<%= filters.search %>"
          placeholder="Search slugs, destinations, titles…" autocomplete="off" spellcheck="false">
      </div>
      <% if (tagOptions.length) { %>
        <label class="visually-hidden" for="dashTag">Tags</label>
        <select data-select data-select-search data-select-match="dashTagMatch" data-placeholder="All tags" multiple
          class="form-input dash-tag-select" id="dashTag" name="tag">
          <% tagOptions.forEach(tag => { %><option value="<%= tag.name %>" data-color="<%= tag.color || '' %>" data-hint="<%= tag.itemCount %>"<%= filters.tags.includes(tag.name) ? ' selected' : '' %>><%= tag.name %></option><% }) %>
        </select>
        <input type="hidden" id="dashTagMatch" name="match" value="<%= filters.match %>">
      <% } %>
      <label class="visually-hidden" for="dashSort">Sort</label>
      <select data-select class="form-input" id="dashSort" name="sort">
        <% [['newest', 'Newest'], ['oldest', 'Oldest'], ['most-used', 'Most used'], ['least-used', 'Least used']].forEach(([value, label]) => { %>
          <option value="<%= value %>"<%= filters.sort === value ? ' selected' : '' %>><%= label %></option>
        <% }) %>
      </select>
      <noscript><button type="submit" class="btn btn-small btn-secondary">Search</button></noscript>
    </form>

    <div id="dashResults" aria-live="polite">
      <%- include('partials/dashboard-results') %>
    </div>
  </main>

  <!-- Select mode: bulk delete -->
  <div class="bulk-bar" id="bulkBar" hidden>
    <span id="bulkCount">0 selected</span>
    <button type="button" class="btn btn-small btn-secondary" id="bulkAll">Select all</button>
    <button type="button" class="btn btn-small btn-danger" id="bulkDelete" disabled>Delete</button>
    <button type="button" class="btn btn-small btn-ghost" id="bulkCancel">Cancel</button>
  </div>

  <!-- QR code -->
  <div id="qrModal" class="modal-overlay">
    <div class="modal modal-narrow" role="dialog" aria-modal="true" aria-labelledby="qrTitle">
      <div class="modal-header">
        <h3 id="qrTitle">QR code</h3>
        <button type="button" class="modal-close" data-close-modal="qrModal" aria-label="Close"><%- include('partials/icon', { icon: 'close' }) %></button>
      </div>
      <div class="modal-body qr-body">
        <img id="qrImage" alt="QR code" width="240" height="240">
        <p class="field-help" id="qrTarget"></p>
      </div>
      <div class="modal-footer">
        <a id="qrDownload" class="btn" href="#"><%- include('partials/icon', { icon: 'download' }) %> Download PNG</a>
      </div>
    </div>
  </div>

  <!-- Edit a link -->
  <div id="editUrlModal" class="modal-overlay">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="editUrlTitle">
      <div class="modal-header">
        <h3 id="editUrlTitle">Edit link</h3>
        <button type="button" class="modal-close" data-close-modal="editUrlModal" aria-label="Close"><%- include('partials/icon', { icon: 'close' }) %></button>
      </div>
      <form class="modal-body" id="editUrlForm" novalidate>
        <p class="field-help" id="editUrlMeta"></p>
        <p class="field-help edit-password-note" id="editUrlPasswordNote" hidden><%- include('partials/icon', { icon: 'lock' }) %> This link is password-protected.</p>
        <div class="form-group">
          <label for="editLongUrl" class="form-label">Destination</label>
          <input type="url" id="editLongUrl" class="form-input" placeholder="https://example.com" required>
        </div>
        <%- include('partials/slug-edit-field', { id: 'editCustomSlug', prefix: '/s/' }) %>
        <% if (can.tags) { %>
        <div class="form-group">
          <label class="form-label">Tags</label>
          <div id="editUrlTags"></div>
        </div>
        <% } %>
        <div class="form-group" id="editUrlPasswordGroup">
          <% if (can.passwordProtection) { %>
          <label for="editPassword" class="form-label">New password (optional)</label>
          <input type="password" id="editPassword" class="form-input" autocomplete="new-password" placeholder="Leave empty to keep it" data-toggle-password>
          <% } %>
          <label class="checkbox-line" id="removePasswordLine"><input type="checkbox" id="removePassword"> Remove the password</label>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="editMaxUses" class="form-label">Click limit</label>
            <input type="number" id="editMaxUses" class="form-input" min="1" placeholder="No limit">
          </div>
          <div class="form-group">
            <label for="editExpirationDays" class="form-label">Days until it expires</label>
            <input type="number" id="editExpirationDays" class="form-input" min="1" placeholder="Never">
          </div>
        </div>
        <% if (can.scheduling) { %>
        <div class="form-row">
          <div class="form-group">
            <label for="editActivateDateTime" class="form-label">Active from (UTC)</label>
            <input type="datetime-local" id="editActivateDateTime" class="form-input">
          </div>
          <div class="form-group">
            <label for="editDeactivateDateTime" class="form-label">Active until (UTC)</label>
            <input type="datetime-local" id="editDeactivateDateTime" class="form-input">
          </div>
        </div>
        <% } %>
      </form>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-close-modal="editUrlModal">Cancel</button>
        <button type="submit" class="btn" form="editUrlForm" id="saveUrlBtn">Save</button>
      </div>
    </div>
  </div>

  <!-- Edit a bundle -->
  <div id="editBundleModal" class="modal-overlay">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="editBundleTitle">
      <div class="modal-header">
        <h3 id="editBundleTitle">Edit bundle</h3>
        <button type="button" class="modal-close" data-close-modal="editBundleModal" aria-label="Close"><%- include('partials/icon', { icon: 'close' }) %></button>
      </div>
      <form class="modal-body" id="editBundleForm" novalidate>
        <div class="form-group">
          <label for="editBundleName" class="form-label">Title</label>
          <input type="text" id="editBundleName" class="form-input" maxlength="100" required>
        </div>
        <%- include('partials/slug-edit-field', { id: 'editBundleSlug', prefix: '/b/' }) %>
        <div class="form-group">
          <label for="editBundleDescription" class="form-label">Description</label>
          <textarea id="editBundleDescription" class="form-input" rows="2" placeholder="Optional"></textarea>
        </div>
        <div class="form-group">
          <span class="form-label">Links</span>
          <div class="bundle-edit-items" id="editBundleItems"></div>
          <button type="button" class="btn btn-small btn-secondary" id="editBundleAdd"><%- include('partials/icon', { icon: 'plus' }) %> Add link</button>
        </div>
        <% if (can.tags) { %>
        <div class="form-group">
          <label class="form-label">Tags</label>
          <div id="editBundleTags"></div>
        </div>
        <% } %>
      </form>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-close-modal="editBundleModal">Cancel</button>
        <button type="submit" class="btn" form="editBundleForm" id="saveBundleBtn">Save</button>
      </div>
    </div>
  </div>

  <% if (showFiles) { %>
  <!-- Edit a file -->
  <div id="editFileModal" class="modal-overlay">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="editFileTitle">
      <div class="modal-header">
        <h3 id="editFileTitle">Edit file</h3>
        <button type="button" class="modal-close" data-close-modal="editFileModal" aria-label="Close"><%- include('partials/icon', { icon: 'close' }) %></button>
      </div>
      <form class="modal-body" id="editFileForm" novalidate>
        <p class="field-help" id="editFileName"></p>
        <%- include('partials/slug-edit-field', { id: 'editFileSlug', prefix: '/f/' }) %>
        <div class="form-row">
          <div class="form-group">
            <label for="editFileExpires" class="form-label">Expires</label>
            <input type="date" id="editFileExpires" class="form-input">
          </div>
          <div class="form-group">
            <label for="editFileMaxDownloads" class="form-label">Download limit</label>
            <input type="number" id="editFileMaxDownloads" class="form-input" min="1" placeholder="No limit">
          </div>
        </div>
        <div class="form-group">
          <% if (can.passwordProtection) { %>
          <label for="editFilePassword" class="form-label">New password (optional)</label>
          <input type="password" id="editFilePassword" class="form-input" autocomplete="new-password" placeholder="Leave empty to keep it" data-toggle-password>
          <% } %>
          <label class="checkbox-line" id="editFileRemoveLine"><input type="checkbox" id="editFileRemovePassword"> Remove the password</label>
        </div>
        <div class="form-group">
          <label for="editFileSharing" class="form-label">Who can open it</label>
          <select data-select id="editFileSharing" class="form-input">
            <option value="public">Anyone with the link</option>
            <option value="restricted">Only the people listed below</option>
          </select>
        </div>
        <div class="form-group" id="editFileUsersGroup">
          <label for="editFileUserInput" class="form-label">People</label>
          <div class="user-chips-input-wrap" id="editFileUsers">
            <input type="text" id="editFileUserInput" class="user-chips-text-input" placeholder="Type a username and press Enter…" autocomplete="off">
          </div>
          <p class="field-help" id="editFileUsersError" role="alert"></p>
        </div>
        <% if (can.tags) { %>
        <div class="form-group">
          <label class="form-label">Tags</label>
          <div id="editFileTags"></div>
        </div>
        <% } %>
      </form>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-close-modal="editFileModal">Cancel</button>
        <button type="submit" class="btn" form="editFileForm" id="saveFileBtn">Save</button>
      </div>
    </div>
  </div>
  <% } %>

  <% if (writableTeams.length && !currentTeam) { %>
  <!-- Move to a team -->
  <div id="moveToTeamModal" class="modal-overlay">
    <div class="modal modal-narrow" role="dialog" aria-modal="true" aria-labelledby="moveTeamTitle">
      <div class="modal-header">
        <h3 id="moveTeamTitle">Move to a team</h3>
        <button type="button" class="modal-close" data-close-modal="moveToTeamModal" aria-label="Close"><%- include('partials/icon', { icon: 'close' }) %></button>
      </div>
      <form class="modal-body" id="moveToTeamForm">
        <div class="form-group">
          <label for="moveTeamSelect" class="form-label">Team</label>
          <select data-select id="moveTeamSelect" class="form-input">
            <% writableTeams.forEach(team => { %><option value="<%= team.id %>"><%= team.name %></option><% }) %>
          </select>
        </div>
        <p class="field-help">Its tags move along. The team's members will see it, and only team owners and admins can move it back out.</p>
        <p class="field-error" id="moveTeamError" role="alert"></p>
      </form>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-close-modal="moveToTeamModal">Cancel</button>
        <button type="submit" class="btn" form="moveToTeamForm">Move</button>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Confirm (confirmAction in main.js) -->
  <div id="confirmModal" class="modal-overlay">
    <div class="modal modal-narrow" role="alertdialog" aria-modal="true" aria-labelledby="confirmModalTitle">
      <div class="modal-header">
        <h3 id="confirmModalTitle">Confirm</h3>
      </div>
      <div class="modal-body">
        <p id="confirmModalMessage"></p>
      </div>
      <div class="modal-footer">
        <button type="button" id="confirmModalCancelBtn" class="btn btn-secondary">Cancel</button>
        <button type="button" id="confirmModalConfirmBtn" class="btn btn-danger">Delete</button>
      </div>
    </div>
  </div>

  <script src="/js/main.js"></script>
  <script src="/js/tagSelector.js"></script>
  <script src="/js/dashboard.js"></script>
  <script src="/js/teamMove.js"></script>
<%- include('partials/layout-end', { shell: 'app' }) %>
</html>
