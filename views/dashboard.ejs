        <div class="form-grid">
          <div class="form-group">
            <label for="editMaxUses" class="form-label">Max Uses</label>
            <input
              type="number"
              id="editMaxUses"
              class="form-input"
              placeholder="Unlimited"
              min="1"
            >
          </div>

          <div class="form-group">
            <label for="editExpirationDays" class="form-label">Days Until Expiration</label>
            <input
              type="number"
              id="editExpirationDays"
              class="form-input"
              placeholder="Never expire"
              min="1"
            >
          </div>
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label for="editActivateDateTime" class="form-label">Activate At (Optional)</label>
            <input
              type="datetime-local"
              id="editActivateDateTime"
              class="form-input"
            >
            <small style="color: var(--muted-foreground); font-size: 0.875rem;">
              Link will not work before this time
            </small>
          </div>

          <div class="form-group">
            <label for="editDeactivateDateTime" class="form-label">Deactivate At (Optional)</label>
            <input
              type="datetime-local"
              id="editDeactivateDateTime"
              class="form-input"
            >
            <small style="color: var(--muted-foreground); font-size: 0.875rem;">
              Link will stop working after this time
            </small>
          </div>
        </div>
      </div>
      
      <div class="modal-footer">
        <button class="btn" style="background-color: var(--secondary); color: var(--foreground);" id="cancelEditBtn">
          Cancel
        </button>
        <button class="btn" id="saveUrlBtn" style="color: var(--primary-foreground);">
          Save Changes
        </button>
      </div>
    </div>
  </div>

  <!-- QR Code Modal -->
  <div id="qrcodeModal" class="modal-overlay">
    <div class="modal">
      <div class="modal-header">
        <h3>QR Code</h3>
        <button class="modal-close" onclick="closeModal('qrcodeModal')">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <div class="modal-body" style="text-align: center;">
        <div id="qrcodeContainer" style="margin: 2rem 0;">
          <img id="qrcodeImage" src="" alt="QR Code" style="max-width: 300px; width: 100%; border-radius: 8px;">
        </div>
        <p style="color: var(--muted-foreground); margin-bottom: 1rem;">Scan this QR code to open the link</p>
      </div>

      <div class="modal-footer">
        <button class="btn" style="background-color: var(--secondary); color: var(--foreground);" onclick="closeModal('qrcodeModal')">
          Close
        </button>
        <button class="btn" id="downloadQRBtn" style="color: var(--primary-foreground);">
          Download PNG
        </button>
      </div>
    </div>
  </div>

  <script src="/js/main.js"></script>
  <script src="/js/tagSelector.js"></script>
  <script src="/js/dashboard.js"></script>
  <script>
    // ─── Row filters: type pill + selected tags, both apply ─
    let dashTypeFilter = 'all';
    const dashSelectedTags = new Set();
    const DASH_TYPE_MAP = { links: 'link', bundles: 'bundle', files: 'file', pastes: 'paste' };

    function applyRowFilters() {
      const itemList = document.getElementById('itemList');
      if (!itemList) return;
      itemList.querySelectorAll(':scope > [data-type]').forEach(item => {
        const typeMatch = dashTypeFilter === 'all' || item.dataset.type === DASH_TYPE_MAP[dashTypeFilter];
        const rowTags = (item.dataset.tags || '').split(',').filter(Boolean);
        const tagMatch = dashSelectedTags.size === 0 || rowTags.some(tag => dashSelectedTags.has(tag));
        item.style.display = typeMatch && tagMatch ? '' : 'none';
      });
    }

    // ─── Dashboard Filter Pills ───────────────────────────
    function setDashFilter(filter) {
      ['all', 'links', 'bundles', 'files', 'pastes'].forEach(f => {
        const pill = document.getElementById('pill-' + f);
        if (pill) pill.classList.toggle('active', f === filter);
      });

      const itemList = document.getElementById('itemList');

      const perTypeMsgs = ['noBundlesMsg', 'noFilesMsg', 'noPastesMsg']
        .map(id => document.getElementById(id))
        .filter(Boolean);

      // Account is completely empty — the main "Nothing here yet" block already
      // covers every filter, so never stack a second message on top of it.
      if (!itemList) {
        perTypeMsgs.forEach(el => { el.style.display = 'none'; });
        return;
      }

      dashTypeFilter = filter;
      applyRowFilters();

      const msgFor = { bundles: 'noBundlesMsg', files: 'noFilesMsg', pastes: 'noPastesMsg' };
      perTypeMsgs.forEach(el => { el.style.display = 'none'; });
      if (msgFor[filter]) {
        const hasType = itemList.querySelectorAll(':scope > [data-type="' + DASH_TYPE_MAP[filter] + '"]').length > 0;
        const el = document.getElementById(msgFor[filter]);
        if (el && !hasType) el.style.display = 'block';
      }
    }

    // ─── Sort unified list by creation date (newest first) ─
    function sortItemsByDate() {
      const list = document.getElementById('itemList');
      if (!list) return;
      const items = Array.from(list.children);
      items.sort((a, b) => {
        const da = new Date(a.dataset.createdAt || 0);
        const db = new Date(b.dataset.createdAt || 0);
        return db - da;
      });
      items.forEach(item => list.appendChild(item));
    }

    // ─── Tag selectors in the edit modals (only rendered for roles with tags) ─
    const editSelectors = {};
    function editSelector(id) {
      if (!editSelectors[id] && document.getElementById(id) && typeof TagSelector !== 'undefined') {
        editSelectors[id] = new TagSelector(id, { placeholder: 'Add tags...' });
      }
      return editSelectors[id] || null;
    }

    // ─── Bundle Edit / Delete ─────────────────────────────
    function editBundle(bundleId) {
      openModal('editBundleModal');
      document.getElementById('editBundleLoading').style.display = 'block';
      document.getElementById('editBundleContent').style.display = 'none';
      document.getElementById('editBundleModalFooter').style.display = 'none';

      fetch('/api/bundles/' + bundleId)
        .then(r => r.json())
        .then(data => {
          document.getElementById('editBundleId').value = bundleId;
          document.getElementById('editBundleTitle').value = data.title || '';
          document.getElementById('editBundleDescription').value = data.description || '';

          const list = document.getElementById('editBundleItemsList');
          list.innerHTML = '';
          (data.items || []).forEach((item, i) => addEditBundleItem(item.url, item.label));
          const bundleTags = editSelector('editBundleTagSelector');
          if (bundleTags) bundleTags.setValue((data.tags || []).map(t => t.name).join(','));

          document.getElementById('editBundleLoading').style.display = 'none';
          document.getElementById('editBundleContent').style.display = 'block';
          document.getElementById('editBundleModalFooter').style.display = 'flex';
        })
        .catch(() => {
          closeModal('editBundleModal');
          alert('Failed to load bundle.');
        });
    }

    function addEditBundleItem(url = '', label = '') {
      const list = document.getElementById('editBundleItemsList');
      const row = document.createElement('div');
      row.style.cssText = 'display:flex; gap:0.5rem; align-items:center;';
      row.innerHTML = `
        <input type="url" class="form-input edit-bundle-url" value="${url.replace(/"/g, '&quot;')}" placeholder="https://example.com" style="flex:2;">
        <input type="text" class="form-input edit-bundle-label" value="${label.replace(/"/g, '&quot;')}" placeholder="Label (optional)" style="flex:1;" maxlength="100">
        <button type="button" class="icon-btn" style="color:var(--destructive); flex-shrink:0;" onclick="this.closest('div').remove()" title="Remove">
          <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      `;
      list.appendChild(row);
    }

    async function saveBundleChanges() {
      const id = document.getElementById('editBundleId').value;
      const title = document.getElementById('editBundleTitle').value.trim();
      if (!title) { alert('Title is required'); return; }

      const items = [];
      document.getElementById('editBundleItemsList').querySelectorAll('div').forEach(row => {
        const url = row.querySelector('.edit-bundle-url')?.value.trim();
        const label = row.querySelector('.edit-bundle-label')?.value.trim();
        if (url) items.push({ url, label: label || null });
      });
      if (items.length < 2) { alert('At least 2 links are required.'); return; }

      const description = document.getElementById('editBundleDescription').value.trim();
      const body = { title, description: description || null, items };
      const bundleTags = editSelector('editBundleTagSelector');
      if (bundleTags) body.tags = bundleTags.getValue();

      try {
        const res = await fetch('/api/bundles/' + id, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        const data = await res.json();
        if (data.success) {
          closeModal('editBundleModal');
          location.reload();
        } else {
          alert(data.error || 'Failed to save bundle.');
        }
      } catch {
        alert('Network error.');
      }
    }

    function confirmDeleteBundle(bundleId, title) {
      document.getElementById('deleteBundleTitleSpan').textContent = '"' + title + '"';
      document.getElementById('confirmBundleDeleteBtn').onclick = () => deleteBundle(bundleId);
      openModal('confirmDeleteBundleModal');
    }

    async function deleteBundle(bundleId) {
      try {
        const res = await fetch('/api/bundles/' + bundleId, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
          closeModal('confirmDeleteBundleModal');
          const el = document.getElementById('bundle-' + bundleId);
          if (el) el.remove();
        } else {
          alert(data.error || 'Failed to delete bundle.');
        }
      } catch {
        alert('Network error.');
      }
    }

    // ─── Toggle URL details expand/collapse
    function toggleUrlDetails(headerElement) {
      const urlItem = headerElement.closest('.url-item');
      const detailsElement = urlItem.querySelector('.url-item-details');
      const expandIcon = headerElement.querySelector('.expand-icon');

      if (detailsElement.style.display === 'none') {
        detailsElement.style.display = 'block';
        expandIcon.style.transform = 'rotate(180deg)';
      } else {
        detailsElement.style.display = 'none';
        expandIcon.style.transform = 'rotate(0deg)';
      }
    }

    // QR Code functionality
    let currentQRDownloadUrl = null;

    function showQRCode(urlId, slug) {
      currentQRDownloadUrl = `/qrcode/url/${slug}/download?theme=light`;
      document.getElementById('qrcodeImage').src = `/qrcode/url/${slug}?theme=light`;
      openModal('qrcodeModal');
    }

    function showPasteQRCode(slug) {
      currentQRDownloadUrl = `/qrcode/paste/${slug}/download?theme=light`;
      document.getElementById('qrcodeImage').src = `/qrcode/paste/${slug}?theme=light`;
      openModal('qrcodeModal');
    }

    document.getElementById('downloadQRBtn').addEventListener('click', () => {
      if (currentQRDownloadUrl) {
        window.location.href = currentQRDownloadUrl;
      }
    });

    // Pagination functionality
    document.getElementById('itemsPerPage')?.addEventListener('change', function() {
      const limit = this.value;
      const url = new URL(window.location.href);
      url.searchParams.set('limit', limit);
      url.searchParams.set('page', '1'); // Reset to first page
      window.location.href = url.toString();
    });

    document.getElementById('prevPage')?.addEventListener('click', function() {
      const url = new URL(window.location.href);
      const currentPage = parseInt(url.searchParams.get('page') || '1');
      url.searchParams.set('page', Math.max(1, currentPage - 1).toString());
      window.location.href = url.toString();
    });

    document.getElementById('nextPage')?.addEventListener('click', function() {
      const url = new URL(window.location.href);
      const currentPage = parseInt(url.searchParams.get('page') || '1');
      url.searchParams.set('page', (currentPage + 1).toString());
      window.location.href = url.toString();
    });

    // Tag filtering functionality (multi-select)
    document.addEventListener('DOMContentLoaded', function() {
      sortItemsByDate();

      const filterButtons = document.querySelectorAll('.tag-filter-btn');
      const activeFiltersDiv = document.getElementById('activeFilters');
      const filterCountSpan = document.getElementById('filterCount');
      const selectedTags = dashSelectedTags;

      function updateFilters() {
        // Update button visuals
        filterButtons.forEach(btn => {
          const tag = btn.getAttribute('data-tag');
          if (tag === 'all') return; // Skip "Clear All" button

          if (selectedTags.has(tag)) {
            btn.style.opacity = '1';
            btn.style.fontWeight = '600';
            btn.style.transform = 'scale(1.05)';
          } else {
            btn.style.opacity = '0.6';
            btn.style.fontWeight = '400';
            btn.style.transform = 'scale(1)';
          }
        });

        // Update active filters display
        if (selectedTags.size > 0) {
          activeFiltersDiv.style.display = 'block';
          filterCountSpan.textContent = selectedTags.size;
        } else {
          activeFiltersDiv.style.display = 'none';
        }

        // Rows with ANY of the selected tags (within the chosen type)
        applyRowFilters();
      }

      filterButtons.forEach(btn => {
        btn.addEventListener('click', function() {
          const tag = this.getAttribute('data-tag');

          if (tag === 'all') {
            // Clear all filters
            selectedTags.clear();
          } else {
            // Toggle tag selection
            if (selectedTags.has(tag)) {
              selectedTags.delete(tag);
            } else {
              selectedTags.add(tag);
            }
          }

          updateFilters();
        });
      });
    });


    // ─── File actions (roles with uploadFiles) ────────────────────
    <% if (canUploadFiles) { %>
    function copyFileLink(url, btn) {
      navigator.clipboard.writeText(url).then(() => {
        const orig = btn.innerHTML;
        btn.innerHTML = '<svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>';
        setTimeout(() => { btn.innerHTML = orig; }, 1500);
      });
    }

    async function deleteFile(id, name) {
      if (!confirm(`Delete "${name}"? This cannot be undone.`)) return;
      try {
        const res = await fetch(`/api/files/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
          const row = document.getElementById('file-item-' + id);
          if (row) row.remove();
          if (typeof showToast === 'function') showToast('File deleted', 'success');
        } else {
          alert(data.error || 'Delete failed');
        }
      } catch (_) { alert('Request failed'); }
    }

    // ── File Edit Modal ───────────────────────────────────
    let currentFileId = null;

    function openFileEdit(id) {
      currentFileId = id;
      fetch('/api/files').then(r => r.json()).then(data => {
        const f = data.files.find(x => x.id === id);
        if (!f) return;
        document.getElementById('feFileName').textContent = f.originalName;
        document.getElementById('feExpiresAt').value = f.expiresAt ? f.expiresAt.substring(0,10) : '';
        document.getElementById('feMaxDownloads').value = f.maxDownloads || '';
        document.getElementById('fePassword').value = '';
        document.getElementById('feRemovePassword').checked = false;
        document.getElementById('feSharingMode').value = f.sharingMode || 'public';

        // Populate allowed users chips
        const chipsWrap = document.getElementById('feAllowedUsersChips');
        chipsWrap.querySelectorAll('.user-chip').forEach(c => c.remove());
        feAllowedUsers = Array.isArray(f.allowedUsers) ? [...f.allowedUsers] : [];
        document.getElementById('feAllowedUsersHidden').value = JSON.stringify(feAllowedUsers);
        feAllowedUsers.forEach(uid => {
          addFeChip({ id: uid, username: 'uid:' + uid });
        });

        const fileTags = editSelector('feTagSelector');
        if (fileTags) fileTags.setValue((f.tags || []).map(t => t.name).join(','));

        openModal('fileEditModal');
      });
    }

    let feAllowedUsers = [];

    function addFeChip(user) {
      const chipsWrap = document.getElementById('feAllowedUsersChips');
      const typer = document.getElementById('feAllowedUsersTyper');
      if (feAllowedUsers.find(u => u === user.id)) return;
      feAllowedUsers.push(user.id);
      document.getElementById('feAllowedUsersHidden').value = JSON.stringify(feAllowedUsers);

      const chip = document.createElement('span');
      chip.className = 'user-chip';
      chip.dataset.uid = user.id;
      chip.innerHTML = `@${user.username}<button type="button">×</button>`;
      chip.querySelector('button').addEventListener('click', () => {
        feAllowedUsers = feAllowedUsers.filter(u => u !== user.id);
        document.getElementById('feAllowedUsersHidden').value = JSON.stringify(feAllowedUsers);
        chip.remove();
      });
      chipsWrap.insertBefore(chip, typer);
    }

    async function saveFileEdit() {
      if (!currentFileId) return;
      const body = {
        expiresAt: document.getElementById('feExpiresAt').value || null,
        maxDownloads: document.getElementById('feMaxDownloads').value || null,
        password: document.getElementById('fePassword').value || undefined,
        removePassword: document.getElementById('feRemovePassword').checked ? '1' : undefined,
        sharingMode: document.getElementById('feSharingMode').value,
        allowedUsers: document.getElementById('feAllowedUsersHidden').value
      };
      const fileTags = editSelector('feTagSelector');
      if (fileTags) body.tags = fileTags.getValue();
      try {
        const res = await fetch(`/api/files/${currentFileId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        const data = await res.json();
        if (data.success) {
          closeModal('fileEditModal');
          location.reload();
        } else {
          alert(data.error || 'Update failed');
        }
      } catch (_) { alert('Request failed'); }
    }

    // Share-with typer in edit modal
    document.addEventListener('DOMContentLoaded', () => {
      const typer = document.getElementById('feAllowedUsersTyper');
      if (!typer) return;
      typer.addEventListener('keydown', async (e) => {
        if (e.key !== 'Enter' && e.key !== ',') return;
        e.preventDefault();
        const username = typer.value.trim().replace(/^@/, '');
        if (!username) return;
        const res = await fetch(`/api/users/lookup?username=${encodeURIComponent(username)}`);
        const data = await res.json();
        if (data.found) {
          addFeChip({ id: data.id, username: data.username });
          typer.value = '';
        } else {
          alert(`User "@${username}" not found.`);
        }
      });
    });

    <% } %>

    // ── Pastes (all logged-in users) ──────────────────────
    async function deletePaste(id, name) {
      if (!confirm(`Delete "${name}"? This cannot be undone.`)) return;
      try {
        const res = await fetch(`/api/pastes/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
          const row = document.getElementById('paste-item-' + id);
          if (row) row.remove();
          if (typeof showToast === 'function') showToast('Paste deleted', 'success');
        } else {
          alert(data.error || 'Delete failed');
        }
      } catch (_) { alert('Request failed'); }
    }
    // Paste editing lives on its own full page: GET /pastes/:id/edit
  </script>

  <!-- File Edit Modal -->
  <% if (canUploadFiles) { %>
  <div id="fileEditModal" class="modal-overlay">
    <div class="modal" style="max-width:520px;">
      <div class="modal-header">
        <h3>Edit File</h3>
        <button class="modal-close" onclick="closeModal('fileEditModal')">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="modal-body" style="display:flex;flex-direction:column;gap:1rem;">
        <div style="font-weight:500;font-size:0.9rem;color:var(--muted-foreground);" id="feFileName"></div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;">
          <div>
            <label class="form-label">Expires</label>
            <input type="date" id="feExpiresAt" class="form-input" style="width:100%;">
          </div>
          <div>
            <label class="form-label">Max downloads</label>
            <input type="number" id="feMaxDownloads" class="form-input" style="width:100%;" placeholder="Unlimited" min="1">
          </div>
        </div>

        <div>
          <label class="form-label">New password <span style="color:var(--muted-foreground);font-weight:400;">(leave blank to keep existing)</span></label>
          <input type="password" id="fePassword" class="form-input" style="width:100%;" placeholder="Enter new password…">
          <label style="display:flex;align-items:center;gap:0.5rem;margin-top:0.5rem;font-size:0.85rem;color:var(--muted-foreground);cursor:pointer;">
            <input type="checkbox" id="feRemovePassword"> Remove existing password
          </label>
        </div>

        <div>
          <label class="form-label">Access</label>
          <select id="feSharingMode" class="form-input" style="width:100%;">
            <option value="public">Public (anyone with the link)</option>
            <option value="restricted">Restricted (specific users only)</option>
          </select>
        </div>

        <div>
          <label class="form-label">Allowed users</label>
          <div class="user-chips-input-wrap" id="feAllowedUsersChips" onclick="document.getElementById('feAllowedUsersTyper').focus()">
            <input type="text" id="feAllowedUsersTyper" class="user-chips-text-input" placeholder="Type username + Enter…" autocomplete="off">
          </div>
          <input type="hidden" id="feAllowedUsersHidden" value="[]">
        </div>

        <% if (can.tags) { %>
        <div>
          <label class="form-label">Tags</label>
          <div id="feTagSelector"></div>
        </div>
        <% } %>
      </div>
      <div class="modal-footer">
        <button class="btn" style="background:var(--secondary);color:var(--foreground);" onclick="closeModal('fileEditModal')">Cancel</button>
        <button class="btn btn-primary" onclick="saveFileEdit()">Save Changes</button>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Confirm Dialog Modal -->
  <div id="confirmModal" class="modal-overlay">
    <div class="modal" style="max-width: 420px;">
      <div class="modal-header">
        <h3 id="confirmModalTitle">Confirm Action</h3>
        <button class="modal-close" onclick="closeModal('confirmModal')">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <div class="modal-body">
        <p id="confirmModalMessage" style="margin: 0; line-height: 1.6;"></p>
      </div>
      <div class="modal-footer">
        <button id="confirmModalCancelBtn" class="btn" style="background-color: var(--secondary); color: var(--foreground);">Cancel</button>
        <button id="confirmModalConfirmBtn" class="btn btn-danger">Confirm</button>
      </div>
    </div>
  </div>
  <%- include('partials/footer') %>
</body>
</html>