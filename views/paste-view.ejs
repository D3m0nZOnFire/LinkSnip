<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: paste.title || 'Paste', styles: ['modals', 'forms', 'public-pages', 'paste'] }) %>
</head>
<%- include('partials/layout-start', { shell: 'public' }) %>
<%
  const shortUrl = `${baseUrl}/p/${paste.slug}`;
  const day = (value) => new Date(String(value).includes('T') ? value : `${String(value).replace(' ', 'T')}Z`)
    .toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
-%>
  <main class="public-page wide paste-page">
    <article class="item-card">
      <h1 class="paste-title"><%= paste.title ? paste.title : 'Untitled paste' %></h1>
      <div class="paste-short">
        <span><%= shortUrl.replace(/^https?:\/\//, '') %></span>
        <button type="button" class="text-btn" data-copy="<%= shortUrl %>" aria-label="Copy the short link"><%- include('partials/icon', { icon: 'copy' }) %> Copy link</button>
      </div>

      <div class="item-facts">
        <span><%- include('partials/icon', { icon: 'bio' }) %> <%= owner.username %></span>
        <span><%- include('partials/icon', { icon: 'calendar' }) %> <%= day(paste.createdAt) %></span>
        <span><%- include('partials/icon', { icon: 'eye' }) %> <%= paste.views.toLocaleString('en-US') %><%= paste.maxViews ? ` / ${paste.maxViews.toLocaleString('en-US')}` : '' %> view<%= paste.views === 1 && !paste.maxViews ? '' : 's' %></span>
        <span><%= sizeChars.toLocaleString('en-US') %> characters</span>
        <% if (paste.language) { %><span><%= paste.language %></span><% } %>
        <% if (paste.expiresAt) { %><span>Expires <%= day(paste.expiresAt) %></span><% } %>
      </div>
      <%- include('partials/tag-chips', { tags: paste.tags || [] }) %>

      <div class="item-actions">
        <button type="button" class="btn" data-copy-from="pasteRaw"><%- include('partials/icon', { icon: 'copy' }) %> <span data-copy-label>Copy text</span></button>
        <a href="<%= rawUrl %>" class="btn btn-secondary" target="_blank" rel="noopener"><%- include('partials/icon', { icon: 'paste' }) %> Raw</a>
        <a href="<%= rawUrl %>?download=1" class="btn btn-secondary"><%- include('partials/icon', { icon: 'download' }) %> Download</a>
        <% if (canEdit) { %>
          <a href="/pastes/<%= paste.id %>/edit" class="btn btn-secondary"><%- include('partials/icon', { icon: 'edit' }) %> Edit</a>
        <% } %>
      </div>

      <div class="paste-code">
        <div class="paste-gutter" aria-hidden="true"><% for (var i = 1; i <= lines.length; i++) { %><span><%= i %></span><% } %></div>
        <pre class="paste-source"><% lines.forEach(function(line, idx) { %><%= line %><%= idx < lines.length - 1 ? '\n' : '' %><% }); %></pre>
      </div>
      <textarea id="pasteRaw" readonly hidden aria-hidden="true"><%= paste.content %></textarea>

      <% if (features.reports) { %>
      <div class="item-footer">
        <span></span>
        <button type="button" class="text-btn danger" data-report-button><%- include('partials/icon', { icon: 'flag' }) %> <span data-report-label>Report this paste</span></button>
      </div>
      <% } %>
    </article>
  </main>

  <% if (features.reports) { %>
    <%- include('partials/report-modal', { type: 'paste', id: paste.id, noun: 'paste' }) %>
  <% } %>
  <script src="/js/main.js"></script>
  <script src="/js/public-item.js"></script>
<%- include('partials/layout-end', { shell: 'public' }) %>
</html>
