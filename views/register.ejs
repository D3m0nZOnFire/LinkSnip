<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Register', styles: ['forms', 'auth'] }) %>
</head>
<%- include('partials/layout-start', { shell: 'standalone', pageClass: 'page-center' }) %>
  <main class="auth-card">
    <div class="auth-brand"><%- include('partials/brand', { large: true }) %></div>
    <div class="auth-heading">
      <h1>Create an account</h1>
      <p>on <%= branding.name %></p>
    </div>
    <form class="auth-form" action="/register" method="POST">
      <% if (error) { %><div class="auth-error" role="alert"><%= error %></div><% } %>
      <div class="form-group">
        <label for="username" class="form-label">Username</label>
        <input type="text" id="username" name="username" class="form-input" value="<%= username %>" autocomplete="username" required<%= error ? '' : ' autofocus' %>>
      </div>
      <div class="form-group">
        <label for="email" class="form-label">Email <span class="muted">optional, for account recovery</span></label>
        <input type="email" id="email" name="email" class="form-input" value="<%= email %>" autocomplete="email">
      </div>
      <div class="form-group">
        <label for="password" class="form-label">Password <span class="muted">at least <%= minPasswordLength %> characters</span></label>
        <input type="password" id="password" name="password" class="form-input" minlength="<%= minPasswordLength %>" autocomplete="new-password" required data-toggle-password<%= error ? ' autofocus' : '' %>>
      </div>
      <div class="form-group">
        <label for="confirmPassword" class="form-label">Repeat the password</label>
        <input type="password" id="confirmPassword" name="confirmPassword" class="form-input" autocomplete="new-password" required data-toggle-password>
      </div>
      <button type="submit" class="btn">Create account</button>
    </form>
    <div class="auth-links">
      <p>Already have an account? <a href="/login">Log in</a></p>
      <a href="/">Back to the home page</a>
    </div>
  </main>
  <script src="/js/main.js"></script>
<%- include('partials/layout-end', { shell: 'standalone' }) %>
</html>
