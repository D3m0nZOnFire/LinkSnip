<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: `Analytics · ${path}`, styles: ['forms', 'modals', 'overview', 'sections', 'analytics'], noindex: readOnly }) %>
</head>
<% const shell = locals.readOnly || !user ? 'public' : 'app'; %>
<%- include('partials/layout-start', { shell, currentPage: 'analytics' }) %>
<%
  const TARGET_LABEL = { url: 'Goes to', bundle: 'Bundle', paste: 'Paste', file: 'File' };
  const shareLinks = !readOnly && can.analyticsShareLinks;
  const created = new Date(String(item.createdAt).includes('T') ? item.createdAt : `${String(item.createdAt).replace(' ', 'T')}Z`)
    .toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
-%>
  <main class="main-content-wide page-medium analytics-page" id="analyticsPage"
    data-type="<%= type %>" data-id="<%= item.id %>" data-slug="<%= item.slug %>">
    <% if (readOnly) { %>
      <div class="notice info-notice">
        <%- include('partials/icon', { icon: 'chart' }) %>
        <div><strong>Shared analytics</strong><p>A read-only view shared by the owner of this <%= noun %>.</p></div>
      </div>
    <% } %>

    <div class="header-section">
      <div class="analytics-title">
        <h2 class="page-title">Analytics <span class="analytics-path"><%= path %></span></h2>
        <p>
          <%= TARGET_LABEL[type] %>:
          <% if (type === 'url') { %><a href="<%= target %>" target="_blank" rel="noopener noreferrer"><%= target %></a>
          <% } else { %><%= target || '(untitled)' %><% } %>
          · created <%= created %>
        </p>
      </div>
      <div class="header-actions">
        <% if (infoUrl) { %><a href="<%= infoUrl %>" class="btn btn-secondary"><%- include('partials/icon', { icon: 'info' }) %> Info page</a><% } %>
        <% if (features.qrCodes) { %><button type="button" class="btn btn-secondary" data-open-qr><%- include('partials/icon', { icon: 'qr' }) %> QR code</button><% } %>
        <% if (shareLinks) { %><button type="button" class="btn" data-open-share><%- include('partials/icon', { icon: 'share' }) %> Share links</button><% } %>
      </div>
    </div>

    <%- include('partials/analytics-summary', { summary, eventLabel, itemClicks }) %>
  </main>

  <% if (features.qrCodes) { %>
  <div id="qrcodeModal" class="modal-overlay">
    <div class="modal modal-narrow" role="dialog" aria-modal="true" aria-labelledby="qrTitle">
      <div class="modal-header">
        <h3 id="qrTitle">QR code</h3>
        <button type="button" class="modal-close" data-close-modal="qrcodeModal" aria-label="Close"><%- include('partials/icon', { icon: 'close' }) %></button>
      </div>
      <div class="modal-body qr-body">
        <img id="qrcodeImage" alt="QR code for <%= path %>" width="240" height="240">
        <p class="field-help">It opens this <%= noun %><%= type === 'url' ? '’s info page' : '' %>.</p>
      </div>
      <div class="modal-footer">
        <a class="btn" id="downloadQR" href="/qrcode/<%= type %>/<%= item.slug %>/download?theme=light"><%- include('partials/icon', { icon: 'download' }) %> Download PNG</a>
      </div>
    </div>
  </div>
  <% } %>

  <% if (shareLinks) { %>
  <div id="shareLinksModal" class="modal-overlay">
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="shareLinksTitle">
      <div class="modal-header">
        <h3 id="shareLinksTitle">Share links</h3>
        <button type="button" class="modal-close" data-close-modal="shareLinksModal" aria-label="Close"><%- include('partials/icon', { icon: 'close' }) %></button>
      </div>
      <div class="modal-body">
        <p class="field-help">Anyone with a share link sees these analytics without an account. Revoke a link to turn it off.</p>
        <form id="createShareLinkForm" class="share-form">
          <div class="form-group">
            <label for="shareLinkLabel" class="form-label">Label <span class="muted">optional</span></label>
            <input type="text" id="shareLinkLabel" class="form-input" maxlength="100" placeholder="e.g. Client report">
          </div>
          <div class="form-group narrow">
            <label for="shareLinkExpiry" class="form-label">Expires</label>
            <select id="shareLinkExpiry" class="form-input">
              <option value="">Never</option>
              <option value="1">In 1 day</option>
              <option value="7">In 7 days</option>
              <option value="30">In 30 days</option>
              <option value="90">In 90 days</option>
            </select>
          </div>
          <button type="submit" class="btn">Create link</button>
        </form>
        <div id="newShareLink" class="new-share-link" hidden>
          <p><strong>Copy this link now.</strong> It won't be shown again.</p>
          <div class="copy-row">
            <input type="text" id="newShareLinkUrl" class="form-input" readonly aria-label="New share link">
            <button type="button" class="btn btn-secondary" id="copyShareLinkBtn">Copy</button>
          </div>
        </div>
        <h4 class="share-list-title">Active links <span id="shareLinksCount" class="muted"></span></h4>
        <div id="shareLinksList" class="share-list"></div>
      </div>
    </div>
  </div>
  <% } %>

  <script src="/js/main.js"></script>
  <script src="/vendor/chart.umd.js"></script>
  <script src="/js/chart-setup.js"></script>
  <script src="/js/analytics.js"></script>
<%- include('partials/layout-end', { shell: shell }) %>
</html>
