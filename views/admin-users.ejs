<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Users · Admin', styles: ['tables', 'forms', 'modals', 'admin-pages'] }) %>
</head>
<%- include('partials/layout-start', { shell: 'admin', currentPage: 'admin-users' }) %>
<%
  const SORTS = [['newest', 'Newest first'], ['oldest', 'Oldest first'], ['username', 'Username A–Z'], ['most-urls', 'Most links'],
    ['most-clicks', 'Most clicks'], ['recently-active', 'Recently active']];
  const ACTIVITY = [['', 'Any activity'], ['today', 'Active today'], ['7days', 'Active (7 days)'], ['30days', 'Active (30 days)'],
    ['90days', 'Active (90 days)'], ['inactive30', 'Inactive 30+ days'], ['inactive90', 'Inactive 90+ days'], ['never', 'Never active']];
  const hasFilters = filters.search || filters.role || filters.status || filters.userRole || filters.activity || filters.sort !== 'newest';
  const defaultRoleLabel = (roles.find(r => r.name === defaultRole) || {}).label || defaultRole;
-%>

  <main class="main-content-wide">
    <div class="header-section">
      <div>
        <h2>Users</h2>
        <p><%= users.length %> account<%= users.length === 1 ? '' : 's' %><%= hasFilters ? ' match' : '' %></p>
      </div>
      <button type="button" class="btn" data-open-modal="createUserModal"><%- include('partials/icon', { icon: 'plus' }) %> Create user</button>
    </div>

    <form class="filter-bar card" id="filterForm" method="GET" action="/admin/users">
      <label class="filter-field grow">Search
        <input type="search" class="form-input" name="search" value="<%= filters.search %>" placeholder="Username or email">
      </label>
      <label class="filter-field">Admin
        <select data-select class="form-input" name="role" data-auto-submit>
          <option value=""<%= filters.role === '' ? ' selected' : '' %>>Everyone</option>
          <option value="admin"<%= filters.role === 'admin' ? ' selected' : '' %>>Admins</option>
          <option value="user"<%= filters.role === 'user' ? ' selected' : '' %>>Not admins</option>
        </select>
      </label>
      <label class="filter-field">Account role
        <select data-select class="form-input" name="userRole" data-auto-submit>
          <option value=""<%= filters.userRole === '' ? ' selected' : '' %>>Any role</option>
          <% roles.forEach(r => { %>
            <option value="<%= r.name %>"<%= filters.userRole === r.name ? ' selected' : '' %>><%= r.label %></option>
          <% }) %>
        </select>
      </label>
      <label class="filter-field">Status
        <select data-select class="form-input" name="status" data-auto-submit>
          <option value=""<%= filters.status === '' ? ' selected' : '' %>>Any status</option>
          <option value="active"<%= filters.status === 'active' ? ' selected' : '' %>>Active</option>
          <option value="banned"<%= filters.status === 'banned' ? ' selected' : '' %>>Banned</option>
        </select>
      </label>
      <label class="filter-field">Activity
        <select data-select class="form-input" name="activity" data-auto-submit>
          <% ACTIVITY.forEach(([value, label]) => { %>
            <option value="<%= value %>"<%= filters.activity === value ? ' selected' : '' %>><%= label %></option>
          <% }) %>
        </select>
      </label>
      <label class="filter-field">Sort
        <select data-select class="form-input" name="sort" data-auto-submit>
          <% SORTS.forEach(([value, label]) => { %>
            <option value="<%= value %>"<%= filters.sort === value ? ' selected' : '' %>><%= label %></option>
          <% }) %>
        </select>
      </label>
      <div class="filter-actions">
        <button type="submit" class="btn btn-small">Apply</button>
        <% if (hasFilters) { %><a href="/admin/users" class="btn btn-small btn-ghost">Reset</a><% } %>
      </div>
    </form>

    <% if (!users.length) { %>
      <div class="empty-state"><p>No accounts match these filters.</p></div>
    <% } else { %>
    <div class="table-container scroll">
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>User</th>
              <th>Email</th>
              <th>Account role</th>
              <th class="text-right">Links</th>
              <th class="text-right">Clicks</th>
              <th>Last active</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(user => { %>
              <%
                // Calculate time since last active with more precision
                let lastActiveText = 'Never';
                let isRecent = false;
                if (user.lastActive) {
                  // SQLite stores timestamps without timezone - append Z to treat as UTC
                  const lastActiveDate = new Date(user.lastActive.replace(' ', 'T') + 'Z');
                  const now = new Date();
                  const diffMs = now - lastActiveDate;
                  const diffSeconds = Math.floor(diffMs / 1000);
                  const diffMins = Math.floor(diffMs / 60000);
                  const diffHours = Math.floor(diffMs / 3600000);
                  const diffDays = Math.floor(diffMs / 86400000);
                  
                  if (diffSeconds < 10) {
                    lastActiveText = 'Just now';
                    isRecent = true;
                  } else if (diffSeconds < 60) {
                    lastActiveText = diffSeconds + ' sec ago';
                    isRecent = true;
                  } else if (diffMins < 60) {
                    const secs = diffSeconds % 60;
                    if (diffMins === 1 && secs > 0) {
                      lastActiveText = `1 min ${secs} sec ago`;
                    } else if (diffMins < 5) {
                      lastActiveText = `${diffMins} min ${secs} sec ago`;
                    } else {
                      lastActiveText = diffMins + ' min ago';
                    }
                    isRecent = true;
                  } else if (diffHours < 24) {
                    const mins = diffMins % 60;
                    if (diffHours === 1 && mins > 0) {
                      lastActiveText = `1h ${mins}m ago`;
                    } else if (diffHours < 6) {
                      lastActiveText = `${diffHours}h ${mins}m ago`;
                    } else {
                      lastActiveText = diffHours + 'h ago';
                    }
                    isRecent = true;
                  } else if (diffDays < 7) {
                    const hours = diffHours % 24;
                    if (diffDays === 1 && hours > 0) {
                      lastActiveText = `1d ${hours}h ago`;
                    } else {
                      lastActiveText = diffDays + 'd ago';
                    }
                  } else if (diffDays < 30) {
                    lastActiveText = Math.floor(diffDays / 7) + 'w ago';
                  } else {
                    lastActiveText = lastActiveDate.toLocaleDateString('en-GB');
                  }
                }
              %>
              <tr data-user-id="<%= user.id %>" data-username="<%= user.username %>">
                <td>
                  <div class="user-info">
                    <div class="user-avatar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div>
                    <div class="user-details">
                      <div class="user-name">
                        <%= user.username %>
                        <% if (user.id === currentUserId) { %><span class="badge badge-muted">You</span><% } %>
                        <% if (user.isAdmin) { %><span class="badge badge-active">Admin</span><% } %>
                        <% if (user.isBanned) { %><span class="badge badge-expired">Banned</span><% } %>
                      </div>
                      <span class="cell-sub">Joined <%= new Date(user.createdAt).toLocaleDateString('en-GB') %></span>
                    </div>
                  </div>
                </td>
                <td class="clip"<% if (user.email) { %> title="<%= user.email %>"<% } %>>
                  <% if (user.email) { %>
                    <a href="mailto:<%= user.email %>" class="user-email"><%= user.email %></a>
                  <% } else { %>
                    <span class="muted">—</span>
                  <% } %>
                </td>
                <td class="nowrap">
                  <%= user.roleLabel %><% if (user.roleIsDefault) { %> <span class="muted">(default)</span><% } %>
                </td>
                <td class="text-right"><%= user.urlCount || 0 %></td>
                <td class="text-right"><%= user.totalClicks || 0 %></td>
                <td class="nowrap"><span class="last-active<%= isRecent ? ' recent' : '' %>"><%= lastActiveText %></span></td>
                <td>
                  <div class="row-actions">
                    <button type="button" class="icon-btn-simple" data-action="edit" title="Edit user" aria-label="Edit <%= user.username %>"><%- include('partials/icon', { icon: 'edit' }) %></button>
                    <% if (user.id !== currentUserId) { %>
                      <button type="button" class="icon-btn-simple warning" data-action="<%= user.isBanned ? 'unban' : 'ban' %>"
                        title="<%= user.isBanned ? 'Unban' : 'Ban' %> user" aria-label="<%= user.isBanned ? 'Unban' : 'Ban' %> <%= user.username %>"><%- include('partials/icon', { icon: user.isBanned ? 'check' : 'lock' }) %></button>
                      <button type="button" class="icon-btn-simple danger" data-action="delete" title="Delete user" aria-label="Delete <%= user.username %>"><%- include('partials/icon', { icon: 'trash' }) %></button>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>
  </main>

  <div id="editUserModal" class="modal-overlay">
    <div class="modal">
      <div class="modal-header">
        <h3>Edit user</h3>
        <button type="button" class="modal-close" data-close-modal="editUserModal" aria-label="Close"><%- include('partials/icon', { icon: 'close' }) %></button>
      </div>
      <form class="modal-body" id="editUserForm" novalidate>
        <p class="form-hint">Joined <span id="userCreatedAt">-</span> · <span id="userUrlCount">0</span> links</p>
        <div class="form-group">
          <label for="editUsername" class="form-label">Username</label>
          <input type="text" id="editUsername" class="form-input" required>
        </div>
        <div class="form-group">
          <label for="editUserEmail" class="form-label">Email <span class="muted">optional</span></label>
          <input type="email" id="editUserEmail" class="form-input" placeholder="user@example.com">
        </div>
        <div class="form-group">
          <label for="editUserPassword" class="form-label">New password <span class="muted">leave empty to keep it</span></label>
          <input type="password" id="editUserPassword" class="form-input" minlength="<%= minPasswordLength %>" autocomplete="new-password" data-toggle-password>
        </div>
        <div class="form-group">
          <label for="editUserRole" class="form-label">Account role</label>
          <select data-select id="editUserRole" class="form-input">
            <option value="">Default (<%= defaultRoleLabel %>)</option>
            <% roles.forEach(r => { %>
              <option value="<%= r.name %>"><%= r.label %></option>
            <% }) %>
          </select>
          <p class="form-hint">Sets the account's permissions and limits (Admin → Settings → Roles &amp; limits).</p>
        </div>
        <div class="form-group">
          <label class="check-line"><input type="checkbox" id="editUserIsAdmin"> Admin: every permission, no limits</label>
          <label class="check-line"><input type="checkbox" id="editUserIsBanned"> Banned: can't log in</label>
        </div>
      </form>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-close-modal="editUserModal">Cancel</button>
        <button type="submit" class="btn" id="saveUserBtn" form="editUserForm">Save</button>
      </div>
    </div>
  </div>

  <!-- Works whether or not registration is open -->
  <div id="createUserModal" class="modal-overlay">
    <div class="modal">
      <div class="modal-header">
        <h3>Create user</h3>
        <button type="button" class="modal-close" data-close-modal="createUserModal" aria-label="Close"><%- include('partials/icon', { icon: 'close' }) %></button>
      </div>
      <form class="modal-body" id="createUserForm">
        <div class="form-group">
          <label for="newUsername" class="form-label">Username</label>
          <input type="text" id="newUsername" class="form-input" required>
        </div>
        <div class="form-group">
          <label for="newUserEmail" class="form-label">Email <span class="muted">optional</span></label>
          <input type="email" id="newUserEmail" class="form-input">
        </div>
        <div class="form-group">
          <label for="newUserPassword" class="form-label">Password</label>
          <input type="password" id="newUserPassword" class="form-input" minlength="<%= minPasswordLength %>" required autocomplete="new-password" data-toggle-password>
          <p class="form-hint">At least <%= minPasswordLength %> characters. Share it with the user so they can change it in Settings.</p>
        </div>
        <div class="form-group">
          <label for="newUserRole" class="form-label">Account role</label>
          <select data-select id="newUserRole" class="form-input">
            <option value="">Default (<%= defaultRoleLabel %>)</option>
            <% roles.forEach(r => { %>
              <option value="<%= r.name %>"><%= r.label %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label class="check-line"><input type="checkbox" id="newUserIsAdmin"> Admin</label>
        </div>
      </form>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-close-modal="createUserModal">Cancel</button>
        <button type="submit" class="btn" id="createUserBtn" form="createUserForm">Create user</button>
      </div>
    </div>
  </div>

  <%- include('partials/confirm-modal') %>

  <script src="/js/main.js"></script>
  <script src="/js/admin.js"></script>
<%- include('partials/layout-end', { shell: 'admin' }) %>
</html>
