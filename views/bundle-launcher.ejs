<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: bundle.title, styles: ['modals', 'forms', 'public-pages'] }) %>
</head>
<%- include('partials/layout-start', { shell: 'public' }) %>
<% const shortUrl = `${baseUrl}/b/${bundle.slug}`; -%>
  <main class="public-page">
    <article class="item-card">
      <div class="file-head">
        <span class="file-badge"><%- include('partials/icon', { icon: 'bundle' }) %></span>
        <div class="file-head-text">
          <h1 class="item-title file-name"><%= bundle.title %></h1>
          <div class="paste-short">
            <span><%= shortUrl.replace(/^https?:\/\//, '') %></span>
            <button type="button" class="text-btn" data-copy="<%= shortUrl %>" aria-label="Copy the short link"><%- include('partials/icon', { icon: 'copy' }) %> Copy link</button>
          </div>
        </div>
      </div>

      <div class="item-facts">
        <% if (creatorUsername) { %><span><%- include('partials/icon', { icon: 'bio' }) %> <%= creatorUsername %></span><% } %>
        <span><%= items.length %> link<%= items.length === 1 ? '' : 's' %></span>
      </div>
      <% if (bundle.description) { %><p class="bundle-description"><%= bundle.description %></p><% } %>

      <ol class="bundle-links">
        <% items.forEach((item, index) => { %>
          <li>
            <a href="/bt/<%= item.id %>" target="_blank" rel="noopener noreferrer" class="bundle-link">
              <span class="bundle-link-number"><%= index + 1 %></span>
              <span class="bundle-link-text">
                <span class="bundle-link-label"><%= item.label || item.url %></span>
                <% if (item.label) { %><span class="bundle-link-url"><%= item.url %></span><% } %>
              </span>
              <%- include('partials/icon', { icon: 'external' }) %>
            </a>
          </li>
        <% }) %>
      </ol>

      <% if (canSeeAnalytics || features.reports) { %>
      <div class="item-footer">
        <% if (canSeeAnalytics) { %>
          <a href="/analytics/bundle/<%= bundle.id %>" class="text-btn"><%- include('partials/icon', { icon: 'chart' }) %> Analytics</a>
        <% } else { %><span></span><% } %>
        <% if (features.reports) { %>
          <button type="button" class="text-btn danger" data-report-button><%- include('partials/icon', { icon: 'flag' }) %> <span data-report-label>Report this bundle</span></button>
        <% } %>
      </div>
      <% } %>
    </article>
  </main>

  <% if (features.reports) { %>
    <%- include('partials/report-modal', { type: 'bundle', id: bundle.id, noun: 'bundle' }) %>
  <% } %>
  <script src="/js/main.js"></script>
  <script src="/js/public-item.js"></script>
<%- include('partials/layout-end', { shell: 'public' }) %>
</html>
