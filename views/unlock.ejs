<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Password required', styles: ['forms', 'public-pages'], noindex: true }) %>
</head>
<%- include('partials/layout-start', { shell: 'public' }) %>
  <main class="public-page">
  <div class="status-card locked">
    <span class="status-icon"><%- include('partials/icon', { icon: 'lock' }) %></span>
    <h1>Password required</h1>
    <p>This <%= noun %> is protected. Enter its password to continue.</p>
    <div class="status-detail"><%= label %></div>

    <form class="status-form" method="POST" action="/unlock/<%= type %>/<%= slug %>">
      <% if (error) { %><p class="field-error" role="alert"><%= error %></p><% } %>
      <div class="form-group">
        <label for="password" class="form-label">Password</label>
        <input type="password" id="password" name="password" class="form-input" required autofocus autocomplete="off" data-toggle-password>
      </div>
      <% if (canRemember) { %>
        <label class="checkbox-row"><input type="checkbox" id="remember" name="remember" value="1"> Remember it for this session</label>
      <% } %>
      <button type="submit" class="btn">Unlock</button>
    </form>

    <div class="status-actions">
      <a href="/" class="btn btn-secondary">Home</a>
      <% if (locals.infoUrl) { %><a href="<%= infoUrl %>" class="btn btn-secondary">About this <%= noun %></a><% } %>
    </div>
  </div>
  </main>
  <script src="/js/main.js"></script>
<%- include('partials/layout-end', { shell: 'public' }) %>
</html>
