<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Files · Admin', styles: ['tables', 'forms'] }) %>
</head>
<%- include('partials/layout-start', { shell: 'app', currentPage: 'admin-files' }) %>

  <main class="main-content-wide">
    <div class="header-section">
      <div>
        <h2>Files</h2>
        <p><span class="count"><%= pagination.total %></span> file<%= pagination.total !== 1 ? 's' : '' %> across all users</p>
      </div>
    </div>

    <!-- Search -->
    <form method="GET" action="/admin/files" style="display:flex;gap:0.5rem;margin-bottom:1.5rem;">
      <input type="text" name="search" value="<%= search %>" placeholder="Search by filename…" class="form-input" style="flex:1;max-width:320px;">
      <button type="submit" class="btn btn-primary">Search</button>
      <% if (search) { %><a href="/admin/files" class="btn" style="background:var(--secondary);color:var(--foreground);">Clear</a><% } %>
    </form>

    <% if (files.length === 0) { %>
      <div style="text-align:center;padding:3rem;color:var(--muted-foreground);">No files found.</div>
    <% } else { %>
    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>File</th>
            <th>Owner</th>
            <th>Size</th>
            <th>Downloads</th>
            <th>Uploaded</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% files.forEach(function(file) { %>
          <tr data-file-id="<%= file.id %>">
            <td>
              <div style="display:flex;align-items:center;gap:0.5rem;">
                <span style="font-size:0.65rem;font-weight:700;text-transform:uppercase;background:var(--primary);color:var(--primary-foreground);padding:0.2rem 0.4rem;border-radius:4px;flex-shrink:0;">
                  <%= file.originalName.split('.').pop().substring(0, 4) %>
                </span>
                <div>
                  <div style="font-weight:500;word-break:break-all;"><%= file.originalName %></div>
                  <div style="font-size:0.75rem;color:var(--muted-foreground);">/f/<%= file.slug %></div>
                </div>
              </div>
            </td>
            <td><%= file.ownerUsername || '—' %></td>
            <td><%= file.sizeFormatted %></td>
            <td>
              <%= file.downloads %>
              <% if (file.maxDownloads) { %>/<%= file.maxDownloads %><% } %>
            </td>
            <td style="font-size:0.85rem;color:var(--muted-foreground);">
              <%= new Date(file.createdAt).toLocaleDateString('en-GB') %>
            </td>
            <td>
              <%- include('partials/status-badge', { status: file.accessStatus }) %>
            </td>
            <td>
              <div style="display:flex;gap:0.375rem;justify-content:flex-end;">
                <a href="/f/<%= file.slug %>" target="_blank" class="icon-btn" title="Preview">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
                <button type="button" class="icon-btn" title="<%= file.isBlocked ? 'Unblock' : 'Block' %>" aria-label="<%= file.isBlocked ? 'Unblock' : 'Block' %>" onclick="toggleBlock(<%= file.id %>, <%= file.isBlocked ? 'true' : 'false' %>)">
                  <% if (file.isBlocked) { %>
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/></svg>
                  <% } else { %>
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg>
                  <% } %>
                </button>
                <button type="button" class="icon-btn icon-btn-danger" title="Delete" onclick="deleteFile(<%= file.id %>, '<%= file.originalName.replace(/'/g, "\\'") %>')">
                  <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a1 1 0 011-1h4a1 1 0 011 1v2"/></svg>
                </button>
              </div>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (pagination.totalPages > 1) { %>
    <div style="display:flex;align-items:center;justify-content:center;gap:0.5rem;margin-top:1.5rem;">
      <% if (pagination.page > 1) { %>
        <a href="/admin/files?page=<%= pagination.page - 1 %>&search=<%= encodeURIComponent(search) %>" class="btn" style="background:var(--secondary);color:var(--foreground);">Previous</a>
      <% } %>
      <span style="color:var(--muted-foreground);font-size:0.875rem;">Page <%= pagination.page %> of <%= pagination.totalPages %></span>
      <% if (pagination.page < pagination.totalPages) { %>
        <a href="/admin/files?page=<%= pagination.page + 1 %>&search=<%= encodeURIComponent(search) %>" class="btn" style="background:var(--secondary);color:var(--foreground);">Next</a>
      <% } %>
    </div>
    <% } %>
    <% } %>
  </main>

  <script>
    async function toggleBlock(id, isBlocked) {
      const action = isBlocked ? 'unblock' : 'block';
      if (!isBlocked && !confirm('Block this file? Nobody will be able to download it until it is unblocked.')) return;
      try {
        const res = await fetch(`/api/admin/file/${id}/${action}`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          location.reload();
        } else {
          alert(data.error || 'Action failed');
        }
      } catch (e) {
        alert('Request failed');
      }
    }

    async function deleteFile(id, name) {
      if (!confirm(`Delete "${name}"? This cannot be undone.`)) return;
      try {
        const res = await fetch(`/api/admin/file/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
          document.querySelector(`tr[data-file-id="${id}"]`).remove();
        } else {
          alert('Delete failed: ' + (data.error || 'Unknown error'));
        }
      } catch (e) {
        alert('Request failed');
      }
    }
  </script>
<%- include('partials/layout-end', { shell: 'app' }) %>
</html>
