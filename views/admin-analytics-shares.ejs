<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Analytics shares · Admin', styles: ['tables', 'modals', 'admin-pages'] }) %>
</head>
<%- include('partials/layout-start', { shell: 'admin', currentPage: 'admin-analytics-shares' }) %>

  <%
    const fmt = (v) => v ? new Date(v).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) : '';
  %>

  <main class="main-content-wide">
    <div class="header-section">
      <div>
        <h2>Analytics shares</h2>
        <p><%= total %> active share link<%= total !== 1 ? 's' : '' %>. Anyone holding one can read that item's analytics.</p>
      </div>
    </div>

    <% if (links.length === 0) { %>
      <div class="empty-state"><p>No active share links.</p></div>
    <% } else { %>
    <div class="table-container scroll">
      <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Item</th>
            <th>Label</th>
            <th>Created by</th>
            <th>Created</th>
            <th>Expires</th>
            <th class="text-right">Views</th>
            <th>Last viewed</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% links.forEach(link => { %>
            <tr data-link-id="<%= link.id %>" data-path="<%= link.path %>">
              <td><a href="/analytics/<%= link.targetType %>/<%= link.targetId %>"><%= link.path %></a></td>
              <td><%= link.label || '—' %></td>
              <td><%= link.createdByUsername || '(deleted user)' %></td>
              <td class="nowrap"><%= fmt(link.createdAt) %></td>
              <td class="nowrap"><%= link.expiresAt ? fmt(link.expiresAt) : 'Never' %></td>
              <td class="text-right"><%= link.viewCount %></td>
              <td class="nowrap"><%= link.lastViewedAt ? fmt(link.lastViewedAt) : 'Never' %></td>
              <td class="text-right">
                <button type="button" class="btn btn-small btn-secondary" data-revoke>Revoke</button>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
    </div>

    <% if (totalPages > 1) { %>
      <div class="table-footer">
        <nav class="pager" aria-label="Pages">
          <% if (page > 1) { %><a class="btn btn-small btn-secondary" href="?page=<%= page - 1 %>">Previous</a><% } %>
          <span>Page <%= page %> of <%= totalPages %></span>
          <% if (page < totalPages) { %><a class="btn btn-small btn-secondary" href="?page=<%= page + 1 %>">Next</a><% } %>
        </nav>
      </div>
    <% } %>
    <% } %>
  </main>

  <%- include('partials/confirm-modal') %>

  <script src="/js/main.js"></script>
  <script src="/js/admin-analytics-shares.js"></script>
<%- include('partials/layout-end', { shell: 'admin' }) %>
</html>
