<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: user ? 'Create' : null, styles: ['forms', 'tagSelector', 'lineNumbers', 'create'] }) %>
</head>
<%
  const shell = user ? 'app' : 'public';
  const createTeams = locals.writableTeams || [];
  const lockedTitle = user ? 'Not available for your account' : 'Log in to use this';
  const today = new Date().toISOString().split('T')[0];
  const hourly = locals.limits || {};
  // "Up to N links per hour" for each mode, or nothing when the role has no limit
  const rate = (limit, noun) => (limit === null || limit === undefined) ? '' : `Up to ${limit.toLocaleString('en-US')} ${noun} per hour`;
  const rates = {
    url: rate(hourly.urlsPerHour, 'links'),
    paste: rate(hourly.pastesPerHour, 'pastes'),
    bundle: rate(hourly.bundlesPerHour, 'bundles'),
    file: rate(hourly.uploadsPerHour, 'uploads')
  };
  // An option chip: data-chip names its panel; data-format says how a value reads on the chip
  const chip = ({ id, chip, icon, label, format, allowed = true }) => `
    <button type="button" class="creator-chip${allowed ? '' : ' chip-locked'}" id="${id}" data-chip="${chip}" data-default="${label}"${format ? ` data-format="${format}"` : ''}${allowed ? ' aria-expanded="false"' : ` disabled title="${lockedTitle}"`}>
      ${include('partials/icon', { icon })}<span class="chip-label">${label}</span>
    </button>`;
-%>
<%- include('partials/layout-start', { shell, currentPage: 'home' }) %>

  <main class="main-content create-page">

    <% if (user) { %>
    <div class="header-section create-header">
      <div>
        <h2>Create</h2>
        <p>A short link, a paste, a bundle of links<%= features.files ? ' or a file' : '' %>.</p>
      </div>
    </div>
    <% } else { %>
    <div class="hero">
      <h2>Shorten Your Links,<br><span class="highlight">Track Your Impact</span></h2>
      <% if (locals.branding && branding.tagline) { %><p><%= branding.tagline %></p><% } %>
    </div>
    <% } %>

    <div class="creator-error" id="creatorError" role="alert"<%= error ? '' : ' hidden' %>><%= error || '' %></div>

    <div class="creator-success" id="creatorSuccess"<%= success ? '' : ' hidden' %>>
      <div class="creator-success-label" id="creatorSuccessLabel">Your short link is ready</div>
      <div class="creator-success-row">
        <code class="creator-success-url" id="creatorSuccessUrl"><%= success ? success.shortUrl : '' %></code>
        <button type="button" class="btn btn-small" id="creatorCopy"><%- include('partials/icon', { icon: 'copy' }) %> Copy</button>
      </div>
    </div>

    <form action="/create" method="POST" class="creator-card" id="creatorForm">

      <!-- What to create -->
      <div class="creator-mode-toggle" role="group" aria-label="What to create">
        <button type="button" class="mode-pill active" id="pillUrl" data-mode="url" aria-pressed="true"><%- include('partials/icon', { icon: 'link' }) %> Link</button>
        <% if (can.createPastes) { %>
        <button type="button" class="mode-pill" id="pillPaste" data-mode="paste" aria-pressed="false"><%- include('partials/icon', { icon: 'paste' }) %> Text</button>
        <% } %>
        <% if (user && can.createBundles) { %>
        <button type="button" class="mode-pill" id="pillBundle" data-mode="bundle" aria-pressed="false"><%- include('partials/icon', { icon: 'bundle' }) %> Bundle</button>
        <% } %>
        <% if (user && features.files) { %>
        <button type="button" class="mode-pill<%= canUploadFiles ? '' : ' chip-locked' %>" id="pillFile" data-mode="file" aria-pressed="false"<%- canUploadFiles ? '' : ' disabled title="Your account can\'t upload files"' %>><%- include('partials/icon', { icon: 'file' }) %> File</button>
        <% } %>
      </div>

      <% if (user && createTeams.length) { %>
      <!-- Create in a team (sent with every kind of item) -->
      <div class="create-in-team">
        <label for="createInTeam">Create in</label>
        <select name="teamId" id="createInTeam" class="form-input">
          <option value="">Personal</option>
          <% createTeams.forEach(team => { %>
            <option value="<%= team.id %>"<%= locals.selectedTeamId === team.id ? ' selected' : '' %>><%= team.name %></option>
          <% }) %>
        </select>
      </div>
      <% } %>

      <!-- ── Link ─────────────────────────────────────────── -->
      <div class="creator-section" data-section="url">
        <div class="creator-zone">
          <label for="longUrl" class="creator-label">Destination</label>
          <input type="url" id="longUrl" name="longUrl" class="creator-input creator-input-lg" placeholder="https://example.com/your/long/url"
            value="<%= prefillUrl %>" autocomplete="off" required>
        </div>
        <div class="creator-zone">
          <label for="customSlug" class="creator-label">Short link <span class="creator-label-note">optional</span></label>
          <div class="creator-slug" id="slugWrapper">
            <span class="creator-slug-prefix"><span class="slug-host" id="slugDomain"></span>/s/</span>
            <input type="text" id="customSlug" name="customSlug" class="creator-slug-input" placeholder="auto-generated" maxlength="20" autocomplete="off" aria-describedby="slugError">
          </div>
          <p class="field-error" id="slugError" hidden>Letters, numbers, - and _ only (20 at most)</p>
        </div>

        <div class="creator-chips-bar">
          <%- chip({ id: 'chip-expiry', chip: 'expiry', icon: 'clock', label: user ? 'No expiry' : '30 days', format: 'days' }) %>
          <%- chip({ id: 'chip-maxuses', chip: 'maxuses', icon: 'hash', label: 'No click limit', format: 'max' }) %>
          <%- chip({ id: 'chip-password', chip: 'password', icon: 'lock', label: 'Password', format: 'password', allowed: can.passwordProtection }) %>
          <%- chip({ id: 'chip-schedule', chip: 'schedule', icon: 'calendar', label: 'Schedule', format: 'schedule', allowed: can.scheduling }) %>
          <%- chip({ id: 'chip-tags', chip: 'tags', icon: 'tag', label: 'Tags', format: 'tags', allowed: can.tags }) %>
        </div>

        <div class="creator-panel" data-panel="expiry" hidden>
          <% if (!user) { %>
          <div class="panel-radios">
            <% [7, 14, 30].forEach(days => { %>
            <label class="panel-radio">
              <input type="radio" name="expirationDays" value="<%= days %>"<%= days === 30 ? ' checked' : '' %>>
              <span><%= days %> days<%- days === 30 ? ' <small>recommended</small>' : '' %></span>
            </label>
            <% }) %>
          </div>
          <p class="field-help">Links made without an account expire. <a href="/register">Create an account</a> for permanent links.</p>
          <% } else { %>
          <div class="panel-input-row">
            <input type="number" id="expirationDaysInput" name="expirationDays" class="form-input panel-number" placeholder="e.g. 30" min="1">
            <span class="panel-suffix">days</span>
            <button type="button" class="btn btn-small btn-ghost" data-clear>Clear</button>
          </div>
          <p class="field-help">Leave empty for a link that never expires.</p>
          <% } %>
        </div>

        <div class="creator-panel" data-panel="maxuses" hidden>
          <div class="panel-input-row">
            <input type="number" id="maxUsesInput" name="maxUses" class="form-input panel-number" placeholder="e.g. 100" min="1">
            <span class="panel-suffix">clicks</span>
            <button type="button" class="btn btn-small btn-ghost" data-clear>Clear</button>
          </div>
          <p class="field-help">The link stops working after this many clicks.</p>
        </div>

        <% if (can.passwordProtection) { %>
        <div class="creator-panel" data-panel="password" hidden>
          <input type="password" id="passwordInput" name="password" class="form-input" placeholder="Enter a password…" autocomplete="new-password" data-toggle-password>
          <p class="field-help">Visitors enter it before they are sent on.</p>
        </div>
        <% } %>

        <% if (can.scheduling) { %>
        <div class="creator-panel" data-panel="schedule" hidden>
          <input type="hidden" name="activateDateTime" id="activateDateTimeUtc">
          <input type="hidden" name="deactivateDateTime" id="deactivateDateTimeUtc">
          <div class="panel-schedule-grid">
            <label>Active from <input type="datetime-local" id="activateDateTimeInput" class="form-input" data-utc="activateDateTimeUtc"></label>
            <label>Active until <input type="datetime-local" id="deactivateDateTimeInput" class="form-input" data-utc="deactivateDateTimeUtc"></label>
          </div>
          <p class="field-help">Both optional. Times are in your timezone.</p>
        </div>
        <% } %>

        <% if (can.tags) { %>
        <div class="creator-panel" data-panel="tags" hidden>
          <div id="tagSelectorCreate" data-tag-selector="tags"></div>
          <input type="hidden" id="tags" name="tags" value="">
          <p class="field-help">Type to find a tag or make a new one; Enter or comma adds it.</p>
        </div>
        <% } %>

        <% if (!user) { %>
        <p class="creator-upsell"><%- include('partials/icon', { icon: 'info' }) %> Password, scheduling and tags need an account. <a href="/register">Register</a> or <a href="/login">log in</a>.</p>
        <% } %>
      </div>

      <% if (can.createPastes) { %>
      <!-- ── Text (paste) ─────────────────────────────────── -->
      <div class="creator-section" data-section="paste" hidden>
        <div class="creator-zone">
          <label for="pasteContent" class="visually-hidden">Text</label>
          <textarea id="pasteContent" class="creator-input paste-textarea" rows="12" placeholder="Paste your text here…" spellcheck="false" data-line-numbers></textarea>
          <div class="creator-two">
            <input type="text" id="pasteTitle" class="creator-input" placeholder="Title (optional)" maxlength="200" aria-label="Title">
            <input type="text" id="pasteLanguage" class="creator-input" placeholder="Language label, e.g. javascript (optional)" maxlength="30" autocomplete="off" aria-label="Language label">
          </div>
        </div>

        <div class="creator-chips-bar">
          <%- chip({ id: 'pchip-expires', chip: 'expires', icon: 'clock', label: user ? 'No expiry' : 'Expiry', format: 'date' }) %>
          <%- chip({ id: 'pchip-maxviews', chip: 'maxviews', icon: 'eye', label: 'No view limit', format: 'max' }) %>
          <%- chip({ id: 'pchip-password', chip: 'password', icon: 'lock', label: 'Password', format: 'password', allowed: can.passwordProtection }) %>
          <%- chip({ id: 'pchip-schedule', chip: 'schedule', icon: 'calendar', label: 'Schedule', format: 'schedule', allowed: can.scheduling }) %>
          <%- chip({ id: 'pchip-tags', chip: 'tags', icon: 'tag', label: 'Tags', format: 'tags', allowed: can.tags }) %>
        </div>

        <div class="creator-panel" data-panel="expires" hidden>
          <div class="panel-input-row">
            <input type="date" id="pasteExpiresAt" class="form-input" min="<%= today %>" aria-label="Expires on">
            <button type="button" class="btn btn-small btn-ghost" data-clear>Clear</button>
          </div>
          <p class="field-help"><%= user ? 'Leave empty for a paste that never expires.' : 'Pastes made without an account expire within 30 days.' %></p>
        </div>
        <div class="creator-panel" data-panel="maxviews" hidden>
          <div class="panel-input-row">
            <input type="number" id="pasteMaxViews" class="form-input panel-number" placeholder="e.g. 100" min="1" aria-label="View limit">
            <span class="panel-suffix">views</span>
            <button type="button" class="btn btn-small btn-ghost" data-clear>Clear</button>
          </div>
          <p class="field-help">The paste stops opening after this many views.</p>
        </div>
        <% if (can.passwordProtection) { %>
        <div class="creator-panel" data-panel="password" hidden>
          <input type="password" id="pastePassword" class="form-input" placeholder="Enter a password…" autocomplete="new-password" aria-label="Password" data-toggle-password>
          <p class="field-help">Visitors enter it before they can read the paste.</p>
        </div>
        <% } %>
        <% if (can.scheduling) { %>
        <div class="creator-panel" data-panel="schedule" hidden>
          <div class="panel-schedule-grid">
            <label>Available from <input type="datetime-local" id="pasteActivateAt" class="form-input"></label>
            <label>Available until <input type="datetime-local" id="pasteDeactivateAt" class="form-input"></label>
          </div>
          <p class="field-help">Both optional. Times are in your timezone.</p>
        </div>
        <% } %>
        <% if (can.tags) { %>
        <div class="creator-panel" data-panel="tags" hidden>
          <div id="pasteTagSelector" data-tag-selector="pasteTags"></div>
          <input type="hidden" id="pasteTags" value="">
        </div>
        <% } %>
      </div>
      <% } %>

      <% if (user && can.createBundles) { %>
      <!-- ── Bundle ───────────────────────────────────────── -->
      <div class="creator-section" data-section="bundle" hidden>
        <div class="creator-zone">
          <label for="bundleTitleInput" class="creator-label">Title</label>
          <input type="text" id="bundleTitleInput" class="creator-input" placeholder="e.g. Launch kit" maxlength="100">
        </div>
        <div class="creator-zone">
          <span class="creator-label">Links</span>
          <div id="bundleUrlList" class="bundle-rows"></div>
          <button type="button" class="btn btn-small btn-secondary" id="bundleAddBtn"><%- include('partials/icon', { icon: 'plus' }) %> Add link</button>
        </div>
        <% if (can.tags) { %>
        <div class="creator-zone">
          <span class="creator-label">Tags</span>
          <div id="bundleTagSelector" data-tag-selector="bundleTags"></div>
          <input type="hidden" id="bundleTags" value="">
        </div>
        <% } %>
      </div>
      <% } %>

      <% if (user && canUploadFiles) { %>
      <!-- ── File ─────────────────────────────────────────── -->
      <div class="creator-section" data-section="file" hidden>
        <div class="creator-zone">
          <div class="file-drop-zone" id="fileDropZone">
            <input type="file" id="fileInput" aria-label="File">
            <div class="file-drop-icon"><%- include('partials/icon', { icon: 'upload' }) %></div>
            <div class="file-drop-label"><strong>Click to browse</strong> or drop a file here</div>
          </div>
          <div id="fileSelectedInfo" class="file-selected-info" hidden>
            <%- include('partials/icon', { icon: 'file' }) %>
            <span class="file-selected-name" id="fileSelectedName"></span>
            <span class="file-selected-size" id="fileSelectedSize"></span>
          </div>
          <div class="upload-progress-wrap" id="fileProgressWrap">
            <div class="upload-progress-bar-track"><div class="upload-progress-bar-fill" id="fileProgressFill"></div></div>
            <div class="upload-progress-label" id="fileProgressLabel">Uploading…</div>
          </div>
        </div>

        <div class="creator-chips-bar">
          <%- chip({ id: 'fchip-expires', chip: 'expires', icon: 'clock', label: 'No expiry', format: 'date' }) %>
          <%- chip({ id: 'fchip-maxdl', chip: 'maxdl', icon: 'download', label: 'No download limit', format: 'max' }) %>
          <%- chip({ id: 'fchip-password', chip: 'password', icon: 'lock', label: 'Password', format: 'password', allowed: can.passwordProtection }) %>
          <%- chip({ id: 'fchip-schedule', chip: 'schedule', icon: 'calendar', label: 'Schedule', format: 'schedule', allowed: can.scheduling }) %>
          <%- chip({ id: 'fchip-tags', chip: 'tags', icon: 'tag', label: 'Tags', format: 'tags', allowed: can.tags }) %>
          <%- chip({ id: 'fchip-share', chip: 'share', icon: 'teams', label: 'Anyone with the link' }) %>
        </div>

        <div class="creator-panel" data-panel="expires" hidden>
          <div class="panel-input-row">
            <input type="date" id="fileExpiresAt" class="form-input" min="<%= today %>" aria-label="Expires on">
            <button type="button" class="btn btn-small btn-ghost" data-clear>Clear</button>
          </div>
          <p class="field-help">Leave empty for a file that never expires.</p>
        </div>
        <div class="creator-panel" data-panel="maxdl" hidden>
          <div class="panel-input-row">
            <input type="number" id="fileMaxDownloads" class="form-input panel-number" placeholder="e.g. 10" min="1" aria-label="Download limit">
            <span class="panel-suffix">downloads</span>
            <button type="button" class="btn btn-small btn-ghost" data-clear>Clear</button>
          </div>
          <p class="field-help">The file stops downloading after this many downloads.</p>
        </div>
        <% if (can.passwordProtection) { %>
        <div class="creator-panel" data-panel="password" hidden>
          <input type="password" id="filePassword" class="form-input" placeholder="Enter a password…" autocomplete="new-password" aria-label="Password" data-toggle-password>
          <p class="field-help">Visitors enter it before they can download.</p>
        </div>
        <% } %>
        <% if (can.scheduling) { %>
        <div class="creator-panel" data-panel="schedule" hidden>
          <div class="panel-schedule-grid">
            <label>Available from <input type="datetime-local" id="fileActivateAt" class="form-input"></label>
            <label>Available until <input type="datetime-local" id="fileDeactivateAt" class="form-input"></label>
          </div>
          <p class="field-help">Both optional. Times are in your timezone.</p>
        </div>
        <% } %>
        <% if (can.tags) { %>
        <div class="creator-panel" data-panel="tags" hidden>
          <div id="fileTagSelector" data-tag-selector="fileTags"></div>
          <input type="hidden" id="fileTags" value="">
        </div>
        <% } %>
        <div class="creator-panel" data-panel="share" hidden>
          <div class="user-chips-input-wrap" id="fileShareChips">
            <input type="text" id="fileShareTyper" class="user-chips-text-input" placeholder="Type a username and press Enter…" autocomplete="off" aria-label="Share with">
          </div>
          <p class="field-error" id="fileShareError" role="alert" hidden></p>
          <p class="field-help">Only the people listed can open it. Leave empty for anyone with the link.</p>
        </div>
      </div>
      <% } %>

      <!-- Submit -->
      <div class="creator-submit-zone">
        <button type="submit" class="btn creator-submit-btn" id="creatorSubmitBtn">
          <%- include('partials/icon', { icon: 'arrowRight' }) %>
          <span id="submitBtnText" data-url="Create short link" data-paste="Create paste" data-bundle="Create bundle" data-file="Upload file">Create short link</span>
        </button>
        <p class="creator-rate-info" id="creatorRate"<% for (const [mode, text] of Object.entries(rates)) { %> data-<%= mode %>="<%= text %>"<% } %>><%= rates.url %></p>
      </div>
    </form>

    <% if (!user) { %>
    <div class="features">
      <div class="feature-card">
        <div class="feature-icon"><%- include('partials/icon', { icon: 'arrowRight' }) %></div>
        <h3>Fast</h3>
        <p>Make short links, pastes and bundles in seconds.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon"><%- include('partials/icon', { icon: 'chart' }) %></div>
        <h3>Analytics</h3>
        <p>Clicks, devices, countries and referrers, without storing visitor IP addresses.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon"><%- include('partials/icon', { icon: 'lock' }) %></div>
        <h3>Control</h3>
        <p>Expiry dates, usage limits, passwords and custom slugs.</p>
      </div>
    </div>
    <% } %>
  </main>

  <script src="/js/main.js"></script>
  <script src="/js/tagSelector.js"></script>
  <script src="/js/lineNumbers.js"></script>
  <script src="/js/create.js"></script>
<%- include('partials/layout-end', { shell }) %>
</html>
