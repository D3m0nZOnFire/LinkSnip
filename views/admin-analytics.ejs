<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Analytics · Admin', styles: ['tables', 'admin-pages'] }) %>
</head>
<%- include('partials/layout-start', { shell: 'admin', currentPage: 'admin-analytics' }) %>

  <!-- Main Content -->
  <main class="main-content-wide">
    <!-- Header Section -->
    <div class="header-section">
      <div>
        <h2>Analytics</h2>
        <p>Clicks on short links across the whole instance</p>
      </div>
    </div>

    <div class="mini-stats">
      <div class="mini-stat"><div class="mini-stat-label">Clicks, all time</div><div class="mini-stat-value"><%= totalClicks.toLocaleString('en-US') %></div></div>
      <div class="mini-stat"><div class="mini-stat-label">Short links</div><div class="mini-stat-value"><%= totalUrls.toLocaleString('en-US') %></div></div>
      <div class="mini-stat"><div class="mini-stat-label">Clicks per link</div><div class="mini-stat-value"><%= totalUrls > 0 ? (totalClicks / totalUrls).toFixed(1) : 0 %></div></div>
    </div>

    <h3 class="section-title">Most clicked links, last 30 days</h3>

    <% if (topUrls.length === 0) { %>
      <div class="empty-state">
        <p>No clicks in the last 30 days.</p>
      </div>
    <% } else { %>
      <div class="table-container scroll">
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Short link</th>
                <th>Destination</th>
                <th class="text-right">Clicks (30 days)</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% topUrls.forEach(url => { %>
                <tr>
                  <td>
                    <a href="<%= baseUrl %>/s/<%= url.slug %>" target="_blank" rel="noopener" class="url-link">
                      /s/<%= url.slug %>
                    </a>
                  </td>
                  <td>
                    <a href="<%= url.longUrl %>" target="_blank" rel="noopener noreferrer" class="long-url" title="<%= url.longUrl %>">
                      <%= url.longUrl %>
                    </a>
                  </td>
                  <td class="text-right"><%= url.clicks %></td>
                  <td class="text-right">
                    <a href="/analytics/url/<%= url.urlId %>" class="btn btn-small btn-secondary"><%- include('partials/icon', { icon: 'chart' }) %> Analytics</a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </main>

  <script src="/js/main.js"></script>
<%- include('partials/layout-end', { shell: 'admin' }) %>
</html>
