<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Analytics · Admin', styles: ['tables'] }) %>
  <style>
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .stat-card {
      background: var(--chart-background);
      border: 1px solid var(--chart-border);
      border-radius: 8px;
      padding: 1.5rem;
    }

    .stat-card h3 {
      margin: 0 0 0.5rem 0;
      font-size: 0.875rem;
      color: var(--chart-muted-text);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .stat-card .stat-value {
      font-size: 2.5rem;
      font-weight: bold;
      color: var(--status-active-text);
      margin: 0;
    }

    .stat-card .stat-label {
      font-size: 0.875rem;
      color: var(--muted-foreground);
      margin-top: 0.5rem;
    }
  </style>
</head>
<%- include('partials/layout-start', { shell: 'admin', currentPage: 'admin-analytics' }) %>

  <!-- Main Content -->
  <main class="main-content-wide">
    <!-- Header Section -->
    <div class="header-section">
      <div>
        <h2>Analytics Overview</h2>
        <p>System-wide statistics and performance metrics</p>
      </div>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid">
      <div class="stat-card">
        <h3>Total Clicks</h3>
        <p class="stat-value"><%= totalClicks.toLocaleString() %></p>
        <p class="stat-label">All-time redirects</p>
      </div>
      <div class="stat-card">
        <h3>Total URLs</h3>
        <p class="stat-value"><%= totalUrls.toLocaleString() %></p>
        <p class="stat-label">Short links created</p>
      </div>
      <div class="stat-card">
        <h3>Average Clicks</h3>
        <p class="stat-value"><%= totalUrls > 0 ? (totalClicks / totalUrls).toFixed(1) : 0 %></p>
        <p class="stat-label">Per URL</p>
      </div>
      <div class="stat-card">
        <h3>Top URLs</h3>
        <p class="stat-value"><%= topUrls.length %></p>
        <p class="stat-label">Last 30 days</p>
      </div>
    </div>

    <!-- Top URLs Table -->
    <div class="header-section" style="margin-top: 2rem;">
      <div>
        <h3>Top Performing URLs (Last 30 Days)</h3>
      </div>
    </div>

    <% if (topUrls.length === 0) { %>
      <div class="empty-state">
        <p>No analytics data available yet</p>
      </div>
    <% } else { %>
      <div class="table-container">
        <div class="table-wrapper">
          <table>
            <thead>
              <tr>
                <th>Short URL</th>
                <th>Long URL</th>
                <th class="text-right">Clicks (30d)</th>
                <th class="text-center">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% topUrls.forEach(url => { %>
                <tr>
                  <td>
                    <a href="<%= baseUrl %>/s/<%= url.slug %>" target="_blank" class="url-link">
                      /s/<%= url.slug %>
                    </a>
                  </td>
                  <td>
                    <a href="<%= url.longUrl %>" target="_blank" class="long-url" title="<%= url.longUrl %>">
                      <%= url.longUrl %>
                    </a>
                  </td>
                  <td class="text-right"><%= url.clicks %></td>
                  <td class="text-center">
                    <a href="/analytics/url/<%= url.urlId %>" class="btn" style="padding: 0.5rem 1rem; font-size: 0.875rem; color: var(--primary-foreground);">
                      View Details
                    </a>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </main>

  <script src="/js/main.js"></script>
<%- include('partials/layout-end', { shell: 'admin' }) %>
</html>
