<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: `Paste preview · ${paste.slug}`, styles: ['modals', 'forms', 'public-pages', 'paste'] }) %>
</head>
<%- include('partials/layout-start', { shell: 'public', currentPage: 'info' }) %>
<%
  const shortUrl = `${baseUrl}/p/${paste.slug}`;
  const shortLabel = shortUrl.replace(/^https?:\/\//, '');
  const day = (value) => new Date(String(value).includes('T') ? value : `${String(value).replace(' ', 'T')}Z`)
    .toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
-%>
  <main class="public-page">
    <% if (validation.status === 'blocked') { %>
      <div class="notice danger" role="alert">
        <%- include('partials/icon', { icon: 'lock' }) %>
        <div><strong>This paste was blocked</strong><p>The administrators of <%= branding.name %> blocked it. It can't be opened.</p></div>
      </div>
    <% } %>

    <article class="item-card">
      <p class="item-kicker"><%- include('partials/icon', { icon: 'info' }) %> Paste preview: see what it is before you open it</p>
      <div class="short-link-row">
        <h1 class="short-link"><%= shortLabel %></h1>
        <button type="button" class="btn btn-small btn-secondary copy-btn" data-copy="<%= shortUrl %>" aria-label="Copy the short link"><%- include('partials/icon', { icon: 'copy' }) %> Copy</button>
      </div>
      <p class="item-title"><%= paste.title ? paste.title : 'Untitled paste' %></p>

      <div class="item-facts">
        <span><%- include('partials/icon', { icon: 'bio' }) %> <%= owner.username %></span>
        <span><%- include('partials/icon', { icon: 'clock' }) %> <%= ageInDays === 0 ? 'Created today' : `Created ${ageInDays} day${ageInDays === 1 ? '' : 's'} ago` %></span>
        <span><%- include('partials/icon', { icon: 'eye' }) %> <%= paste.views.toLocaleString('en-US') %><%= paste.maxViews ? ` / ${paste.maxViews.toLocaleString('en-US')}` : '' %> view<%= paste.views === 1 && !paste.maxViews ? '' : 's' %></span>
        <span><%= sizeChars.toLocaleString('en-US') %> characters</span>
        <% if (paste.language) { %><span><%= paste.language %></span><% } %>
        <% if (paste.expiresAt) { %><span>Expires <%= day(paste.expiresAt) %></span><% } %>
        <% if (paste.password) { %><span><%- include('partials/icon', { icon: 'lock' }) %> Password</span><% } %>
        <% if (validation.status === 'expired') { %><span>Expired</span><% } %>
        <% if (validation.status === 'limit_reached') { %><span>View limit reached</span><% } %>
      </div>
      <%- include('partials/tag-chips', { tags: paste.tags || [] }) %>

      <% if (showPreview) { %>
        <div class="paste-preview">
          <pre><% previewLines.forEach(function(line, idx) { %><%= line %><%= idx < previewLines.length - 1 ? '\n' : '' %><% }); %></pre>
          <% if (previewTruncated) { %><p class="paste-preview-more">Only the first lines; open the paste to read the rest.</p><% } %>
        </div>
      <% } else if (paste.password) { %>
        <div class="destination hidden-destination">The preview is hidden because the paste has a password.</div>
      <% } %>

      <div class="item-actions">
        <% if (validation.live) { %>
          <a href="/p/<%= paste.slug %>" class="btn btn-large">Open paste <%- include('partials/icon', { icon: 'arrowRight' }) %></a>
          <a href="/p/<%= paste.slug %>/raw" class="btn btn-secondary">Raw text</a>
        <% } else { %>
          <span class="btn btn-large btn-secondary" aria-disabled="true">
            <%= { blocked: 'Blocked', scheduled: 'Not available yet', expired: 'This paste has expired', limit_reached: 'This paste reached its view limit' }[validation.status] || 'Unavailable' %>
          </span>
        <% } %>
      </div>

      <% if (features.qrCodes || (validation.live && features.reports)) { %>
      <div class="item-footer">
        <% if (features.qrCodes) { %>
        <details class="qr-details">
          <summary><%- include('partials/icon', { icon: 'qr' }) %> QR code</summary>
          <% if (!locals.previewBot) { %><img src="/qrcode/paste/<%= paste.slug %>?theme=light" alt="QR code for <%= shortLabel %>" width="160" height="160" loading="lazy"><% } %>
          <p>It opens the paste.</p>
        </details>
        <% } %>
        <% if (validation.live && features.reports) { %>
          <button type="button" class="text-btn danger" data-report-button><%- include('partials/icon', { icon: 'flag' }) %> <span data-report-label>Report this paste</span></button>
        <% } %>
      </div>
      <% } %>
    </article>
  </main>

  <% if (validation.live && features.reports) { %>
    <%- include('partials/report-modal', { type: 'paste', id: paste.id, noun: 'paste' }) %>
  <% } %>
  <script src="/js/main.js"></script>
  <script src="/js/public-item.js"></script>
<%- include('partials/layout-end', { shell: 'public' }) %>
</html>
