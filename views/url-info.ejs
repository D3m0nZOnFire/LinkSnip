<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: `Link preview · ${url.slug}`, styles: ['modals', 'forms', 'public-pages'] }) %>
</head>
<%- include('partials/layout-start', { shell: 'public', currentPage: 'info' }) %>
<%
  const shortUrl = `${baseUrl}/s/${url.slug}`;
  const shortLabel = shortUrl.replace(/^https?:\/\//, '');
  const showDestination = validation.live || validation.status === 'expired' || validation.status === 'limit_reached';
  const host = destinationHost || 'the destination';
-%>
  <main class="public-page">
    <% if (validation.status === 'blocked') { %>
      <div class="notice danger" role="alert">
        <%- include('partials/icon', { icon: 'lock' }) %>
        <div><strong>This link was blocked</strong><p>The administrators of <%= branding.name %> blocked it. It can't be opened.</p></div>
      </div>
    <% } else if (url.isQuarantined) { %>
      <div class="notice" role="alert">
        <%- include('partials/icon', { icon: 'flag' }) %>
        <div><strong>Under review</strong><p>Several visitors reported this link and an administrator hasn't looked at it yet. Visitors see a warning first.</p></div>
      </div>
    <% } else if (reportCount > 0) { %>
      <div class="notice">
        <%- include('partials/icon', { icon: 'flag' }) %>
        <div><strong>Reported <%= reportCount === 1 ? 'once' : `${reportCount} times` %></strong><p>Be careful before you continue.</p></div>
      </div>
    <% } %>

    <article class="item-card">
      <p class="item-kicker"><%- include('partials/icon', { icon: 'info' }) %> Link preview: see where it goes before you open it</p>
      <div class="short-link-row">
        <h1 class="short-link"><%= shortLabel %></h1>
        <button type="button" class="btn btn-small btn-secondary copy-btn" data-copy="<%= shortUrl %>" aria-label="Copy the short link"><%- include('partials/icon', { icon: 'copy' }) %> Copy</button>
      </div>

      <% if (showDestination) { %>
        <div class="destination">
          <span class="destination-label">Goes to</span>
          <span class="destination-host"><%= destinationHost || url.longUrl %></span>
          <span class="destination-url"><%= url.longUrl %></span>
        </div>
      <% } else if (validation.status === 'scheduled') { %>
        <div class="destination hidden-destination">
          The destination is hidden until the link starts working<% if (url.activateAt) { %>, on <%= new Date(url.activateAt).toLocaleString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'UTC' }) %> UTC<% } %>.
        </div>
      <% } else { %>
        <div class="destination hidden-destination">The destination is hidden because the link was blocked.</div>
      <% } %>

      <div class="item-facts">
        <span><%- include('partials/icon', { icon: 'clock' }) %> <%= ageInDays === 0 ? 'Created today' : `Created ${ageInDays} day${ageInDays === 1 ? '' : 's'} ago` %></span>
        <% if (validation.status === 'expired') { %><span>Expired</span><% } %>
        <% if (validation.status === 'limit_reached') { %><span>Click limit reached</span><% } %>
      </div>

      <div class="item-actions">
        <% if (validation.live) { %>
          <a href="/s/<%= url.slug %>" class="btn btn-large" rel="noopener">Continue to <%= host %> <%- include('partials/icon', { icon: 'arrowRight' }) %></a>
        <% } else { %>
          <span class="btn btn-large btn-secondary" aria-disabled="true">
            <%= { blocked: 'Blocked', scheduled: 'Not active yet', expired: 'This link has expired', limit_reached: 'This link reached its click limit' }[validation.status] || 'Unavailable' %>
          </span>
        <% } %>
      </div>

      <% if (features.qrCodes || (validation.live && features.reports)) { %>
      <div class="item-footer">
        <% if (features.qrCodes) { %>
        <details class="qr-details">
          <summary><%- include('partials/icon', { icon: 'qr' }) %> QR code</summary>
          <img src="/qrcode/url/<%= url.slug %>?theme=light" alt="QR code for <%= shortLabel %>" width="160" height="160" loading="lazy">
          <p>It opens this preview page.</p>
        </details>
        <% } %>
        <% if (validation.live && features.reports) { %>
          <button type="button" class="text-btn danger" data-report-button><%- include('partials/icon', { icon: 'flag' }) %> <span data-report-label>Report this link</span></button>
        <% } %>
      </div>
      <% } %>
    </article>
  </main>

  <% if (validation.live && features.reports) { %>
    <%- include('partials/report-modal', { type: 'url', id: url.id, noun: 'link' }) %>
  <% } %>
  <script src="/js/main.js"></script>
  <script src="/js/public-item.js"></script>
<%- include('partials/layout-end', { shell: 'public' }) %>
</html>
